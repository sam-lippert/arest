<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ElyTools>$(MSBuildProjectDirectory)\..\..</ElyTools>
    <ComposedFile>$(MSBuildProjectDirectory)\Composed.g.cs</ComposedFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ElyTools)\cs-runner\Mu.cs" Link="Mu.cs" />
    <Compile Include="$(ElyTools)\cs-runner\Vocabulary.cs" Link="Vocabulary.cs" />
    <Compile Remove="Composed.g.cs" />
  </ItemGroup>
  <Target Name="ComposeCanon" BeforeTargets="CoreCompile">
    <Exec Command="cmd /c copy /b /y &quot;$(ElyTools)\cs-runner\head.part&quot; + &quot;$(ElyTools)\..\arest&quot; + &quot;$(ElyTools)\cs-runner\mid1.part&quot; + &quot;$(ElyTools)\..\apps\sherlock\design-state&quot; + &quot;$(ElyTools)\cs-runner\mid2.part&quot; + &quot;$(ElyTools)\..\apps\sherlock\norma-answer&quot; + &quot;$(ElyTools)\cs-runner\mid3.part&quot; + &quot;$(ElyTools)\..\apps\sherlock\journal&quot; + &quot;$(ElyTools)\cs-runner\mid4.part&quot; + &quot;$(ElyTools)\cs-runner\tail.part&quot; &quot;$(ComposedFile)&quot; &gt;nul" />
    <ItemGroup><Compile Include="$(ComposedFile)" /></ItemGroup>
  </Target>
</Project>
