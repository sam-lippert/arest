<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CarrierDir>$(MSBuildProjectDirectory)\..\..\apps\sherlock</CarrierDir>
    <ComposedFile>$(MSBuildProjectDirectory)\Composed.g.cs</ComposedFile>
    <IFactrWpf>$(MSBuildProjectDirectory)\..\..\..\iFactr-WPF</IFactrWpf>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\cs-runner\Mu.cs" Link="Mu.cs" />
    <Compile Include="..\cs-runner\Vocabulary.cs" Link="Vocabulary.cs" />
    <Compile Remove="Composed.g.cs" />
    <Reference Include="iFactr.Wpf"><HintPath>$(IFactrWpf)\Distribution\iFactr.Wpf.dll</HintPath></Reference>
    <Reference Include="iFactr.UI"><HintPath>$(IFactrWpf)\iFactr.UI\Distribution\iFactr.UI.dll</HintPath></Reference>
    <Reference Include="MonoCross"><HintPath>$(IFactrWpf)\iFactr.UI\MonoCross\Distribution\MonoCross.dll</HintPath></Reference>
    <Reference Include="MonoCross.Utilities.NET"><HintPath>$(IFactrWpf)\iFactr.UI\MonoCross\Distribution\MonoCross.Utilities.NET.dll</HintPath></Reference>
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <Target Name="ComposeCanon" BeforeTargets="CoreCompile">
    <Exec Command="cmd /c copy /b /y &quot;$(MSBuildProjectDirectory)\..\cs-runner\head.part&quot; + &quot;$(MSBuildProjectDirectory)\..\..\arest&quot; + &quot;$(MSBuildProjectDirectory)\..\cs-runner\mid1.part&quot; + &quot;$(CarrierDir)\design-state&quot; + &quot;$(MSBuildProjectDirectory)\..\cs-runner\mid2.part&quot; + &quot;$(CarrierDir)\norma-answer&quot; + &quot;$(MSBuildProjectDirectory)\..\cs-runner\mid3.part&quot; + &quot;$(CarrierDir)\journal&quot; + &quot;$(MSBuildProjectDirectory)\..\cs-runner\mid4.part&quot; + &quot;$(MSBuildProjectDirectory)\..\cs-runner\tail.part&quot; &quot;$(ComposedFile)&quot; &gt;nul" />
    <ItemGroup><Compile Include="$(ComposedFile)" /></ItemGroup>
  </Target>
</Project>
