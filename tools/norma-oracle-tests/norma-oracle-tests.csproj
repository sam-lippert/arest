<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 like cs-runner-tests: these tests drive the shipped
         norma-oracle.exe (net48, one verifier run per process) as a process
         from a scratch working directory, so nothing here references the
         NORMA assemblies and `dotnet test` needs the dotnet SDK and nothing
         else. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Arest.NormaOracle.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
