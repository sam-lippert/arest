<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# host. Lambda, the case table and the base are READ at runtime (Reader.cs), as the Java and
       JS hosts read them; nothing is composed into the build. The law run (laws/) compiles these same
       sources beside its own entry point. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Mu.cs;Reader.cs;Vocabulary.cs;Registrations.cs;Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>

</Project>
