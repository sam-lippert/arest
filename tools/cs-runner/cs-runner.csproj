<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet build -p:App=order composes against that app's carriers -->
    <CarrierDir Condition="'$(App)' == ''">$(MSBuildProjectDirectory)\..\norma-oracle</CarrierDir>
    <CarrierDir Condition="'$(App)' != ''">$(MSBuildProjectDirectory)\..\..\apps\$(App)</CarrierDir>
    <ComposedFile>$(MSBuildProjectDirectory)\Composed.g.cs</ComposedFile>
  </PropertyGroup>

  <!-- NO compose step. The canon, the case table and the carriers are READ
       at runtime by Reader.cs, the way js, java and rust-station read them.
       copy /b was the cheapest of the four compose steps, byte concatenation
       and nothing more, but it still put the whole canon through the C#
       compiler on every edit and left this station holding the program as
       object code. The base journal is empty and an empty carrier registered
       nothing, so there is no third file to read. -->

</Project>
