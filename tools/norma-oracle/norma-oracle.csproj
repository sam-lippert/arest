<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Arest.NormaOracle</RootNamespace>
    <AssemblyName>norma-oracle</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The oracle references the NORMA VSIX assemblies installed in VS 18
         (the reference ORM 2 implementation, per authoritative-sources).
         Override NormaExtensionDir if the VSIX moves. -->
    <NormaExtensionDir>C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\Extensions\4btgttbq.44q</NormaExtensionDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.Modeling.Sdk">
      <HintPath>$(NormaExtensionDir)\Microsoft.VisualStudio.Modeling.Sdk.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Modeling.Sdk.Diagrams">
      <HintPath>$(NormaExtensionDir)\Microsoft.VisualStudio.Modeling.Sdk.Diagrams.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ORMSolutions.ORMArchitect.Core.VS2022">
      <HintPath>$(NormaExtensionDir)\ORMSolutions.ORMArchitect.Core.VS2022.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ORMSolutions.ORMArchitect.ORMAbstraction.VS2022">
      <HintPath>$(NormaExtensionDir)\Extensions\ORMSolutions.ORMArchitect.ORMAbstraction.VS2022.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ORMSolutions.ORMArchitect.ORMToORMAbstractionBridge.VS2022">
      <HintPath>$(NormaExtensionDir)\Extensions\ORMSolutions.ORMArchitect.ORMToORMAbstractionBridge.VS2022.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ORMSolutions.ORMArchitect.ORMAbstractionToConceptualDatabaseBridge.VS2022">
      <HintPath>$(NormaExtensionDir)\Extensions\ORMSolutions.ORMArchitect.ORMAbstractionToConceptualDatabaseBridge.VS2022.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ORMSolutions.ORMArchitect.RelationalModels.VS2022">
      <HintPath>$(NormaExtensionDir)\Extensions\ORMSolutions.ORMArchitect.RelationalModels.VS2022.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
