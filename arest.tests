    S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(A("committed")))),
       S3(A("COMP"), A("and"), S3(A("CONS"),
          S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S4(A("COMP"), N(2), A("reverse"), N(2)), K(S2(S2(A("obs-rs-1"), A("Observation")), S2(A("f-rs-1"), A("Fact")))))),
