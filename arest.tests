    S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("nav:map"), S3(A("COMP"), A("rmap:schema"), K(S1(S3(S5(A("OrderWasPlacedByCustomer"), S2(A("Order"), A("Customer")), S1(S1(N(1))), PHI(), S1(S2(A("o1"), A("c1")))), S5(A("CustomerHasName"), S2(A("Customer"), A("Name")), S1(S1(N(1))), PHI(), S1(S2(A("c1"), A("Acme")))), S5(A("spouse"), S2(A("Person"), A("Person")), S1(S2(N(1), N(2))), PHI(), S1(S2(A("p1"), A("p2"))))))))), K(S6(S1(A("Order")), S2(A("Order"), S1(A("Order"))), S1(A("Customer")), S2(A("Customer"), S1(A("Customer"))), S1(A("spouse")), S2(A("spouse"), S1(A("Person")))))))),

DEF("test:finiteness",
    S3(A("COMP"), A("fp:and_all"), S6(A("CONS"), S3(A("COMP"), A("derive:stratified"), A("derive:all_rules")), S4(A("COMP"), A("not"), A("derive:stratified"), S2(A("CONST"), S2(S2(A("A"), S3(A("minus"), A("B"), A("C"))), S2(A("C"), S3(A("proj"), A("A"), S2(N(1), N(2))))))), S4(A("COMP"), A("not"), A("derive:stratified"), S2(A("CONST"), S2(S2(A("X"), S3(A("count"), A("Y"), N(1))), S2(A("Y"), S3(A("proj"), A("X"), S2(N(1), N(2))))))), S4(A("COMP"), A("not"), A("derive:stratified"), S2(A("CONST"), S2(S2(A("P"), S3(A("pairwith"), A("Q"), A("v"))), S2(A("Q"), S3(A("proj"), A("P"), S2(N(1), N(2))))))), S4(A("COMP"), A("not"), A("derive:stratified"), S2(A("CONST"), S2(S2(A("G"), S5(A("calc"), A("H"), A("+"), N(1), N(2))), S2(A("H"), S3(A("proj"), A("G"), S2(N(2), N(3)))))))))),

"A WITNESS FOR THE SUBSET VERDICTS. The subset checker had no surface a person could read store-wide: its rows reach the commit gate and a per-entity screen, and the only law over them answers T or F. The subset legs are about to change carrier -- from step triples lambda reassembles to recipes the oracle emits from the NORMA join path -- and that change must be read as VERDICT IDENTITY, the same violation rows before and after, not as `nothing broke`. So the checker gets its witness, in the shape test:witnesses already renders: a pair of lists whose cat is what prints, and a law that holds when both are empty. The value is every cmd:sub_viols row rendered by system:show, so a row reads as <fact type, kind, subject>; the law is that there are none. `witness` on the base store prints `witness empty: subset-verdicts`; on a store with standing subset violations it prints each one. The migration is measured against this line, and every later change to constraint evaluation is visible on it.",
DEF("test:subset_clean",
    S3(A("COMP"), A("null"), A("cmd:sub_viols"))),
DEF("test:subset_viols_witness",
    S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), A("system:show")), A("cmd:sub_viols")), K(PHI()))),
"test:decided_ring holds decide:rst_rows to literal populations: r1 is irreflexive over two roles of A, r2 is asymmetric over a role of B and a role of C, r3 is irreflexive over one role, and u1 is a uniqueness, which is no ring. The rule names r2 and r3, in that order, and nothing else, and cmd:dec_rows makes each the row a write reports, <constraint, deontic, instance>.",
DEF("test:decided_ring",
    S3(A("COMP"), A("eq"),
       S3(A("CONS"),
          S4(A("COMP"), A("cmd:dec_rows"), S3(A("CONS"), K(A("ring-spans-one-type")), A("decide:rst_rows")),
             K(S4(S4(S2(A("r1"), A("IR")), S2(A("r2"), A("AS")), S2(A("r3"), A("IR")), S2(A("u1"), A("UC"))),
                  S3(S2(A("IR"), A("ring")), S2(A("AS"), A("ring")), S2(A("UC"), A("uniqueness"))),
                  S6(S2(A("r1"), A("a.1")), S2(A("r1"), A("a.2")), S2(A("r2"), A("b.1")), S2(A("r2"), A("b.2")), S2(A("r3"), A("a.1")), S2(A("u1"), A("a.1"))),
                  S4(S2(A("A"), A("a.1")), S2(A("A"), A("a.2")), S2(A("B"), A("b.1")), S2(A("C"), A("b.2")))))),
          K(S2(S3(A("ring-spans-one-type"), A("deontic"), A("r2")), S3(A("ring-spans-one-type"), A("deontic"), A("r3"))))))),
"test:decided_uniqueness holds both to literal descriptors. T3a is a ternary with a uniqueness over one role, T4 a quaternary with one over two, and T3b, B2 and U1 meet n-1, so the first answers T3a and T4. Birth objectifies an n:1 binary, Visit an m:n one, and Flag a unary, and Ghost has no descriptor, so the second answers Birth.",
DEF("test:decided_uniqueness",
    S3(A("COMP"), A("and"),
       S3(A("CONS"),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S3(A("COMP"), A("decide:nm1_rows"),
                   K(S5(S5(A("T3a"), S3(A("A"), A("B"), A("C")), S1(S1(N(1))), PHI(), PHI()),
                        S5(A("T3b"), S3(A("A"), A("B"), A("C")), S1(S2(N(1), N(2))), PHI(), PHI()),
                        S5(A("B2"), S2(A("A"), A("B")), S2(S1(N(1)), S1(N(2))), PHI(), PHI()),
                        S5(A("U1"), S1(A("A")), PHI(), PHI(), PHI()),
                        S5(A("T4"), S4(A("A"), A("B"), A("C"), A("D")), S2(S2(N(1), N(2)), S3(N(1), N(2), N(3))), PHI(), PHI())))),
                K(S2(A("T3a"), A("T4"))))),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S3(A("COMP"), A("decide:obj_rows"),
                   K(S2(S4(S2(A("Birth"), A("Birth")), S2(A("Visit"), A("Visit")), S2(A("Flag"), A("Flag")), S2(A("Ghost"), A("Ghost"))),
                        S3(S5(A("Birth"), S2(A("Person"), A("Country")), S1(S1(N(1))), PHI(), PHI()),
                           S5(A("Visit"), S2(A("Person"), A("Country")), S1(S2(N(1), N(2))), PHI(), PHI()),
                           S5(A("Flag"), S1(A("Thing")), PHI(), PHI(), PHI()))))),
                K(S1(A("Birth")))))))),
"test:decided_ring_complete holds decide:rc_rows to literal rows. R1 has its ring, R3 is fully derived and R8 derived and stored, R4 is over Data beside Personal Data, R5 reads `{0} is child of Parent {1}`, and R6 is over two types, so they do not answer. R2 does, and R7, over Function beside an objectified FactIsOfFunction, does too: a name ending in Function without a space before it is no compound noun.",
DEF("test:decided_ring_complete",
    S3(A("COMP"), A("eq"),
       S3(A("CONS"),
          S3(A("COMP"), A("decide:rc_rows"),
             K(S5(S8(S2(A("R1"), S2(A("A"), A("A"))),
                     S2(A("R2"), S2(A("A"), A("A"))),
                     S2(A("R3"), S2(A("A"), A("A"))),
                     S2(A("R4"), S2(A("Data"), A("Data"))),
                     S2(A("R5"), S2(A("B"), A("B"))),
                     S2(A("R6"), S2(A("A"), A("B"))),
                     S2(A("R7"), S2(A("Function"), A("Function"))),
                     S2(A("R8"), S2(A("A"), A("A")))),
                  S1(S2(A("R1"), A("Irreflexive"))),
                  S2(S2(A("R3"), A("full")), S2(A("R8"), A("derived-and-stored"))),
                  S2(S3(A("R5"), S2(A("B"), A("B")), S1(S6(A("{0}"), A("is"), A("child"), A("of"), A("Parent"), A("{1}")))),
                     S3(A("R2"), S2(A("A"), A("A")), S1(S3(A("{0}"), A("likes"), A("{1}"))))),
                  S6(A("A"), A("B"), A("Data"), A("Personal Data"), A("Function"), A("FactIsOfFunction"))))),
          K(S2(A("R2"), A("R7")))))),
"test:decided_refmode holds decide:rm_rows to literal rows. PersonHasPersonId is Person's scheme and declared under its own name. PersonIsIdentifiedByPersonId and PersonIdNamesPerson restate it in either order, each with a uniqueness on the Person Id role. PersonHadFormerPersonId has none, and PersonLivesInCountry is over other players. So the two restatements answer. They answer again with forty scheme readings of another scheme in front of Person`s, so that a host answering decide:rm_cands`s filters by an index, which it does over a list longer than thirty-two, finds both through it.",
DEF("test:decided_refmode",
    S4(A("COMP"), A("and"),
       S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), A("decide:rm_rows"), K(S2(A("PersonIsIdentifiedByPersonId"), A("PersonIdNamesPerson"))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"),
             S3(A("COMP"), A("decide:rm_rows"), S4(A("CONS"), N(1), S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), K(S3(A("ThingHasThingId"), S2(A("Thing"), A("Thing Id")), PHI()))), S3(A("COMP"), A("theta:iota"), K(N(40)))), N(2))), N(3))),
             K(S2(A("PersonIsIdentifiedByPersonId"), A("PersonIdNamesPerson")))))),
             K(S3(S5(S2(A("PersonHasPersonId"), S2(A("Person"), A("Person Id"))),
                     S2(A("PersonIsIdentifiedByPersonId"), S2(A("Person"), A("Person Id"))),
                     S2(A("PersonIdNamesPerson"), S2(A("Person Id"), A("Person"))),
                     S2(A("PersonHadFormerPersonId"), S2(A("Person"), A("Person Id"))),
                     S2(A("PersonLivesInCountry"), S2(A("Person"), A("Country")))),
                  S1(S3(A("PersonHasPersonId"), S2(A("Person"), A("Person Id")), PHI())),
                  S5(S5(A("PersonHasPersonId"), S2(A("Person"), A("Person Id")), S2(S1(N(1)), S1(N(2))), PHI(), PHI()),
                     S5(A("PersonIsIdentifiedByPersonId"), S2(A("Person"), A("Person Id")), S2(S1(N(1)), S1(N(2))), PHI(), PHI()),
                     S5(A("PersonIdNamesPerson"), S2(A("Person Id"), A("Person")), S1(S1(N(1))), PHI(), PHI()),
                     S5(A("PersonHadFormerPersonId"), S2(A("Person"), A("Person Id")), S1(S2(N(1), N(2))), PHI(), PHI()),
                     S5(A("PersonLivesInCountry"), S2(A("Person"), A("Country")), S1(S1(N(1))), PHI(), PHI())))))),
"test:decided_vc holds decide:vc_rows to literal rows. v1 compares a Start Date with an End Date, both dates. v2 compares a date with a decimal Amount, and v3 compares a date with a Customer that has no data type. u1 is a uniqueness. So v2 and v3 answer.",
