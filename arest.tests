       K(S3(S2(A("A"), A("x1")), S2(A("A"), A("z1")), S2(A("D"), A("q1")))),
       K(S1(A("D"))),
       K(S4(S2(A("D"), A("d1")), S2(A("D"), A("d3")), S2(A("D"), A("q1")), S2(A("D"), A("r1")))),
       K(S1(S2(A("D"), A("r1"))))))),
