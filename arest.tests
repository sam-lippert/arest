          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_src"), K(S3(A("U"), A("nope"), A("r1")))))), K(N(404)))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), S3(A("COMP"), A("view:api"), K(S5(A("no-such.db"), A("POST"), A("T"), A("http://v"), A(""))))), K(N(405)))),
