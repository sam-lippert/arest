          S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), A("test:cor3_names"), A("ui:groups"))),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S4(A("COMP"), A("length"), A("theta:dedup"), A("test:cor3_names")),
                S3(A("COMP"), A("length"), A("test:cor3_names"))))))),
