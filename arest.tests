), A("F"))), S2(A("sameKid"), S2(A("P"), A("P"))))))), K(S2(S2(N(4), S2(A("sameKid"), S5(A("joinon"), A("parentIn"), A("parentIn"), S1(S2(N(3), N(3))), S2(N(2), N(5))))), S2(N(4), S2(A("sameKid"), S5(A("joinon"), A("parentIn"), A("parentIn"), S1(S2(N(3), N(3))), S2(N(5), N(2))))))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("induce"), K(S2(S2(S5(A("likes"), S2(A("P"), A("P")), PHI(), PHI(), S1(S2(A("a"), A("b")))), S5(A("friends"), S2(A("P"), A("P")), PHI(), PHI(), S2(S2(A("a"), A("b")), S2(A("b"), A("a"))))), S2(S2(A("likes"), S2(A("P"), A("P"))), S2(A("friends"), S2(A("P"), A("P"))))))), K(S1(S2(N(2), S2(A("friends"), S2(S2(A("friends"), S3(A("proj"), A("likes"), S2(N(1), N(2)))), S2(A("friends"), S3(A("proj"), A("friends"), S2(N(2), N(1))))))))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("induce"), K(S2(S2(S5(A("likes"), S2(A("P"), A("P")), PHI(), PHI(), S1(S2(A("a"), A("b")))), S5(A("nearOrSelf"), S2(A("P"), A("P")), PHI(), PHI(), S3(S2(A("a"), A("b")), S2(A("a"), A("a")), S2(A("b"), A("b"))))), S2(S2(A("likes"), S2(A("P"), A("P"))), S2(A("nearOrSelf"), S2(A("P"), A("P"))))))), K(S1(S2(N(3), S2(A("nearOrSelf"), S3(S2(A("nearOrSelf"), S3(A("proj"), A("likes"), S2(N(1), N(2)))), S2(A("nearOrSelf"), S3(A("proj"), A("likes"), S2(N(1), N(1)))), S2(A("nearOrSelf"), S3(A("proj"), A("likes"), S2(N(2), N(2))))))))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("induce"), K(S2(S3(S5(A("q"), S4(A("P"), A("P"), A("P"), A("P")), PHI(), PHI(), S1(S4(A("a"), A("b"), A("c"), A("d")))), S5(A("m"), S2(A("P"), A("P")), PHI(), PHI(), S1(S2(A("b"), A("e")))), S5(A("link"), S2(A("P"), A("P")), PHI(), PHI(), S1(S2(A("a"), A("e"))))), S3(S2(A("q"), S4(A("P"), A("P"), A("P"), A("P"))), S2(A("m"), S2(A("P"), A("P"))), S2(A("link"), S2(A("P"), A("P"))))))), K(S2(S2(N(1), S2(A("m"), S5(A("joinon"), A("q"), A("link"), S1(S2(N(1), N(1))), S2(N(2), N(6))))), S2(N(1), S2(A("link"), S5(A("joinon"), A("q"), A("m"), S1(S2(N(2), N(1))), S2(N(1), N(6)))))))))))))),

DEF("test:derivesets",
    S4(A("COMP"), A("fp:and_all"), S5(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), A("id")), S3(A("COMP"), A("length"), S3(A("COMP"), A("theta:dedup"), A("id"))))), S3(A("COMP"), A("not"), S3(A("COMP"), A("null"), S3(A("COMP"), A("theta:dedup"), A("id")))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("theta:Project"), K(S2(N(1), N(3)))), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("theta:NatJoin"), K(N(2))), S3(A("CONS"), A("id"), A("id")))))), A("id"))), K(PHI()))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), K(S4(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")), S2(A("d"), A("e")))), A("id"))), K(PHI())))), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("reaches")), S3(A("COMP"), A("derive"), K(S2(S2(S2(A("reaches"), S3(A("proj"), A("contained"), S2(N(1), N(2)))), S2(A("reaches"), S4(A("join"), A("reaches"), A("reaches"), S2(N(1), N(3))))), S2(S2(A("contained"), S4(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")), S2(A("d"), A("e")))), S2(A("reaches"), PHI()))))))))),
DEF("test:derive",
    S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), S2(A("CONST"), A("reaches")), S3(A("COMP"), A("derive"), S2(A("CONST"), S2(S2(S2(A("reaches"), S3(A("proj"), A("contained"), S2(N(1), N(2)))), S2(A("reaches"), S4(A("join"), A("reaches"), A("reaches"), S2(N(1), N(3))))), S2(S2(A("contained"), S3(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")))), S2(A("reaches"), PHI()))))))), S2(A("CONST"), S6(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")), S2(A("a"), A("c")), S2(A("b"), A("d")), S2(A("a"), A("d"))))))),

