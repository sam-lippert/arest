       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), N(2), N(1))), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S4(A("COMP"), N(2), A("read:pop_flushed"), N(2))))),
