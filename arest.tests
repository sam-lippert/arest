DEF("test:rt_fxa", K(S4(S3(A("CELL"), A("FILE"), S4(S3(A("CELL"), A("ThingHasLabel"), S2(S3(A("CELL"), A("t1"), S1(A("alpha"))), S3(A("CELL"), A("t2"), S1(A("alpha"))))), S3(A("CELL"), A("ThingHasColor"), S3(S3(A("CELL"), A("t1"), S1(A("red"))), S3(A("CELL"), A("t2"), S1(A("red"))), S3(A("CELL"), A("t3"), S1(A("blue"))))), S3(A("CELL"), A("ConstraintTypeHasViolationTemplate"), S2(S3(A("CELL"), A("UC"), S1(A("Uniqueness violation: {object_type} {value} is not unique in {reading}"))), S3(A("CELL"), A("MC"), S1(A("Mandatory violation: {object_type} {value} does not participate in {reading}"))))), S3(A("CELL"), A("ConstraintTypeHasConstraintTypeFamily"), S4(S3(A("CELL"), A("IR"), S1(A("ring"))), S3(A("CELL"), A("AC"), S1(A("ring"))), S3(A("CELL"), A("UC"), S1(A("uniqueness"))), S3(A("CELL"), A("MC"), S1(A("mandatory"))))))), S3(A("CELL"), A("state:fts"), S1(S2(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(2))), PHI(), S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("alpha")))), S5(A("ThingHasColor"), S2(A("Thing"), A("Color")), S1(S1(N(2))), S1(N(1)), S3(S2(A("t1"), A("red")), S2(A("t2"), A("red")), S2(A("t3"), A("blue"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")), S2(A("t3"), A("Thing")))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label"))), S2(A("ThingHasColor"), S2(A("Thing"), A("Color"))))))))),
DEF("test:rt_fxb", K(S4(S3(A("CELL"), A("FILE"), S6(S3(A("CELL"), A("ThingHasLabel"), S2(S3(A("CELL"), A("t1"), S1(A("alpha"))), S3(A("CELL"), A("t2"), S1(A("alpha"))))), S3(A("CELL"), A("ThingHasColor"), S3(S3(A("CELL"), A("t1"), S1(A("red"))), S3(A("CELL"), A("t2"), S1(A("red"))), S3(A("CELL"), A("t3"), S1(A("blue"))))), S3(A("CELL"), A("ConstraintTypeHasViolationTemplate"), S2(S3(A("CELL"), A("UC"), S1(A("Uniqueness violation: {object_type} {value} is not unique in {reading}"))), S3(A("CELL"), A("MC"), S1(A("Mandatory violation: {object_type} {value} does not participate in {reading}"))))), S3(A("CELL"), A("ConstraintTypeHasConstraintTypeFamily"), S4(S3(A("CELL"), A("IR"), S1(A("ring"))), S3(A("CELL"), A("AC"), S1(A("ring"))), S3(A("CELL"), A("UC"), S1(A("uniqueness"))), S3(A("CELL"), A("MC"), S1(A("mandatory"))))), S3(A("CELL"), A("FactTypeHasReading"), S1(S3(A("CELL"), A("ThingHasColor"), S1(A("rThingHasColor"))))), S3(A("CELL"), A("ReadingHasText"), S1(S3(A("CELL"), A("rThingHasColor"), S1(A("{0} has {1}"))))))), S3(A("CELL"), A("state:fts"), S1(S2(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(2))), PHI(), S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("alpha")))), S5(A("ThingHasColor"), S2(A("Thing"), A("Color")), S1(S1(N(2))), S1(N(1)), S3(S2(A("t1"), A("red")), S2(A("t2"), A("red")), S2(A("t3"), A("blue"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")), S2(A("t3"), A("Thing")))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label"))), S2(A("ThingHasColor"), S2(A("Thing"), A("Color"))))))))),
"<store, the alethic violations a refused retract owes> to T when the retract of <ThingHasColor, <t3, blue>> from the store answers 409 and, byte for byte, refused, the fact it named, those violations, and no deontic one.",
DEF("test:rt_one",
    S4(A("COMP"), A("fp:and_all"),
       S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S3(A("COMP"), A("render:json"), S5(A("CONS"), K(A("refused")), K(S1(S2(A("ThingHasColor"), S2(A("t3"), A("blue"))))), N(2), K(PHI()))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), K(N(409))))),
       S3(A("CONS"), S3(A("COMP"), A("main:retract_step"), S4(A("CONS"), N(1), K(A("ThingHasColor")), K(S2(A("t3"), A("blue"))))), N(2)))),
"A REFUSED WRITE NAMES THE CONSTRAINT IT BREAKS. A retract fails if it breaks an alethic constraint, and returns the constraint verbalization as the error. A write is refused only for an alethic violation it adds, and the raw tuple <fact type, family, binding> the validator emits names no constraint and reads as nothing to the one refused. MEASURED over test:rt_fx0 before the fix: the retract of the only color of t3 answered [refused, [[ThingHasColor, [t3, blue]]], [[ThingHasColor, mandatory, t3]], []] with 409. Each alethic violation a refused write adds is answered as the Text of its Constraint where the store holds one, else as the Violation Template of the one Constraint Type of its family with the placeholders the violation binds filled, {reading} by the reading of its fact type or by the fact type id where the store holds no reading, else as the tuple itself. So over test:rt_fx0, which holds no template, the answer is the tuple; over test:rt_fxa it reads Mandatory violation: Thing t3 does not participate in ThingHasColor; over test:rt_fxb, Mandatory violation: Thing t3 does not participate in Thing has Color. Before the fix the second and third fail, since each answers the tuple (refusal-text -> F).",
"test:vz_types holds over the base that the Constraint Type families are Halpin's -- SS, EQ and XC set-comparison, MC and OR mandatory, XO none of its own -- and that a violation still finds the Violation Template of its own Constraint Type: a validator's tuple of each kind (test:vt_kinds) (an exclusion and a disjunctive mandatory among them, which found none while the lookup went by family), and a decided violation of each Constraint of the base whose type has a template. Over the tree whose lookup went by family it failed (F: the exclusion and the disjunctive mandatory found no template, and with the families Halpin's neither did a mandatory, a subset or an equality).",
DEF("test:vz_types",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), A("test:vt_fams"), K(S5(S2(A("SS"), A("set-comparison")), S2(A("EQ"), A("set-comparison")), S2(A("XC"), A("set-comparison")), S2(A("MC"), A("mandatory")), S2(A("OR"), A("mandatory")))))),
       S3(A("COMP"), A("null"), A("test:vt_kinds_miss")),
       S3(A("COMP"), A("null"), A("test:vt_cons_miss"))))),
"<store> to the family rows of SS, EQ, XC, MC, OR and XO.",
