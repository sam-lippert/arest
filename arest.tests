             K(A("192.168.1.9")))),
          S3(A("COMP"), A("eq"), S3(A("CONS"),
             S3(A("COMP"), A("perform:blocked_in"), K(S2(S1(A("93.184.216.34")), S1(A("10.0.0.0/8"))))),
             K(A(""))))))))),
"test:decided_ssrf holds decide:ssrf_rows to nine URLs against security.md's eight blocks. s1 (10.1.2.3), s3 (127.0.0.1 with a port), s4 ([::1] with a port), s6 (localhost), s8 (172.31.255.255 behind a userinfo, inside 172.16.0.0/12) and s9 ([fd12:3456::1], inside fc00::/7) answer. s2 is a hostname and is not resolved, s5 (8.8.8.8) is public, and s7 (172.32.0.1) lies just outside 172.16.0.0/12.",
