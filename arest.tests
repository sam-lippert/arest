    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:dv_files"))),
DEF("test:dv_head",
    K(A("MemberAttendsVenue"))),
DEF("test:dv_db",
    K(A("law-derived-view.db"))),
