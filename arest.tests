       S2(A("LawPushes"), S3(A("LawPing2"), A("law-gauge"), A("-0.5"))),
       S2(A("EventIsOfEventType"), S2(A("law-e3"), A("LawPing"))),
       S2(A("EventOccurredAtTimestamp"), S2(A("law-e3"), A("2026-10-06T19:00:00Z"))),
       S2(A("LawMoves"), S3(A("law-e3"), A("law-gauge"), A("0.2"))),
