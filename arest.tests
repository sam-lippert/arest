       S3(A("COMP"), A("test:qs_cn3"), S3(A("CONS"), N(1), S3(A("COMP"), A("get:typed"), S3(A("CONS"), S3(A("COMP"), N(2), N(2)), N(3))))))),
DEF("test:qs_cn3",
    S4(A("COND"), S3(A("COMP"), A("null"), N(2)), K(PHI()),
       S4(A("COND"), S3(A("COMP"), A("null"), S3(A("COMP"), A("storage:cut_rows"), S5(A("CONS"), S3(A("COMP"), A("query:db"), S4(A("COMP"), N(2), N(2), N(1))), S4(A("COMP"), N(2), N(1), N(1)), N(2), S4(A("COMP"), N(1), N(2), N(1))))), K(PHI()),
          S2(A("CONS"), S4(A("COMP"), N(1), N(1), N(1)))))),
"The recipes lambda answers over both: a starts, a sum, a calc, a flat, and a sel of a number in a column of text.",
DEF("test:qs_mem",
    K(S5(S4(A("starts"), A("MemberJoinsClub"), N(2), A("ch")),
