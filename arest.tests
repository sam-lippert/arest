       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("store:step_held"), S4(A("CONS"), N(3), N(3), K(S3(A("UserSubmitsDomainChangeForReview"), A("law-user"), A("dc-law-other"))))), N(3))),
