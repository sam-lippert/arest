       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), N(1)), K(N(3)))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(2)), N(1)), K(S3(A("uniqueness"), A("mandatory"), A("subset")))))),
       S3(A("CONS"), S3(A("COMP"), A("validate"), A("test:va_store")), S4(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), N(1), N(2), N(3))), A("main:alethic_of"), S3(A("COMP"), A("ui:violations"), A("test:va_store"))))))),
