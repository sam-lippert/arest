       S3(A("COMP"), A("test:dq_sql"), S3(A("CONS"), N(1), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), N(2), N(2))))),
       S3(A("COMP"), A("derive:on_read"), S3(A("CONS"), N(1), S3(A("COMP"), N(3), N(2))))))),
