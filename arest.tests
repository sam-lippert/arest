       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("bob"), A("silver"))), A("id"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("dee"), A("bronze"))), A("id")))))),
