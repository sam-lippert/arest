    S6(A("COMP"), A("test:fm_db"), A("sqlite:exec"), S3(A("CONS"), A("test:fm_db"), K(A("create table \"_readings\" (\"ft\" text not null, \"row\" text not null, primary key (\"ft\", \"row\")) without rowid; create table \"_derived\" (\"ft\" text not null, \"row\" text not null, primary key (\"ft\", \"row\")) without rowid; insert into \"_readings\" values ('A', 'x1'), ('A', 'y1'), ('D', 'q1'); insert into \"_derived\" values ('D', 'd1'), ('D', 'd2'), ('E', 'e1');"))), A("storage:fresh"), A("test:fm_db"))),
