DEF("test:open_mandatory",
    S3(A("COMP"), S3(A("COMP"), A("fp:and_all"), S5(A("CONS"),
          S3(A("COMP"), A("null"), S3(A("COMP"), A("test:om_viols"), N(1))),
          S4(A("COMP"), A("not"), A("null"), S3(A("COMP"), A("test:om_viols"), N(2))),
          S3(A("COMP"), A("null"), S3(A("COMP"), A("test:om_entries"), N(1))),
          S4(A("COMP"), A("not"), A("null"), S3(A("COMP"), A("test:om_entries"), N(2))))),
       S3(A("CONS"), S3(A("COMP"), A("test:om_store"), K(A("open"))), S3(A("COMP"), A("test:om_store"), K(A("closed")))))),
DEF("test:semi_served",
    S6(A("COMP"), A("test:ss_verdict"), A("test:dq_eng"), A("test:dv_s3"), A("test:dv_s2"), A("test:ss_s1"))),
"THE REQUIRED ORIENTATION A SERVER ASKS OF ITS DATABASE IS WHAT THE STORE IN MEMORY ANSWERS. test:orient_served`s readings are orient`s fact types as the metamodel declares them (core.md, instances.md), Function belongs to Domain and an instance`s most specific type among them, and two readings files that each declare their Domain as a readings file declares it, by the first Domain sentence they write (compile:domain_seq): heads.md declares Club in Domain heads and clubs.md Member and Venue in Domain clubs, which heads contains. bob is a Member, chess a Club and york a Venue; each is required orientation, and york is currently in Status Closed, which is terminal in State Machine Definition Venue. An instance`s Domain is its type`s, by inheritance, so orient of heads answers chess in heads, then bob in clubs, then the two Descriptions, and not york. The store is closed as a compile closes it, laid out in law-orient-served.db as a compile lays it out, has the engine compute the derived fact types it takes (test:dv_s2, test:dv_s3, test:dq_eng), and is served as a host serves a store (test:ss_served), so orient asks the database for the scope`s required orientation (orient:live_in); the store in memory is the one a server holds of that database (test:qs_back). orient of heads, of hub, of clubs and of a name that is neither answers the same text over both, and orient of heads over the served store answers those four rows in that order. test:query_sql cannot hold this leg: its readings declare Club and Member in one file and no Domain, so its orient answers the Descriptions alone. The database is made fresh before and cleared after. Run first, before orient read the required rows Domain by Domain of the scope, the store in memory answered bob before chess and it failed.",
DEF("test:os_files",
    K(S3(S3(A("orient.md"), A("Domain(.Name) is an entity type.\nApp(.Name) is an entity type.\nFunction(.Name) is an entity type.\nObject Type Instance is an entity type.\nObject Type Instance is a subtype of Function.\nDomain is an entity type.\nDomain is a subtype of Object Type Instance.\nObject Type(.Name) is an entity type.\nStatus(.Name) is an entity type.\nState Machine Definition(.Name) is an entity type.\nDescription is a value type.\nDomain contains Domain.\n  Each Domain, Domain combination occurs at most once in the population of Domain contains Domain.\nDomain reaches Domain. *\n  Each Domain, Domain combination occurs at most once in the population of Domain reaches Domain.\n* Domain1 reaches Domain2 iff Domain1 contains Domain2.\n* Domain1 reaches Domain3 iff Domain1 reaches Domain2 and Domain2 reaches Domain3.\nFunction has Description.\n  Each Function has at most one Description.\nApp has navigable Domain.\n  Each App, Domain combination occurs at most once in the population of App has navigable Domain.\nObject Type Instance is required orientation.\nObject Type Instance is currently in Status.\n  Each Object Type Instance, Status combination occurs at most once in the population of Object Type Instance is currently in Status.\nStatus is terminal in State Machine Definition.\n  Each Status, State Machine Definition combination occurs at most once in the population of Status is terminal in State Machine Definition.\nObject Type Instance is instance of Object Type.\n  Each Object Type Instance, Object Type combination occurs at most once in the population of Object Type Instance is instance of Object Type.\nObject Type is subtype of Object Type.\n  Each Object Type, Object Type combination occurs at most once in the population of Object Type is subtype of Object Type.\nObject Type Instance is properly of Object Type. **\n  Each Object Type Instance, Object Type combination occurs at most once in the population of Object Type Instance is properly of Object Type.\nObject Type Instance is most specifically of Object Type. **\n  Each Object Type Instance, Object Type combination occurs at most once in the population of Object Type Instance is most specifically of Object Type.\n** Object Type Instance is properly of Object Type1 iff that Object Type Instance is instance of some Object Type2 and that Object Type2 is subtype of that Object Type1.\n** Object Type Instance is most specifically of Object Type iff that Object Type Instance is instance of that Object Type and it is not true that that Object Type Instance is properly of that Object Type.\nFunction belongs to Domain.\n  Each Function belongs to at most one Domain.\nDomain 'heads' contains Domain 'clubs'.\nApp 'hub' has navigable Domain 'heads'.\nObject Type Instance 'bob' is required orientation.\nObject Type Instance 'chess' is required orientation.\nObject Type Instance 'york' is required orientation.\nObject Type Instance 'york' is currently in Status 'Closed'.\nStatus 'Closed' is terminal in State Machine Definition 'Venue'.\n"), A("fx/orient.md")),
         S3(A("heads.md"), A("Club(.id) is an entity type.\nDomain 'heads' has Description 'Clubs and the members they seat'.\n"), A("fx/heads.md")),
         S3(A("clubs.md"), A("Member(.id) is an entity type.\nVenue(.id) is an entity type.\nMember joins Club.\n  Each Member, Club combination occurs at most once in the population of Member joins Club.\nClub holds Venue.\n  Each Club, Venue combination occurs at most once in the population of Club holds Venue.\nMember 'bob' joins Club 'chess'.\nClub 'chess' holds Venue 'york'.\nDomain 'clubs' has Description 'Members and the venues their clubs hold'.\n"), A("fx/clubs.md"))))),
