"<store>: dc-law-step`s status.",
DEF("test:sp_at",
    S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("dc-law-step")), S3(A("COMP"), A("main:status_pop"), S3(A("CONS"), A("id"), K(A("Domain Change"))))))),
