       S3(A("COMP"), A("null"), A("test:nr_cells")),
       S4(A("COMP"), A("null"), A("theta:find_desc"), S3(A("CONS"), A("test:nr_name"), A("store:fts"))),
       S3(A("COMP"), A("null"), A("test:nr_modes"))))),
