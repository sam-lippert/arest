       S3(A("CONS"),
          S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), S3(A("COMP"), N(2), N(2)), N(1))),
          S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), N(1)))))),
