          S3(A("COMP"), A("theta:subset"), S3(A("CONS"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))), K(A("#")))), K(PHI()), S3(A("COMP"), A("rmap:unnest"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))))), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), N(1))))),
       S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))), K(A("#")))), K(A("T")),
          S3(A("COMP"), A("null"), S3(A("COMP"), A("rmap:unnest"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))))))),
    S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))), K(A("#")))), K(PHI()), S3(A("COMP"), A("rmap:unnest"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:file_of"), N(1)))))), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), S3(A("COMP"), N(1), N(2)), N(1))))))),
"<store>: the witness of file-is-projection, the declared fact types whose descriptor holds a row the population system:pop_rows reads does not, and those whose FILE cell is not that population.",
