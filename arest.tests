       S2(A("ObjectTypeInstanceIsInstanceOfObjectType"), S(S2(A("schema:CrateIsInspectedOnDate"), A("Table")), S2(A("schema:Crate"), A("Table")), S2(A("schema:Item"), A("Table")), S2(A("schema:CrateIsInspectedOnDate:date"), A("Column")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("Column")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("Column")), S2(A("schema:CrateIsInspectedOnDate:crate"), A("Column")), S2(A("schema:Crate:shelf"), A("Column")), S2(A("schema:Crate:slot"), A("Column")), S2(A("schema:Crate:crate"), A("Column")), S2(A("schema:Crate:weight"), A("Column")), S2(A("schema:Item:code"), A("Column")), S2(A("schema:Item:crate"), A("Column")), S2(A("schema:Item:shelf"), A("Column")), S2(A("schema:Item:slot"), A("Column")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK"), A("Table Key")), S2(A("schema:Crate:Crate_PK"), A("Table Key")), S2(A("schema:Item:Item_PK"), A("Table Key")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_FK"), A("Table Reference")), S2(A("schema:Item:Item_FK"), A("Table Reference")), S2(A("schema"), A("Relational Schema")))),
