       S3(A("COMP"), A("test:sp_put"), S4(A("CONS"), A("id"), K(A("ObservationIsOfFact")), K(S2(A("obs-law-br2"), A("f-law-br2"))))),
       S3(A("COMP"), A("test:sp_put"), S4(A("CONS"), A("id"), K(A("ObservationIsOfFact")), K(S2(A("obs-law-br1"), A("f-law-br1"))))),
       S3(A("COMP"), A("test:cls_put"), S3(A("CONS"), A("id"), K(S5(S2(A("obs-law-br1"), A("Observation")), S2(A("obs-law-br2"), A("Observation")), S2(A("obs-law-br3"), A("Observation")), S2(A("f-law-br1"), A("Fact")), S2(A("f-law-br2"), A("Fact")))))),
       S3(A("COMP"), A("test:sp_put"), S4(A("CONS"), A("id"), K(A("ObjectTypeIsOfObjectKind")), K(S2(A("Fact"), A("entity"))))),
       S3(A("COMP"), A("test:sp_put"), S4(A("CONS"), A("id"), K(A("ObjectTypeIsOfObjectKind")), K(S2(A("Observation"), A("entity"))))),
       A("test:br_schema"))),
"<store> to what the entity DELETE of the Observations of no Fact, named by a query recipe in place of an id, answers over test:br_fx: the Observations less those of a Fact, the recipe a bulk retract asks.",
