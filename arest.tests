          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_src"), K(S2(A("T"), A("r1"))))), K(S2(A("{\"table\":\"T\",\"key\":\"id\",\"_links\":{\"self\":\"http://v/T/r1\",\"up\":\"http://v/T\",\"U.tid\":\"http://v/U/tid/r1\"},\"rows\":[{\"id\":\"r1\",\"a\":\"x\",\"_links\":{\"self\":\"http://v/T/r1\"}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_src"), K(S3(A("U"), A("tid"), A("r1"))))), K(S2(A("{\"table\":\"U\",\"where\":{\"tid\":\"r1\"},\"_links\":{\"self\":\"http://v/U/tid/r1\",\"up\":\"http://v/U\"},\"rows\":[{\"uid\":\"u1\",\"tid\":\"r1\",\"_links\":{\"self\":\"http://v/U/u1\"}}]}"), N(200))))),
