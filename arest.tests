"test:column_verbalized holds law:column_verbalized (every Column is for a Role whose Fact Type has a primary Reading, and rendering that Reading`s columns back yields the same Column) to literal rows of the Relational Schema in a database with no file (sqlite:scratch). Fixture a holds: Crate keyed by crateId, which is for the reference`s Role, with weight and the unary isFragile absorbed, the relation CrateIsShippedToPort keyed by its two Roles, its crateId also for the reference`s Role, and a view whose column is for no Role, which the law reads past; and PalletHoldsCrate, where a Crate identified by its Shelf and Slot plays the second Role, so that Role is three Columns, the two components and the reference beside them (rmap:ctab_bridge), each rendered back through a path of its own (Halpin ch. 10: a compositely identified player is unpacked into its components` columns): shelf through Crate is on Shelf as well, slot through Crate has Slot, crate through that Role alone. BinHoldsCrate is the same shape under a Fact Type whose Role sorts before its components`, so a Column is read back by every Role it is for, never the least of them. Every Fact Type has its primary Reading and every Role is used in it, so neither statement answers a row. Fixture b breaks each clause: note is for no Role; color is for a Role whose Fact Type`s Reading is not primary, and size for one its primary Reading does not use; weightKg is for the Roles weight is for, so rendering Crate has Weight back over Crate`s columns yields two Columns by one path and each of them renders back as another. Fixture c is a store whose readings re-identified the metamodel`s Role laid out Column is for Role as columnId and role, so the Column its Reading renders, roleId, is not in the store and storage:schema_rows read back no fact type; the layout statement names both and the law answers them in place of the rows it cannot read. And the composed store`s reflection files each Fact Type`s first Reading as primary (Reading is primary, core.md), which no store held. Run first with no sqlite:verbal_sql, sqlite:verbal_layout or primary Reading, it failed. AND A COLUMN RENDERS BACK THROUGH ITS PATH: the statement first read a Column back by one Role alone, and over a served app`s store 36 Columns of compositely identified players rendered back as one another; with PalletHoldsCrate in fixture a it failed again.",
DEF("test:cv_tables",
    K(A("create table Function (functionId, tableName, tableIsAView, tableRelationalSchemaId, tableFactTypeId, tableObjectTypeId, columnTableId, columnName, columnPosition, columnConceptualDataTypeId, columnIsNullable, tableKeyBelongsToTableId, tableKeyTableId, tableReferenceTableId, tableReferenceTableKeyId, readingFactTypeId, readingIsPrimary, roleFactTypeId, roleObjectTypeId, objectTypeObjectKind); create table TableKeySpansColumn (tableKeyId, columnId); create table TableReferenceUsesColumn (tableReferenceId, columnId); create table RoleIsUsedInReading (roleIsUsedInReadingId, readingId, roleId); "))),
DEF("test:cv_rows_a",
    K(A("insert into Function (functionId, tableName, tableFactTypeId, tableIsAView) values ('t1', 'Crate', null, null), ('t2', 'CrateIsShippedToPort', 'CrateIsShippedToPort', null), ('t3', 'HeavyCrate', null, 'T'); insert into Function (functionId, tableKeyTableId) values ('k1', 't1'), ('k2', 't2'); insert into Function (functionId, columnTableId, columnName) values ('c1', 't1', 'crateId'), ('c2', 't1', 'weight'), ('c3', 't1', 'isFragile'), ('c4', 't2', 'crateId'), ('c5', 't2', 'port'), ('c6', 't3', 'crateId'); insert into Function (functionId, readingFactTypeId, readingIsPrimary) values ('rCrateHasCrateId', 'CrateHasCrateId', 'T'), ('rCrateHasWeight', 'CrateHasWeight', 'T'), ('rCrateIsFragile', 'CrateIsFragile', 'T'), ('rCrateIsShippedToPort', 'CrateIsShippedToPort', 'T'); insert into ColumnIsForRole values ('c1', 'CrateHasCrateId.2'), ('c2', 'CrateHasWeight.2'), ('c3', 'CrateIsFragile.1'), ('c4', 'CrateIsShippedToPort.1'), ('c4', 'CrateHasCrateId.2'), ('c5', 'CrateIsShippedToPort.2'); insert into TableKeySpansColumn values ('k1', 'c1'), ('k2', 'c4'), ('k2', 'c5'); insert into RoleIsUsedInReading (readingId, roleId) values ('rCrateHasCrateId', 'CrateHasCrateId.1'), ('rCrateHasCrateId', 'CrateHasCrateId.2'), ('rCrateHasWeight', 'CrateHasWeight.1'), ('rCrateHasWeight', 'CrateHasWeight.2'), ('rCrateIsFragile', 'CrateIsFragile.1'), ('rCrateIsShippedToPort', 'CrateIsShippedToPort.1'), ('rCrateIsShippedToPort', 'CrateIsShippedToPort.2'); insert into Function (functionId, tableName, tableFactTypeId) values ('t4', 'PalletHoldsCrate', 'PalletHoldsCrate'); insert into Function (functionId, tableKeyTableId) values ('k4', 't4'); insert into Function (functionId, columnTableId, columnName) values ('c11', 't4', 'pallet'), ('c12', 't4', 'shelf'), ('c13', 't4', 'slot'), ('c14', 't4', 'crate'); insert into Function (functionId, readingFactTypeId, readingIsPrimary) values ('rPalletHoldsCrate', 'PalletHoldsCrate', 'T'), ('rCrateIsOnShelf', 'CrateIsOnShelf', 'T'), ('rCrateHasSlot', 'CrateHasSlot', 'T'); insert into ColumnIsForRole values ('c11', 'PalletHoldsCrate.1'), ('c12', 'PalletHoldsCrate.2'), ('c12', 'CrateIsOnShelf.2'), ('c13', 'PalletHoldsCrate.2'), ('c13', 'CrateHasSlot.2'), ('c14', 'PalletHoldsCrate.2'); insert into TableKeySpansColumn values ('k4', 'c11'), ('k4', 'c12'), ('k4', 'c13'); insert into RoleIsUsedInReading (readingId, roleId) values ('rPalletHoldsCrate', 'PalletHoldsCrate.1'), ('rPalletHoldsCrate', 'PalletHoldsCrate.2'), ('rCrateIsOnShelf', 'CrateIsOnShelf.1'), ('rCrateIsOnShelf', 'CrateIsOnShelf.2'), ('rCrateHasSlot', 'CrateHasSlot.1'), ('rCrateHasSlot', 'CrateHasSlot.2'); insert into Function (functionId, tableName, tableFactTypeId) values ('t5', 'BinHoldsCrate', 'BinHoldsCrate'); insert into Function (functionId, tableKeyTableId) values ('k5', 't5'); insert into Function (functionId, columnTableId, columnName) values ('c15', 't5', 'bin'), ('c16', 't5', 'shelf'), ('c17', 't5', 'slot'), ('c18', 't5', 'crate'); insert into Function (functionId, readingFactTypeId, readingIsPrimary) values ('rBinHoldsCrate', 'BinHoldsCrate', 'T'); insert into ColumnIsForRole values ('c15', 'BinHoldsCrate.1'), ('c16', 'BinHoldsCrate.2'), ('c16', 'CrateIsOnShelf.2'), ('c17', 'BinHoldsCrate.2'), ('c17', 'CrateHasSlot.2'), ('c18', 'BinHoldsCrate.2'); insert into TableKeySpansColumn values ('k5', 'c15'), ('k5', 'c16'), ('k5', 'c17'); insert into RoleIsUsedInReading (readingId, roleId) values ('rBinHoldsCrate', 'BinHoldsCrate.1'), ('rBinHoldsCrate', 'BinHoldsCrate.2'); "))),
DEF("test:cv_rows_b",
    K(A("insert into Function (functionId, columnTableId, columnName) values ('c7', 't1', 'note'), ('c8', 't1', 'color'), ('c9', 't1', 'size'), ('c10', 't1', 'weightKg'); insert into Function (functionId, readingFactTypeId, readingIsPrimary) values ('rCrateHasColor', 'CrateHasColor', null), ('rCrateHasSize', 'CrateHasSize', 'T'); insert into ColumnIsForRole values ('c8', 'CrateHasColor.2'), ('c9', 'CrateHasSize.2'), ('c10', 'CrateHasWeight.2'); insert into RoleIsUsedInReading (readingId, roleId) values ('rCrateHasColor', 'CrateHasColor.1'), ('rCrateHasColor', 'CrateHasColor.2'), ('rCrateHasSize', 'CrateHasSize.1'); "))),
DEF("test:cv_a",
    S3(A("COMP"), A("implode"), S3(A("CONS"), K(A("")), S4(A("CONS"), A("test:cv_tables"), K(A("create table ColumnIsForRole (columnId, roleId); ")), A("test:cv_rows_a"))))),
DEF("test:cv_b",
    S3(A("COMP"), A("implode"), S3(A("CONS"), K(A("")), S5(A("CONS"), A("test:cv_tables"), K(A("create table ColumnIsForRole (columnId, roleId); ")), A("test:cv_rows_a"), A("test:cv_rows_b"))))),
