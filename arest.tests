    S3(A("COMP"), A("fp:and_all"),
       S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_fsrc"), K(S3(A("T"), A("THasB"), A("y"))))), K(S2(A("{\"table\":\"T\",\"where\":{\"THasB\":\"y\"},\"_links\":{\"self\":\"http://v/T/THasB/y\",\"up\":\"http://v/T\"},\"rows\":[{\"id\":\"r2\",\"a\":\"x\",\"b\":\"y\",\"_links\":{\"self\":\"http://v/T/r2\"}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_fsrc"), K(S3(A("T"), A("THasNothing"), A("y")))))), K(N(404))))))),
DEF("test:view_reads",
    S3(A("COMP"), A("fp:and_all"),
       S9(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_src"), K(PHI()))), K(S2(A("{\"_links\":{\"self\":\"http://v/\",\"Function\":\"http://v/Function\",\"ObjectTypeInstanceIsInstanceOfObjectType\":\"http://v/ObjectTypeInstanceIsInstanceOfObjectType\",\"T\":\"http://v/T\",\"U\":\"http://v/U\",\"_rplan_src\":\"http://v/_rplan_src\"}}"), N(200))))),
