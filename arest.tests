       S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("id"), S2(A("CONST"), A("#")))),
          S2(A("CONST"), PHI()), A("theta:flatten")),
       S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), S2(A("CONST"), A("state:derived")), A("id"))))),
