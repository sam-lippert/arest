    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("main:re_group"), S3(A("CONS"), K(S1(S2(A("Some Subtype"), A("x-law-rg")))), A("test:rg_fx"))), S3(A("COMP"), N(1), A("ui:groups")))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("main:re_group"), S3(A("CONS"), K(S1(S2(A("Some Subtype"), A("no-such-law-id")))), A("id"))), K(A(""))))))),
