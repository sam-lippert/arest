       S2(A("TableReferenceUsesColumn"), S6(S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_FK"), A("schema:CrateIsInspectedOnDate:shelf")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_FK"), A("schema:CrateIsInspectedOnDate:slot")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_FK"), A("schema:CrateIsInspectedOnDate:crate")), S2(A("schema:Item:Item_FK"), A("schema:Item:shelf")), S2(A("schema:Item:Item_FK"), A("schema:Item:slot")), S2(A("schema:Item:Item_FK"), A("schema:Item:crate"))))))),
"<wanted <fact type, rows>, answered <fact type, rows>> to T when the answer names exactly the wanted fact types and each holds exactly the wanted rows.",
