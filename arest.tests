          S3(A("COMP"), A("sqlite:query"), S4(A("CONS"), N(1), S3(A("COMP"), A("sqlite:src_sql"), N(2)), K(PHI())))),
       S3(A("CONS"), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("schema:read_place"), S3(A("CONS"), N(1), S3(A("COMP"), N(2), N(2))))))),
"<derived fact type, <database, env, store>> to T when the rows the database answers for the derived fact type are the rows lambda`s read over the store`s cells answers (derive:on_read).",
