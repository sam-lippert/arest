        S4(A("Name is a value type.\nNickname is a value type.\nMember(.Name) is an entity type.\nClub(.Name) is an entity type.\nMember has Nickname.\n  Each Member has at most one Nickname.\nMember joins Club.\n  Each Member, Club combination occurs at most once in the population of Member joins Club.\nMember belongs to Club. *\n  Each Member, Club combination occurs at most once in the population of Member belongs to Club.\n  Each Member belongs to some Club.\n* Member belongs to Club iff Member joins Club.\n"), S2(S2(A("MemberHasNickname"), S2(S2(A("m1"), A("ace")), S2(A("m2"), A("bee")))), S2(A("MemberJoinsClub"), S1(S2(A("m1"), A("c1"))))), S3(S2(A("m1"), A("Member")), S2(A("m2"), A("Member")), S2(A("c1"), A("Club"))), A("V")),
