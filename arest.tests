       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(1)), N(1)), S3(A("COMP"), S2(A("ALPHA"), N(1)), N(2)))),
       S4(A("COMP"), A("fp:and_all"), S2(A("ALPHA"), S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), N(2)))))), A("distr"))))),
