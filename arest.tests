 A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437")))))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("csdp:s2"), K(S2(S1(S5(A("Empty"), S1(A("A")), PHI(), PHI(), PHI())), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437"))))))), K(PHI()))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("csdp:s7"), K(S2(S1(S5(A("W"), S3(A("A"), A("B"), A("C")), S1(S1(N(1))), PHI(), S1(S3(A("x"), A("y"), A("z"))))), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437"))))))), K(PHI())))))),

