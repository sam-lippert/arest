       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("LawRyFed")), A("compile:ip_ruleless"))),
       S4(A("COMP"), A("not"), A("theta:member"), S3(A("CONS"), K(A("LawRyYld")), A("compile:ip_excluded"))),
