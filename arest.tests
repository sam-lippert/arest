       S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), S3(A("COMP"), A("http:status_of"), K(A("refused"))))), K(A("T")),
          S3(A("COMP"), A("fp:and_all"), S4(A("CONS"),
             S4(A("COMP"), A("null"), A("theta:flatten"), A("test:wr_da")),
             A("test:wr_held"),
             A("test:wr_adopted"))))))),
"<before, <verb, fact type, fact>> to T when the write keeps the law: answered without the refresh`s names, and with them, run in SQL.",
DEF("test:wr_one",
    S3(A("COMP"), A("test:wr_one2"), S4(A("CONS"),
       S3(A("COMP"), A("test:wr_do"), S5(A("CONS"), N(1), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), N(2), N(2)), S3(A("COMP"), N(3), N(2)))),
       S3(A("COMP"), A("test:wr_do"), S5(A("CONS"), S3(A("COMP"), A("test:wr_on"), N(1)), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), N(2), N(2)), S3(A("COMP"), N(3), N(2)))),
       N(1)))),
DEF("test:wr_one2",
    S3(A("COMP"), A("test:wr_ok"), S5(A("CONS"), N(1), N(2), N(3), S3(A("COMP"), A("test:wr_run"), S3(A("CONS"), N(3), S3(A("COMP"), N(3), N(2))))))),
"test:refresh_law holds the refresh of a stored derived fact type from a write`s delta to the closure, byte for byte (Gupta, Mumick and Subrahmanian 1993): Crate is held in Lot, marked **, a Crate in a Lot it is not released from, stored as a relation; Crate is housed at Site, marked **, at most one per Crate, the Site of a Lot it is held in, stored as a column of Crate`s table and read after the first. Over the store test:wr_before closes, each of six writes is answered by the closure with every rule and by the closure without the two (the store carrying their names), and the latter`s rows run in SQL with the refresh (test:wr_run): a Crate put in the Lot (both gain, the insertion phase), a Crate released (the subtrahend gains, both lose), the Lot`s Site taken away (housed loses, DRed`s over-deletion), the Lot given a second Site (one Crate derived two Sites, which the refresh denies, rendered as the refusal the closure answers), a release taken back (the subtrahend loses, both gain) and a Crate taken out of the Lot (its column`s value goes). Each committed write answers the same body and status, and each refreshed place holds after the refresh, and the store the process holds after taking its rows holds, what the closure with every rule holds.",
DEF("test:refresh_law",
    S4(A("COMP"), A("fp:and_all"), S2(A("ALPHA"), A("test:wr_one")), S3(A("COMP"), A("distl"), S3(A("CONS"), A("test:wr_before"),
       K(S6(S3(A("post"), A("CrateIsInLot"), S2(A("c2"), A("l1"))), S3(A("post"), A("CrateIsReleasedFromLot"), S2(A("c1"), A("l1"))), S3(A("del"), A("LotIsAtSite"), S2(A("l1"), A("s1"))), S3(A("post"), A("LotIsAtSite"), S2(A("l1"), A("s2"))), S3(A("del"), A("CrateIsReleasedFromLot"), S2(A("c3"), A("l1"))), S3(A("del"), A("CrateIsInLot"), S2(A("c1"), A("l1"))))))))),
DEF("test:refused_render",
    S3(A("COMP"), A("fp:and_all"), S6(A("CONS"),
       S3(A("COMP"), A("test:rr_post"), A("test:dw_store")),
       S3(A("COMP"), A("test:rr_entity"), A("test:rr_crates")),
       S3(A("COMP"), A("test:rr_assert"), S3(A("COMP"), A("main:w2_flag"), S3(A("CONS"), A("test:rr_crates"), K(A("T"))))),
       S3(A("COMP"), A("test:rr_shipped"), A("test:rr_more")),
       S3(A("COMP"), A("test:rr_closed"), A("test:rr_more"))))),
"test:validate_all holds the validate verb to every alethic violation a store holds at rest. validate answered the uniquenesses alone (cmd:validate over the descriptors), so a store holding a mandatory or a subset violation validated clean. The fixture is one readings file holding one violation of each of three kinds: two Crates with one Tag where For each Tag, at most one Crate has that Tag; a Crate with no Weight where Each Crate has some Weight; and a Crate shipped and not checked where a shipped Crate is checked. validate of the store answers exactly the alethic violations the in-memory judge answers of it, each <fact type, kind, instance>, and they are three, one uniqueness, one mandatory and one subset. Run first with validate answering the uniquenesses alone, it failed.",
DEF("test:va_store",
    S3(A("COMP"), A("test:cs_store"), K(S4(A("Name is a value type.\nTag is a value type.\nWeight is a value type.\nCrate(.Name) is an entity type.\nCrate has Tag.\n  Each Crate has at most one Tag.\n  For each Tag, at most one Crate has that Tag.\nCrate has Weight.\n  Each Crate has at most one Weight.\n  Each Crate has some Weight.\nCrate is shipped.\nCrate is checked.\nIf some Crate is shipped then that Crate is checked.\n"),
       S3(S2(A("CrateHasTag"), S2(S2(A("c1"), A("t")), S2(A("c2"), A("t")))), S2(A("CrateHasWeight"), S1(S2(A("c1"), A("w")))), S2(A("CrateIsShipped"), S1(S1(A("c2"))))),
       S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("V"))))),
DEF("test:validate_all",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S4(A("CONS"),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), N(1), N(2))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), N(1)), K(N(3)))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(2)), N(1)), K(S3(A("uniqueness"), A("mandatory"), A("subset")))))),
       S3(A("CONS"), S3(A("COMP"), A("validate"), A("test:va_store")), S4(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), N(1), N(2), N(3))), A("main:alethic_of"), S3(A("COMP"), A("ui:violations"), A("test:va_store"))))))),
"test:view_root holds a row to the facts its id holds on the root (a status shows with the row it is the status of). T is keyed by id and Function holds r1's status Draft and an a of its own: T's row r1 carries objectTypeInstanceStatusId Draft after its own columns and keeps its own a, and r2, which Function does not hold, carries nothing more. P is keyed by two columns, so its row is no entity's and carries nothing; Function's row is not composed with itself.",
DEF("test:view_rscript", K(A("create table T (id text primary key, a text); insert into T values ('r1', 'x'), ('r2', 'y'); create table P (k1 text, k2 text, primary key (k1, k2)); insert into P values ('r1', 'z'); create table Function (functionId text primary key, a text, objectTypeInstanceStatusId text); insert into Function values ('r1', 'shadow', 'Draft');"))),
DEF("test:view_rsrc", S5(A("CONS"), K(A("sqlite:scratch")), A("test:view_rscript"), K(A("http://v")), K(N(0)))),
DEF("test:view_root",
    S3(A("COMP"), A("fp:and_all"),
       S4(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_rsrc"), K(S1(A("T"))))), K(S2(A("{\"table\":\"T\",\"_links\":{\"self\":\"http://v/T\",\"up\":\"http://v/\"},\"rows\":[{\"id\":\"r1\",\"a\":\"x\",\"objectTypeInstanceStatusId\":\"Draft\",\"_links\":{\"self\":\"http://v/T/r1\"}},{\"id\":\"r2\",\"a\":\"y\",\"_links\":{\"self\":\"http://v/T/r2\"}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_rsrc"), K(S1(A("P"))))), K(S2(A("{\"table\":\"P\",\"_links\":{\"self\":\"http://v/P\",\"up\":\"http://v/\"},\"rows\":[{\"k1\":\"r1\",\"k2\":\"z\",\"_links\":{\"self\":\"http://v/P/r1\"}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), A("test:view_rsrc"), K(S1(A("Function"))))), K(S2(A("{\"table\":\"Function\",\"_links\":{\"self\":\"http://v/Function\",\"up\":\"http://v/\"},\"rows\":[{\"functionId\":\"r1\",\"a\":\"shadow\",\"objectTypeInstanceStatusId\":\"Draft\",\"_links\":{\"self\":\"http://v/Function/r1\"}}]}"), N(200)))))))),
"test:event_not_oti holds in the composed metamodel that an event is no object type instance: an instance has a state machine, and an event has no state; it powers the machine's transitions. Event's one supertype is Function and Fact's is Event, so neither is an Object Type Instance.",
DEF("test:event_not_oti",
    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:supers_in_mi"), S3(A("CONS"), K(A("Event")), A("rmap:mi"))), K(S1(A("Function"))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:supers_in_mi"), S3(A("CONS"), K(A("Fact")), A("rmap:mi"))), K(S1(A("Event")))))))),
"<object type, the relational map's inputs> to the direct supertypes the map's subtype records give the object type. A record is <name, <subtype, ...>, <supertype, ...>, <is a subtyping, ...>>.",
DEF("test:supers_in_mi",
    S4(A("COMP"), A("theta:flatten"),
       S2(A("ALPHA"), S4(A("COND"),
          S3(A("COMP"), A("and"), S3(A("CONS"),
             S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), N(4), N(2)), K(A("T")))),
             S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), N(2), N(2)), N(1))))),
          S2(A("CONS"), S4(A("COMP"), N(1), N(3), N(2))),
          K(PHI()))),
       A("distl"))),
"test:view_reads holds the viewer to the database it reads (a viewer of the database: a row is an object, not an array, and every answer carries its HATEOAS links). The database has no file (the reader sqlite:scratch in place of sqlite:query): a table T keyed by id whose row r1 holds a = x and b = NULL, a table U whose row u1 holds tid = r1, and the store's place map for them -- role UHasT.2 is played by Thing and placed at U.tid, role THasA.1 by Thing at T.id, and r1 is a Thing. Each route answers a JSON object with its links: the root links every table; T links itself and the root, and its row links itself by its key; T/r1 links itself, T, and the one place r1 plays a role other than its own row, U.tid, as /U/tid/r1; that link lands on U's rows holding r1. NULL is left out of every row. A table the catalogue does not hold answers 404, so does a column the table does not have, and a POST 405 without a database, since a viewer writes nothing. A link escapes what would break a path: a b#c reads a%20b%23c.",
DEF("test:view_script", K(A("create table T (id text primary key, a text, b text); insert into T values ('r1', 'x', null); create table U (uid text primary key, tid text); insert into U values ('u1', 'r1'); create table _rplan_src (name text, i integer, tab text, col text, layout integer); insert into _rplan_src values ('UHasT', 2, 'U', 'tid', 0), ('THasA', 1, 'T', 'id', 0); create table Function (functionId text primary key, roleFactTypeId text, roleObjectTypeId text); insert into Function values ('UHasT.2', 'UHasT', 'Thing'), ('THasA.1', 'THasA', 'Thing'); create table ObjectTypeInstanceIsInstanceOfObjectType (objectTypeInstanceId text, objectTypeId text); insert into ObjectTypeInstanceIsInstanceOfObjectType values ('r1', 'Thing');"))),
DEF("test:view_src", S5(A("CONS"), K(A("sqlite:scratch")), A("test:view_script"), K(A("http://v")), K(N(0)))),
"test:view_depth holds a read with depth (a listing shows each row with what it contains, to a depth). A child of e, by AREST.tex cor:hier, is a row whose own key plays one role of a fact type whose other role, played by one of e's types, is a column of that row: the map's foreign key. Here UHasT puts U's key at U.uid and T at U.tid, so u1 is a child of r1. With depth 1, T's row r1 embeds UHasT: u1 under _embedded, and u1, at depth 0, embeds nothing; with depth 0 no row embeds. ?depth=N reads N, at most 3, and anything else reads 0.",
DEF("test:view_dscript", K(A("create table T (id text primary key, a text); insert into T values ('r1', 'x'); create table U (uid text primary key, tid text, note text); insert into U values ('u1', 'r1', 'hi'); create table _rplan_src (name text, i integer, tab text, col text, layout integer); insert into _rplan_src values ('UHasT', 1, 'U', 'uid', 0), ('UHasT', 2, 'U', 'tid', 0); create table Function (functionId text primary key, roleFactTypeId text, roleObjectTypeId text); insert into Function values ('UHasT.1', 'UHasT', 'Child'), ('UHasT.2', 'UHasT', 'Thing'); create table ObjectTypeInstanceIsInstanceOfObjectType (objectTypeInstanceId text, objectTypeId text); insert into ObjectTypeInstanceIsInstanceOfObjectType values ('r1', 'Thing'), ('u1', 'Child');"))),
DEF("test:view_depth",
    S3(A("COMP"), A("fp:and_all"),
       S7(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), S5(A("CONS"), K(A("sqlite:scratch")), A("test:view_dscript"), K(A("http://v")), K(N(1))), K(S1(A("T"))))), K(S2(A("{\"table\":\"T\",\"_links\":{\"self\":\"http://v/T\",\"up\":\"http://v/\"},\"rows\":[{\"id\":\"r1\",\"a\":\"x\",\"_links\":{\"self\":\"http://v/T/r1\"},\"_embedded\":{\"UHasT\":[{\"uid\":\"u1\",\"tid\":\"r1\",\"note\":\"hi\",\"_links\":{\"self\":\"http://v/U/u1\"}}]}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:get"), S3(A("CONS"), S5(A("CONS"), K(A("sqlite:scratch")), A("test:view_dscript"), K(A("http://v")), K(N(0))), K(S1(A("T"))))), K(S2(A("{\"table\":\"T\",\"_links\":{\"self\":\"http://v/T\",\"up\":\"http://v/\"},\"rows\":[{\"id\":\"r1\",\"a\":\"x\",\"_links\":{\"self\":\"http://v/T/r1\"}}]}"), N(200))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:depth"), K(A("?depth=2"))), K(N(2)))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:depth"), K(A(""))), K(N(0)))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:depth"), K(A("?depth=9"))), K(N(3)))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("view:depth"), K(A("?depth=x"))), K(N(0))))))),
"test:view_filters holds a filter by a fact type (a path narrows a table to the rows that play a fact type). A path <table>/<fact type>/<value> answers the rows of the table whose key plays the fact type's first role where its second role is the value, both places read off the store's place map: here THasB's first role is T.id and its second T.b, so T/THasB/y answers r2 alone, and its links name the filter. A name that is neither a column of the table nor a placed fact type answers 404.",
DEF("test:view_fscript", K(A("create table T (id text primary key, a text, b text); insert into T values ('r1', 'x', null), ('r2', 'x', 'y'); create table _rplan_src (name text, i integer, tab text, col text, layout integer); insert into _rplan_src values ('THasB', 1, 'T', 'id', 0), ('THasB', 2, 'T', 'b', 0); create table Function (functionId text primary key, roleFactTypeId text, roleObjectTypeId text); create table ObjectTypeInstanceIsInstanceOfObjectType (objectTypeInstanceId text, objectTypeId text);"))),
DEF("test:view_fsrc", S5(A("CONS"), K(A("sqlite:scratch")), A("test:view_fscript"), K(A("http://v")), K(N(0)))),
