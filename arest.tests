       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("derive:desc_named"), S3(A("CONS"), K(A("EHasF")), A("id"))), S3(A("COMP"), A("theta:find_desc"), S3(A("CONS"), K(A("EHasF")), A("store:fts")))))),
       A("test:dn_store"))),
