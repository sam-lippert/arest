       S3(A("COMP"), A("test:js_case"), S4(A("CONS"), N(2), K(S1(A("CrateIsShipped"))), K(PHI()))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:cvd_judge"), S5(A("CONS"), K(A("T")), N(4), K(S1(A("CrateIsShipped"))), K(PHI()))), K(A("F")))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:cvd_judge"), S5(A("CONS"), K(A("T")), N(4), K(S1(A("CrateIsFlagged"))), K(PHI()))), K(A("T")))),
