          S4(A("CONS"), N(1), N(2), S3(A("COMP"), A("test:sp_ev"), S3(A("CONS"), N(2), K(A("UserRequestsRevisionOfDomainChange"))))),
          S3(A("COMP"), S3(A("CONS"), A("id"), S3(A("COMP"), A("test:sp_ev"), S3(A("CONS"), A("id"), K(A("UserSubmitsDomainChangeForReview"))))), A("test:sp_a1"))))),
