"), S2(A("X"), A("Y")), S3(A("join"), A("P"), A("Q"))), S3(A("R2"), S1(A("Y")), S4(A("sel"), A("P"), N(1), A("v"))))))))))), S4(A("COMP"), A("null"), A("derive:sm_marks"), K(S1(S3(A("CELL"), A("state:other"), A("x"))))), S4(A("COMP"), A("null"), A("rules:model"), K(S1(S3(A("CELL"), A("state:other"), A("x"))))), S4(A("COMP"), A("null"), A("theta:unfold_heads"), K(S1(PHI())))))),
