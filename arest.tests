       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("schema:ddl"), A("test:dv_store")), K(A("CREATE TABLE IF NOT EXISTS \"Club\" (\n    \"clubId\" TEXT,\n    PRIMARY KEY (\"clubId\")\n);\n\nCREATE TABLE IF NOT EXISTS \"ClubHoldsVenue\" (\n    \"clubId\" TEXT,\n    \"venueId\" TEXT,\n    PRIMARY KEY (\"clubId\", \"venueId\")\n);\n\nCREATE TABLE IF NOT EXISTS \"Member\" (\n    \"memberId\" TEXT,\n    PRIMARY KEY (\"memberId\")\n);\n\nCREATE TABLE IF NOT EXISTS \"MemberJoinsClub\" (\n    \"clubId\" TEXT,\n    \"memberId\" TEXT,\n    PRIMARY KEY (\"memberId\", \"clubId\")\n);\n\nCREATE TABLE IF NOT EXISTS \"Venue\" (\n    \"venueId\" TEXT,\n    PRIMARY KEY (\"venueId\")\n);\n\nDROP VIEW IF EXISTS \"MemberAttendsVenue\";\nCREATE VIEW \"MemberAttendsVenue\" (\"memberId\", \"venueId\") AS SELECT DISTINCT * FROM (SELECT * FROM (SELECT g.c1 AS c1, h.c2 AS c2 FROM (SELECT \"memberId\" AS c1, \"clubId\" AS c2 FROM \"MemberJoinsClub\" WHERE \"memberId\" IS NOT NULL AND \"clubId\" IS NOT NULL) AS g JOIN (SELECT \"clubId\" AS c1, \"venueId\" AS c2 FROM \"ClubHoldsVenue\" WHERE \"clubId\" IS NOT NULL AND \"venueId\" IS NOT NULL) AS h ON g.c2 = h.c1));"))))))),
