    S4(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("main:cf_w2"), K(S5(S1(S3(A("CELL"), A("state:taken"), S1(S2(A("F"), S1(S2(A("a"), A("1"))))))), A("F"), S1(S2(A("b"), A("2"))), S2(S2(A("b"), A("2")), S2(A("c"), A("3"))), PHI()))),
          K(S2(S1(S3(A("CELL"), A("state:taken"), S1(S2(A("F"), S2(S2(A("a"), A("1")), S2(A("c"), A("3"))))))), S2(A("F"), PHI()))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("main:cf_w2"), K(S5(S1(S3(A("CELL"), A("state:taken"), S1(S2(A("F"), S1(S2(A("a"), A("1"))))))), A("F"), S2(S2(A("a"), A("1")), S2(A("d"), A("4"))), S2(S2(A("b"), A("2")), S2(A("d"), A("4"))), S1(S2(A("d"), A("4")))))),
          K(S2(S1(S3(A("CELL"), A("state:taken"), S1(S2(A("F"), S1(S2(A("b"), A("2"))))))), S2(A("F"), S2(S2(A("a"), A("1")), S2(A("d"), A("4"))))))))),
       K(PHI()))),
"test:rt_dropped holds compile:ip_rt_part and compile:ip_drop_line to what an in-place compile does with a runtime fact of a fact type the readings no longer declare, or declare fully derived with no rule: over four facts, of F, which the new readings declare, of G, which they do not and the last store marked derived, of H, which they do not and the last store did not derive, and of K, which they declare fully derived and no rule derives, F`s and H`s are kept, for the migration and then compile:ip_p3h to take, and G`s and K`s are dropped, and the compile`s answer says it with the fact types` names.",
