    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), A("reify:event_types")), S3(A("COMP"), A("length"), A("reify:entries")))), S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), K(N(2)))), S3(A("COMP"), A("atom"), N(2))))), A("reify:event_types"))))), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), A("reify:timestamps")), S3(A("COMP"), A("length"), A("reify:entries")))), S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), K(N(2)))), S3(A("COMP"), A("atom"), N(2))))), A("reify:timestamps"))))), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), A("reify:references")), S3(A("COMP"), A("length"), A("reify:entries")))), S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), K(N(2)))), S3(A("COMP"), A("atom"), N(2))))), A("reify:references")))))))),

"THE WRITE GATE IS ONE GATE FOR THREE VERBS, and two of them had their own. Theorem 1 conditions the successor on the ALETHIC half of V alone, and every write path must read it that way: a retraction or replacement that tested the WHOLE of V would let a single deontic violation at rest refuse every DELETE and every PUT on that store. This law drives them over a store whose only violation is deontic -- two Things, one Label between them, a deontic mandatory on the role that carries it -- and asserts what Theorem 1 asserts: the retraction commits (200, not 409) and the row leaves the population; make that same role ALETHICALLY mandatory and the same retraction is refused, answering the store it was given. Four milliseconds, so the report can afford it.",
DEF("test:write_gate",
    S3(A("COMP"), A("fp:and_all"),
       S4(A("CONS"),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S4(A("COMP"), N(2), A("main:retract_step"),
                   K(S3(S5(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))),
                           S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))),
                           S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S2(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")))),
                           S3(A("CELL"), A("state:declared"), S1(S1(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label")))))),
                           S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:m:ThingHasLabel#1"), A("mandatory"), S1(S2(A("ThingHasLabel"), N(1)))))))),
                        A("ThingHasLabel"), S2(A("t1"), A("alpha"))))),
                K(N(200)))),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S3(A("COMP"), A("system:pop_rows"),
                   S3(A("CONS"), K(A("ThingHasLabel")),
                      S4(A("COMP"), N(3), A("main:retract_step"),
                         K(S3(S5(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))),
                                 S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))),
                                 S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S2(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")))),
                                 S3(A("CELL"), A("state:declared"), S1(S1(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label")))))),
                                 S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:m:ThingHasLabel#1"), A("mandatory"), S1(S2(A("ThingHasLabel"), N(1)))))))),
                              A("ThingHasLabel"), S2(A("t1"), A("alpha"))))))),
                K(PHI()))),
          S3(A("COMP"), A("eq"),
             S3(A("CONS"),
                S4(A("COMP"), N(2), A("main:retract_step"),
                   K(S3(S5(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))),
                           S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), S1(N(1)), S1(S2(A("t1"), A("alpha"))))))),
                           S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S2(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")))),
                           S3(A("CELL"), A("state:declared"), S1(S1(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label")))))),
                           S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:m:ThingHasLabel#1"), A("mandatory"), S1(S2(A("ThingHasLabel"), N(1)))))))),
                        A("ThingHasLabel"), S2(A("t1"), A("alpha"))))),
                K(N(409))))))),

"A WRITE IS REFUSED FOR WHAT IT BREAKS, NOT FOR WHAT IT FOUND. A retract fails if it breaks an alethic constraint, and answers the constraint as the error. Over a store that is not clean main:w2_viols compares the whole of V, and a gate that refused on any alethic violation the closed trial had would leave a store holding one, such as a classification row no reading supports, never repairable through SYSTEM. An answer carrying the whole population of the fact type the retract named runs to 4.8 million characters for ObjectTypeInstanceIsInstanceOfObjectType, and the router clips away the outcome and the violations with it. This store has two standing uniqueness violations, a label and a color each held by two things: the retract that repairs the label commits, answers the fact it took and no violation, and leaves the color violation standing; the retract that takes the only color of t3 breaks a mandatory constraint and is refused.",
DEF("test:dirty_gate",
    S4(A("COMP"), A("fp:and_all"), S5(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), A("main:retract_step")), K(N(201)))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("ThingHasLabel")), S3(A("COMP"), N(3), A("main:retract_step")))), K(S1(S2(A("t1"), A("alpha")))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), A("main:retract_step")), S3(A("COMP"), A("render:json"), K(S4(A("committed"), S1(S2(A("ThingHasLabel"), S2(A("t2"), A("alpha")))), PHI(), PHI()))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(2), A("main:retract_step"), S4(A("CONS"), N(1), K(A("ThingHasColor")), K(S2(A("t3"), A("blue"))))), K(N(409))))), K(S3(S4(S3(A("CELL"), A("FILE"), S2(S3(A("CELL"), A("ThingHasLabel"), S2(S3(A("CELL"), A("t1"), S1(A("alpha"))), S3(A("CELL"), A("t2"), S1(A("alpha"))))), S3(A("CELL"), A("ThingHasColor"), S3(S3(A("CELL"), A("t1"), S1(A("red"))), S3(A("CELL"), A("t2"), S1(A("red"))), S3(A("CELL"), A("t3"), S1(A("blue"))))))), S3(A("CELL"), A("state:fts"), S1(S2(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(2))), PHI(), S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("alpha")))), S5(A("ThingHasColor"), S2(A("Thing"), A("Color")), S1(S1(N(2))), S1(N(1)), S3(S2(A("t1"), A("red")), S2(A("t2"), A("red")), S2(A("t3"), A("blue"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")), S2(A("t3"), A("Thing")))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label"))), S2(A("ThingHasColor"), S2(A("Thing"), A("Color"))))))), A("ThingHasLabel"), S2(A("t2"), A("alpha")))))),
"The fixture of test:w2_fx with an alethic violation standing in it (test:w2_fx_bad: the Function w2-blocked-0 tagged b, committed without its gate, so its derived W2Blocked is outside W2Allowed), carrying state:alethic_clean F as a store whose verdict was recorded dirty does.",
DEF("test:as_dirty_fx",
    S3(A("COMP"), A("main:w2_flag"), S3(A("CONS"), S3(A("COMP"), A("test:w2_fx_bad"), A("test:w2_fx")), K(A("F"))))),
"<store, facts> to the answer of main:as for an assert of the facts by the empty caller, which the store designates no authorization for.",
DEF("test:as_dirty_as",
    S3(A("COMP"), A("main:as"), S4(A("CONS"), N(1), K(A("")), S3(A("CONS"), K(A("assert")), N(2))))),
"AN ASSERT IS REFUSED FOR WHAT IT BREAKS, NOT FOR WHAT IT FOUND. A write fails only if it breaks an alethic constraint. The fact POST, PUT and DELETE refuse only the alethic violations a write adds, and so does assert, through which the host records the Response of every sync (main:as): refusing on any alethic violation of the closed trial over a store not known clean would refuse the Response record a sync asserts on a store like support, with 104 standing mandatory violations from a readings gap, listing only the violations that stood before it. Over test:as_dirty_fx, whose one alethic violation is the W2Blocked of w2-blocked-0 and whose state:alethic_clean is F: an assert of an unrelated fact, as-ok tagged c, commits through main:as, its row lands, and the store it commits keeps state:alethic_clean F, since the standing violation remains; an assert of as-blocked tagged b, whose derived W2Blocked breaks the subset, is refused, and its answer names that one violation and not the standing one.",
DEF("test:assert_dirty_gate",
    S4(A("COMP"),
       S3(A("COMP"), A("fp:and_all"), S7(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), A("main:alethic_of"), A("ui:violations"), N(1)), K(S1(S3(A("W2Blocked"), A("subset"), S1(A("w2-blocked-0"))))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(2)), K(A("T")))),
          S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("as-ok"), A("c"))), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("W2Tag")), S3(A("COMP"), N(3), N(2)))))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("solve:cell"), S3(A("CONS"), K(A("state:alethic_clean")), S3(A("COMP"), N(3), N(2)))), K(A("F")))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(2), N(3)), K(A("F")))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), N(3)), S3(A("COMP"), A("render:json"), K(S4(A("refused"), S2(A("new"), N(1)), S2(A("held"), N(0)), S2(A("violations"), S1(S3(A("W2Blocked"), A("subset"), S1(A("as-blocked")))))))))))),
       S4(A("CONS"), A("id"),
          S3(A("COMP"), A("test:as_dirty_as"), S3(A("CONS"), A("id"), K(S1(S3(A("W2Tag"), A("as-ok"), A("c")))))),
          S3(A("COMP"), A("test:as_dirty_as"), S3(A("CONS"), A("id"), K(S1(S3(A("W2Tag"), A("as-blocked"), A("b"))))))),
       A("test:as_dirty_fx"))),
"AND AN ASSERT THAT REPAIRS THE STORE SAYS SO. main:w2b_gate commits a store carrying state:alethic_clean T when the closed store has no alethic violation at all, and F otherwise; an assert kept the cell of the store before it, so a store once dirty stayed F after the write that repaired it, and every assert after took the whole check. Over test:as_dirty_fx, an assert of W2Allowed w2-blocked-0, the superset fact the standing W2Blocked lacks, commits through main:as, and the store it commits carries state:alethic_clean T.",
DEF("test:assert_dirty_repair",
    S4(A("COMP"),
       S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), N(2), K(A("T")))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("solve:cell"), S3(A("CONS"), K(A("state:alethic_clean")), N(3))), K(A("T")))))),
       A("test:as_dirty_as"),
       S3(A("CONS"), A("test:as_dirty_fx"), K(S1(S2(A("W2Allowed"), A("w2-blocked-0"))))))),

"THE VALIDATE GATE OVER A STORE WITH ITS PROJECTION. The hand-built store carries t1's label in the descriptor's fifth slot, the source, and in FILE, the projection the host builds at boot -- the shape every booted store has, and the shape the write path (resolve reads FILE) needs. A submit that gives t2 two labels is refused and answers the store it was given; a submit that gives t2 one label answers <Thing, t2>, and what it wrote is read back through the accessor -- system:pop_rows for the rows, ui:ids for the instances, file-is-projection for the two homes agreeing -- rather than compared as a store literal, because the projection's byte layout is FILE's business and the law's is what was stored.",
DEF("test:validate_gate",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("ui:create"), K(S2(S3(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))), S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S1(S2(A("t1"), A("Thing"))))), S7(A("submit"), A("Thing"), A("t2"), A("ThingHasLabel"), A("x"), A("ThingHasLabel"), A("y"))))), K(S2(S7(A("violations"), A("Thing"), A("t2"), A("ThingHasLabel"), A("x"), A("ThingHasLabel"), A("y")), S3(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))), S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S1(S2(A("t1"), A("Thing"))))))))),
       S3(A("COMP"), S3(A("COMP"), A("fp:and_all"), S5(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(S2(A("Thing"), A("t2"))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("ThingHasLabel")), N(2))), K(S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("beta")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("ui:ids"), S3(A("CONS"), N(2), K(A("Thing")))), K(S2(A("t1"), A("t2"))))), S3(A("COMP"), A("test:file_is_projection"), N(2)))), S3(A("COMP"), A("ui:create"), K(S2(S3(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))), S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S1(S2(A("t1"), A("Thing"))))), S5(A("submit"), A("Thing"), A("t2"), A("ThingHasLabel"), A("beta")))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("ui:violations"), K(S3(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("ThingHasLabel"), S1(S3(A("CELL"), A("t1"), S1(A("alpha"))))))), S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("alpha"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S1(S2(A("t1"), A("Thing"))))))), K(PHI())))))),

"A SUBSET LEG CARRIED AS A RECIPE FIRES ON THE VIOLATING SUBJECT AND ON NOTHING ELSE. A byte-identical gate cannot see an inert arm: the recipe branch of cmd:sc_leg reaches no store until the oracle emits recipe legs, so this fixture drives it. Two things are labeled, t1 and t2; only t1 has the flag x. The constraint is the subset every-labeled-thing within things-flagged-x, the antecedent leg proj(ThingHasLabel, <1>) and the consequent leg proj(sel(ThingHasFlag, 2, x), <1>) -- the value restriction carried as sel, which the step triples could never say and which, dropped, would have read every flag as x. cmd:sub_viols must answer exactly one row, <ThingHasLabel, subset, <t2>>: t2 is the violation and t1, present in both legs, is not -- one fixture asserting both that the constraint fires and that it stays quiet.",
DEF("test:subset_recipe_leg",
    S3(A("COMP"), A("eq"),
       S3(A("CONS"),
