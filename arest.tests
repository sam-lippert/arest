    K(S(S4(A("Name is a value type.\nTag is a value type.\nCrate(.Name) is an entity type.\nCrate has Tag.\n  Each Crate has at most one Tag.\n  For each Tag, at most one Crate has that Tag.\n"), S1(S2(A("CrateHasTag"), S2(S2(A("c1"), A("t")), S2(A("c2"), A("t"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("V")),
        S4(A("Name is a value type.\nTag is a value type.\nCrate(.Name) is an entity type.\nCrate has Tag.\n  Each Crate has at most one Tag.\n  For each Tag, at most one Crate has that Tag.\n"), S1(S2(A("CrateHasTag"), S2(S2(A("c1"), A("t1")), S2(A("c2"), A("t2"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("C")),
        S4(A("Name is a value type.\nWeight is a value type.\nTag is a value type.\nCrate(.Name) is an entity type.\nCrate has Weight.\n  Each Crate has at most one Weight.\n  Each Crate has some Weight.\nCrate has Tag.\n  Each Crate has at most one Tag.\n"), S2(S2(A("CrateHasWeight"), S1(S2(A("c1"), A("w")))), S2(A("CrateHasTag"), S1(S2(A("c2"), A("t"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("V")),
        S4(A("Name is a value type.\nWeight is a value type.\nTag is a value type.\nCrate(.Name) is an entity type.\nCrate has Weight.\n  Each Crate has at most one Weight.\n  Each Crate has some Weight.\nCrate has Tag.\n  Each Crate has at most one Tag.\n"), S2(S2(A("CrateHasWeight"), S2(S2(A("c1"), A("w")), S2(A("c2"), A("w")))), S2(A("CrateHasTag"), S1(S2(A("c2"), A("t"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("C")),
        S4(A("Name is a value type.\nCrate(.Name) is an entity type.\nCrate is shipped.\nCrate is checked.\nIf some Crate is shipped then that Crate is checked.\n"), S2(S2(A("CrateIsShipped"), S1(S1(A("c2")))), S2(A("CrateIsChecked"), S1(S1(A("c1"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("V")),
        S4(A("Name is a value type.\nCrate(.Name) is an entity type.\nCrate is shipped.\nCrate is checked.\nIf some Crate is shipped then that Crate is checked.\n"), S2(S2(A("CrateIsShipped"), S1(S1(A("c2")))), S2(A("CrateIsChecked"), S2(S1(A("c1")), S1(A("c2"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("C")),
        S4(A("Name is a value type.\nWeight is a value type.\nCrate(.Name) is an entity type.\nCrate has Weight.\n  It is obligatory that each Crate has some Weight.\n  It is obligatory that each Crate has at most one Weight.\nCrate is shipped.\nCrate is checked.\nIt is obligatory that if some Crate is shipped then that Crate is checked.\n"), S2(S2(A("CrateHasWeight"), S2(S2(A("c1"), A("heavy")), S2(A("c1"), A("light")))), S2(A("CrateIsShipped"), S1(S1(A("c2"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("V")),
        S4(A("Name is a value type.\nWeight is a value type.\nCrate(.Name) is an entity type.\nCrate has Weight.\n  It is obligatory that each Crate has some Weight.\n  It is obligatory that each Crate has at most one Weight.\nCrate is shipped.\nCrate is checked.\nIt is obligatory that if some Crate is shipped then that Crate is checked.\n"), S3(S2(A("CrateHasWeight"), S2(S2(A("c1"), A("heavy")), S2(A("c2"), A("light")))), S2(A("CrateIsShipped"), S1(S1(A("c2")))), S2(A("CrateIsChecked"), S1(S1(A("c2"))))), S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate"))), A("C"))))),
