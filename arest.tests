       S3(A("COMP"), A("theta:subset"), S3(A("CONS"), K(S2(A("columnId"), A("roleId"))), S3(A("COMP"), A("rmap:proj_colnames"), S3(A("CONS"), K(A("ColumnIsForRole")), A("id"))))),
