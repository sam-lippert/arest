       S2(A("TableHasName"), S3(S2(A("schema:CrateIsInspectedOnDate"), A("CrateIsInspectedOnDate")), S2(A("schema:Crate"), A("Crate")), S2(A("schema:Item"), A("Item")))),
       S2(A("TableIsPrimarilyForObjectType"), S3(S2(A("schema:CrateIsInspectedOnDate"), A("CrateIsInspectedOnDate")), S2(A("schema:Crate"), A("Crate")), S2(A("schema:Item"), A("Item")))),
       S2(A("TableIsPrimarilyForFactType"), S1(S2(A("schema:CrateIsInspectedOnDate"), A("CrateIsInspectedOnDate")))),
       S2(A("TableIsAView"), PHI()),
       S2(A("ColumnBelongsToTable"), S(S2(A("schema:CrateIsInspectedOnDate:date"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:CrateIsInspectedOnDate:crate"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:Crate:shelf"), A("schema:Crate")), S2(A("schema:Crate:slot"), A("schema:Crate")), S2(A("schema:Crate:crate"), A("schema:Crate")), S2(A("schema:Crate:weight"), A("schema:Crate")), S2(A("schema:Item:code"), A("schema:Item")), S2(A("schema:Item:crate"), A("schema:Item")), S2(A("schema:Item:shelf"), A("schema:Item")), S2(A("schema:Item:slot"), A("schema:Item")))),
       S2(A("ColumnHasName"), S(S2(A("schema:CrateIsInspectedOnDate:date"), A("date")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("shelf")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("slot")), S2(A("schema:CrateIsInspectedOnDate:crate"), A("crate")), S2(A("schema:Crate:shelf"), A("shelf")), S2(A("schema:Crate:slot"), A("slot")), S2(A("schema:Crate:crate"), A("crate")), S2(A("schema:Crate:weight"), A("weight")), S2(A("schema:Item:code"), A("code")), S2(A("schema:Item:crate"), A("crate")), S2(A("schema:Item:shelf"), A("shelf")), S2(A("schema:Item:slot"), A("slot")))),
       S2(A("ColumnHasPosition"), S(S2(A("schema:CrateIsInspectedOnDate:date"), A("1")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("2")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("3")), S2(A("schema:CrateIsInspectedOnDate:crate"), A("4")), S2(A("schema:Crate:shelf"), A("1")), S2(A("schema:Crate:slot"), A("2")), S2(A("schema:Crate:crate"), A("3")), S2(A("schema:Crate:weight"), A("4")), S2(A("schema:Item:code"), A("1")), S2(A("schema:Item:crate"), A("2")), S2(A("schema:Item:shelf"), A("3")), S2(A("schema:Item:slot"), A("4")))),
       S2(A("ColumnHasConceptualDataType"), PHI()),
       S2(A("ColumnIsNullable"), S1(S1(A("schema:Crate:weight")))),
       S2(A("ColumnIsForRole"), S(S2(A("schema:CrateIsInspectedOnDate:date"), A("CrateIsInspectedOnDate.2")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("CrateIsInspectedOnDate.1")), S2(A("schema:CrateIsInspectedOnDate:shelf"), A("CrateBelongsToShelf.2")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("CrateIsInspectedOnDate.1")), S2(A("schema:CrateIsInspectedOnDate:slot"), A("CrateHasSlot.2")), S2(A("schema:CrateIsInspectedOnDate:crate"), A("CrateIsInspectedOnDate.1")), S2(A("schema:Crate:shelf"), A("CrateBelongsToShelf.2")), S2(A("schema:Crate:slot"), A("CrateHasSlot.2")), S2(A("schema:Crate:weight"), A("CrateHasWeight.2")), S2(A("schema:Item:code"), A("ItemHasCode.2")), S2(A("schema:Item:crate"), A("ItemIsPackedInCrate.2")), S2(A("schema:Item:shelf"), A("ItemIsPackedInCrate.2")), S2(A("schema:Item:shelf"), A("CrateBelongsToShelf.2")), S2(A("schema:Item:slot"), A("ItemIsPackedInCrate.2")), S2(A("schema:Item:slot"), A("CrateHasSlot.2")), S2(A("schema:Crate:crate"), A("CrateBelongsToShelf.1")), S2(A("schema:Crate:crate"), A("CrateHasSlot.1")))),
       S2(A("TableKeyBelongsToTable"), S3(S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:Crate:Crate_PK"), A("schema:Crate")), S2(A("schema:Item:Item_PK"), A("schema:Item")))),
       S2(A("TableKeySpansColumn"), S6(S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK"), A("schema:CrateIsInspectedOnDate:shelf")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK"), A("schema:CrateIsInspectedOnDate:slot")), S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK"), A("schema:CrateIsInspectedOnDate:date")), S2(A("schema:Crate:Crate_PK"), A("schema:Crate:shelf")), S2(A("schema:Crate:Crate_PK"), A("schema:Crate:slot")), S2(A("schema:Item:Item_PK"), A("schema:Item:code")))),
       S2(A("TableHasPrimaryTableKey"), S3(S2(A("schema:CrateIsInspectedOnDate"), A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_PK")), S2(A("schema:Crate"), A("schema:Crate:Crate_PK")), S2(A("schema:Item"), A("schema:Item:Item_PK")))),
       S2(A("TableReferenceIsFromTable"), S2(S2(A("schema:CrateIsInspectedOnDate:CrateIsInspectedOnDate_FK"), A("schema:CrateIsInspectedOnDate")), S2(A("schema:Item:Item_FK"), A("schema:Item")))),
