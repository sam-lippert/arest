       S3(A("COMP"), N(1), S3(A("CONS"), A("id"), S3(A("COMP"), A("sqlite:put_sp"), S6(A("CONS"), A("id"), K(A("t")), K(S3(A("a"), A("c"), A("d"))),
          K(S4(S2(S2(N(1), A("x1")), S2(N(3), A("z1"))), S3(S2(N(4), A("w2")), S2(N(2), A("dropped")), S2(N(1), A("x2"))), PHI(), S2(S2(N(5), A("past")), S2(N(3), A("z4"))))),
          K(S3(N(1), N(3), N(4))))))),
       S4(A("COMP"), N(1), S3(A("CONS"), A("id"), S3(A("COMP"), A("sqlite:exec"), S3(A("CONS"), A("id"), K(A("create table \"t\" (\"a\", \"b\", \"c\", \"d\")"))))), S3(A("COMP"), A("storage:fresh"), A("test:psp_db"))))),
"<database, rows> to T when the rows are the four the put stands for.",
