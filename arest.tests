       S2(S2(A("CrateHasTag"), S1(S2(A("c1"), A("t")))), S2(A("BoxHasWeight"), S1(S2(A("b1"), A("w"))))),
       S2(S2(A("c1"), A("Crate")), S2(A("b1"), A("Box"))), A("C"))))),
