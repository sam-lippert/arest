          K(S2(A("state:derived"), S2(S2(A("LawDrdHas"), A("derived-and-stored")), S2(A("LawDrdUnder"), A("derived-and-stored"))))))),
       K(S2(A("state:rules"), S2(
          S3(A("LawDrdHas"), S1(A("Function")), S3(A("proj"), A("LawDrdIn"), S1(N(1)))),
          S3(A("LawDrdUnder"), S2(A("Function"), A("Description")), S3(A("proj"), S4(A("join"), A("LawDrdIn"), A("LawDrdSub"), S3(N(1), N(2), N(3))), S2(N(1), N(3)))))))))),
"<store>: the store with law-drd-f1 and law-drd-f2 Functions, as a create files them, as test:sdr_reg files its own.",
