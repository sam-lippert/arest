    S4(A("COND"),
       S3(A("COMP"), A("null"),
          S3(A("COMP"), A("ui:ids"),
             S3(A("CONS"), N(2), S3(A("COMP"), N(1), N(1))))),
       S3(A("COMP"), A("not"),
          S3(A("COMP"), A("atom"),
             S3(A("COMP"), A("main:links_of"),
                S3(A("CONS"), N(2), S3(A("COMP"), N(1), N(1)))))),
       S3(A("COMP"), A("not"),
          S3(A("COMP"), A("null"),
             S3(A("COMP"), A("main:links_of"),
                S3(A("CONS"), N(2), S3(A("COMP"), N(1), N(1)))))))),
