    S4(A("COMP"), A("fp:and_all"), S8(A("CONS"), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("FactIsOfFunction")), A("id"))), K(S2(S2(A("fx"), A("fta")), S2(A("fz"), A("otherft")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("FactBelongsToDomain")), A("id"))), K(S2(S2(A("fx"), A("dom1")), S2(A("fz"), A("dom2")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("ObjectTypeInstanceIsOfFunction")), A("id"))), K(S2(S2(A("res1"), A("n1")), S2(A("n1"), A("Object Type")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("ObjectTypeInstanceBelongsToDomain")), A("id"))), K(S1(S2(A("res1"), A("dom2")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("ViolationBelongsToDomain")), A("id"))), K(S1(S2(A("v1"), A("dom1")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("FailureBelongsToDomain")), A("id"))), K(S1(S2(A("f1"), A("dom1")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("DomainReachesDomain")), A("id"))), K(S3(S2(A("dom2"), A("dom1")), S2(A("dom3"), A("dom2")), S2(A("dom3"), A("dom1"))))))), S3(A("COMP"), A("derive"), S3(A("CONS"), A("derive:all_rules"), S3(A("COMP"), A("theta:unfold_pairs"), K(S7(S2(A("FunctionBelongsToDomain"), S4(S2(A("fta"), A("dom1")), S2(A("ftb"), A("dom1")), S2(A("otherft"), A("dom2")), S2(A("n1"), A("dom2")))), S2(A("FactIsOfFactType"), S2(S2(A("fx"), A("fta")), S2(A("fz"), A("otherft")))), S2(A("ObjectTypeInstanceIsInstanceOfObjectType"), S2(S2(A("res1"), A("n1")), S2(A("n1"), A("Object Type")))), S2(A("ObjectTypeIsOfObjectKind"), S1(S2(A("n1"), A("entity")))), S2(A("ViolationIsAgainstFunction"), S1(S2(A("v1"), A("fta")))), S2(A("FailureIsAgainstFunction"), S1(S2(A("f1"), A("ftb")))), S2(A("DomainIsContainedInDomain"), S2(S2(A("dom1"), A("dom2")), S2(A("dom2"), A("dom3"))))))))))),

