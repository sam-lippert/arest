       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("read:name_sorted"), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("derive:on_read"), S3(A("CONS"), K(A("ObjectTypeIsIndependent")), A("id"))))), S3(A("COMP"), A("read:name_sorted"), A("rmap:otindep")))),
       S4(A("COMP"), A("not"), A("null"), A("rmap:otindep"))))),
"THE READER READS THE RINGS THE VERBALIZER SPEAKS (verbalization.md, the ring patterns, after Halpin and Curland, Automated Verbalization for ORM 2). test:ring_patterns reads one file with each ring said in its pattern`s positive form: No Domain reaches itself; No Domain may cycle back to itself via one or more traversals through Domain uses Domain; If Function1 is superseded by Function2 then it is impossible that Function2 is superseded by Function1; If Function1 is inverted by Function2 then Function2 is inverted by Function1. Its rings are irreflexive, acyclic, asymmetric and symmetric. Run first, only the irreflexive one read.",
DEF("test:ring_patterns",
    S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("system:cellrows"), S3(A("CONS"), K(A("state:rings")), S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("rings.md"), A("Domain is an entity type.\nFunction is an entity type.\nDomain reaches Domain.\n  Each Domain, Domain combination occurs at most once in the population of Domain reaches Domain.\nNo Domain reaches itself.\nDomain uses Domain.\n  Each Domain, Domain combination occurs at most once in the population of Domain uses Domain.\nNo Domain may cycle back to itself via one or more traversals through Domain uses Domain.\nFunction is superseded by Function.\n  Each Function, Function combination occurs at most once in the population of Function is superseded by Function.\nIf Function1 is superseded by Function2 then it is impossible that Function2 is superseded by Function1.\nFunction is inverted by Function.\n  Each Function is inverted by at most one Function.\nIf Function1 is inverted by Function2 then Function2 is inverted by Function1.\n"), A("rings/rings.md")))))))))), K(S4(S2(A("DomainReachesDomain"), A("Irreflexive")), S2(A("DomainUsesDomain"), A("Acyclic")), S2(A("FunctionIsSupersededByFunction"), A("Asymmetric")), S2(A("FunctionIsInvertedByFunction"), A("Symmetric"))))))),
"A DEONTIC OPERATOR MAY FOLLOW THE QUANTIFIER (verbalization.md, the deontic snippets in a for-each pattern). test:deontic_for_each reads `For each Timestamp, it is obligatory that at most one Migration Application has that Timestamp.`, as the verbalizer speaks it, to the deontic uniqueness core.md writes `It is obligatory that for each Timestamp, at most one ...`: DEO:u:MigrationApplicationHasTimestamp#2 over the second role. Run first, the sentence read to nothing.",
DEF("test:deontic_for_each",
    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("system:cellrows"), S3(A("CONS"), K(A("state:deontics")), S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("deo.md"), A("Migration Application is an entity type.\nTimestamp is a value type.\nMigration Application has Timestamp.\n  Each Migration Application has at most one Timestamp.\nFor each Timestamp, it is obligatory that at most one Migration Application has that Timestamp.\n"), A("deo/deo.md")))))))))), K(S1(S3(A("DEO:u:MigrationApplicationHasTimestamp#2"), A("uniqueness"), S1(S2(A("MigrationApplicationHasTimestamp"), N(2))))))))),
"A STRAY APOSTROPHE IS NO LITERAL. test:stray_quote compiles one file whose last sentence ends in an apostrophe after its period; the compile answers its cells, the file`s other sentence among them. Run first, read:is_lit took the apostrophe alone for a quoted value and the compile threw (tlr of <>).",
DEF("test:stray_quote",
    S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("Widget")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("system:cellrows"), S3(A("CONS"), K(A("state:otmeta")), S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("q.md"), A("Widget is an entity type.\nIt is forbidden that a constraint states only one form.'\n"), A("q/q.md"))))))))))))),
"THE READER READS THE NEGATIVE FORMS (verbalization.md, each pattern`s negative form). test:negative_forms reads a file whose constraints are said only negatively: It is impossible that the same Object Type is of more than one Object Kind; It is impossible that any Order is placed by no Customer; For each Customer, it is impossible that no Order is placed by that Customer; It is impossible that some Domain reaches itself; It is impossible that Domain1 reaches Domain2 and Domain2 reaches Domain1. They are the uniqueness on Object Type, the mandatories on Order and on Customer, and the irreflexive and asymmetric rings. Run first, none of them read.",
DEF("test:negative_forms_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("neg.md"), A("Object Type is an entity type.\nObject Kind is a value type.\nOrder is an entity type.\nCustomer is an entity type.\nDomain is an entity type.\nObject Type is of Object Kind.\nIt is impossible that the same Object Type is of more than one Object Kind.\nOrder is placed by Customer.\n  Each Order is placed by at most one Customer.\nIt is impossible that any Order is placed by no Customer.\nFor each Customer, it is impossible that no Order is placed by that Customer.\nDomain reaches Domain.\n  Each Domain, Domain combination occurs at most once in the population of Domain reaches Domain.\nIt is impossible that some Domain reaches itself.\nIt is impossible that Domain1 reaches Domain2 and Domain2 reaches Domain1.\n"), A("neg/neg.md"))))))))),
DEF("test:negative_forms",
    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("system:cellrows"), S3(A("CONS"), K(A("state:rings")), A("test:negative_forms_cells"))), K(S2(S2(A("DomainReachesDomain"), A("Irreflexive")), S2(A("DomainReachesDomain"), A("Asymmetric")))))),
       S4(A("COMP"), A("fp:and_all"), S2(A("ALPHA"), A("theta:member")), S3(A("COMP"), A("distr"), S3(A("CONS"), K(S3(A("UC:in:ObjectTypeIsOfObjectKind#1"), A("MC:e:OrderIsPlacedByCustomer#1"), A("MC:e:OrderIsPlacedByCustomer#2"))), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("reflect:con_raw"), A("test:negative_forms_cells"))))))))),
"THE READER READS A RANGE (Halpin and Curland, Automated Verbalization for ORM 2, value constraints with open and closed ranges). test:value_ranges reads three: The possible values of Height are [20..270]; of Temperature, at least -273.15 and below 0; of Score, the open range from 0 to 1. Each object type has its range VR: and its name, the bounds` lexical values are the numbers as written, and their clusivities are the brackets` and the words`: Height inclusive at both ends, Temperature inclusive below and exclusive above, Score exclusive at both. Run first, each sentence read to a values record with no value under no object type.",
"The n-1 and external uniqueness negatives read as their positive forms: the ternary carries the uniqueness over its first two roles and not the spanning one, and the external uniqueness spans the two fact types` Team and Code roles.",
DEF("test:uc_negatives_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("ucneg.md"), A("Student is an entity type.\nCourse is an entity type.\nGrade is a value type.\nStudent takes Course with Grade.\nIt is impossible that the same Student takes the same Course with more than one Grade.\nTeam is an entity type.\nCode is a value type.\nPlayer is an entity type.\nPlayer plays for Team.\n  Each Player plays for at most one Team.\nPlayer has Code.\n  Each Player has at most one Code.\nIt is impossible that more than one Player plays for the same Team and has the same Code.\n"), A("ucneg/ucneg.md"))))))))),
DEF("test:uc_negatives",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:n:StudentTakesCourseWithGrade#1+StudentTakesCourseWithGrade#2")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:uc_negatives_cells")))), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:en:PlayerPlaysForTeam#2+PlayerHasCode#2")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:uc_negatives_cells")))), S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:n:StudentTakesCourseWithGrade#1+StudentTakesCourseWithGrade#2+StudentTakesCourseWithGrade#3")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:uc_negatives_cells")))))))),
"A reading that holds at keeps it under a for-each uniqueness: the ternary`s n-1 uniqueness, a for-each uniqueness on a binary`s second role, and an external uniqueness with a leg that starts at that Time.",
DEF("test:at_reading_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("at.md"), A("Person is an entity type.\nLanguage is an entity type.\nLevel is a value type.\nPerson speaks Language at Level.\nFor each Person and Language, that Person speaks that Language at at most one Level.\nEvent is an entity type.\nTime is a value type.\nEvent occurs at Time.\n  Each Event occurs at at most one Time.\nFor each Time, at most one Event occurs at that Time.\nRoom is an entity type.\nMeeting is an entity type.\nMeeting is held in Room.\n  Each Meeting is held in at most one Room.\nMeeting starts at Time.\n  Each Meeting starts at at most one Time.\nFor each Room and Time, at most one Meeting is held in that Room and starts at that Time.\n"), A("at/at.md"))))))))),
DEF("test:at_reading",
    S3(A("COMP"), A("fp:and_all"), S5(A("CONS"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:n:PersonSpeaksLanguageAtLevel#1+PersonSpeaksLanguageAtLevel#2")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:at_reading_cells")))), S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:n:PersonSpeaksLanguageAtLevel#1+PersonSpeaksLanguageAtLevel#2+PersonSpeaksLanguageAtLevel#3")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:at_reading_cells"))))), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:in:EventOccursAtTime#2")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:at_reading_cells")))), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("UC:en:MeetingIsHeldInRoom#2+MeetingStartsAtTime#2")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:at_reading_cells"))))))),
"A deontic exclusion of subtypes reads as one: its supertype is Animal, its constraint is Deontic, and only the alethic group`s subtypes, Dog and Cat, are scopes the write path enforces.",
DEF("test:deontic_exclusion_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("gx.md"), A("Animal is an entity type.\nDog is an entity type.\nCat is an entity type.\nBird is an entity type.\nDog is a subtype of Animal.\nCat is a subtype of Animal.\nBird is a subtype of Animal.\nFor each Animal, at most one of the following holds: that Animal is a Dog; that Animal is a Cat.\nIt is obligatory that for each Animal, at most one of the following holds: that Animal is a Cat; that Animal is a Bird.\n"), A("gx/gx.md"))))))))),
DEF("test:deontic_exclusion",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("XC:DogIsASubtypeOfAnimal#2+CatIsASubtypeOfAnimal#2"), A("Alethic"))), S4(A("COMP"), S2(A("ALPHA"), S3(A("CONS"), N(1), N(3))), A("reflect:con_raw"), A("test:deontic_exclusion_cells")))), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("XC:CatIsASubtypeOfAnimal#2+BirdIsASubtypeOfAnimal#2"), A("Deontic"))), S4(A("COMP"), S2(A("ALPHA"), S3(A("CONS"), N(1), N(3))), A("reflect:con_raw"), A("test:deontic_exclusion_cells")))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("system:cellrows"), S3(A("CONS"), K(A("state:exclusions")), A("test:deontic_exclusion_cells"))), K(S2(S2(A("Dog"), S1(N(1))), S2(A("Cat"), S1(N(1)))))))))),
"A value comparison reads as a VC constraint over the two compared roles, its operator said by the type compared: is before for a Timestamp, is greater than for an Amount.",
DEF("test:value_comparison_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("vc.md"), A("Violation is an entity type.\nTransition is an entity type.\nTimestamp is a value type.\nViolation occurs before Transition.\nViolation occurred at Timestamp.\n  Each Violation occurred at at most one Timestamp.\nTransition occurred at Timestamp.\n  Each Transition occurred at at most one Timestamp.\nIf some Violation occurs before some Transition then that Violation occurred at some Timestamp and that Transition occurred at some Timestamp where that Violation Timestamp is before that Transition Timestamp.\nBid is an entity type.\nAsk is an entity type.\nAmount is a value type.\nBid beats Ask.\nBid offers Amount.\n  Each Bid offers at most one Amount.\nAsk asks Amount.\n  Each Ask asks at most one Amount.\nIf some Bid beats some Ask then that Bid offers some Amount and that Ask asks some Amount where that Bid Amount is greater than that Ask Amount.\n"), A("vc/vc.md"))))))))),
DEF("test:value_comparison_x",
    S5(A("COMP"), A("read:x_full"), A("read:x_of"), A("compile:text_rows"), K(S2(A("vc.md"), A("Violation is an entity type.\nTransition is an entity type.\nTimestamp is a value type.\nViolation occurs before Transition.\nViolation occurred at Timestamp.\n  Each Violation occurred at at most one Timestamp.\nTransition occurred at Timestamp.\n  Each Transition occurred at at most one Timestamp.\nIf some Violation occurs before some Transition then that Violation occurred at some Timestamp and that Transition occurred at some Timestamp where that Violation Timestamp is before that Transition Timestamp.\nBid is an entity type.\nAsk is an entity type.\nAmount is a value type.\nBid beats Ask.\nBid offers Amount.\n  Each Bid offers at most one Amount.\nAsk asks Amount.\n  Each Ask asks at most one Amount.\nIf some Bid beats some Ask then that Bid offers some Amount and that Ask asks some Amount where that Bid Amount is greater than that Ask Amount.\n"))))),
DEF("test:value_comparison",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S4(A("VC:ViolationOccurredAtTimestamp#2+TransitionOccurredAtTimestamp#2"), A("VC"), A("Alethic"), S2(S2(A("ViolationOccurredAtTimestamp"), N(2)), S2(A("TransitionOccurredAtTimestamp"), N(2))))), S3(A("COMP"), A("reflect:con_raw"), A("test:value_comparison_cells")))), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S4(A("VC:BidOffersAmount#2+AskAsksAmount#2"), A("VC"), A("Alethic"), S2(S2(A("BidOffersAmount"), N(2)), S2(A("AskAsksAmount"), N(2))))), S3(A("COMP"), A("reflect:con_raw"), A("test:value_comparison_cells")))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("read:refl_vc_ops"), A("test:value_comparison_x")), K(S2(S2(A("VC:ViolationOccurredAtTimestamp#2+TransitionOccurredAtTimestamp#2"), A("LessThan")), S2(A("VC:BidOffersAmount#2+AskAsksAmount#2"), A("GreaterThan"))))))))),
"A disjunctive mandatory whose subject leads and is elided reads as the explicit one over the roles it names: Each Table is primarily for some Object Type or is primarily for some Fact Type, beside a third role the table plays.",
DEF("test:dj_lead_cells",
    S3(A("COMP"), A("compile:filed"), S4(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), S3(A("COMP"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("dj.md"), A("Table is an entity type.\nObject Type is an entity type.\nFact Type is an entity type.\nTable is primarily for Object Type.\n  Each Table is primarily for at most one Object Type.\nTable is primarily for Fact Type.\n  Each Table is primarily for at most one Fact Type.\nEach Table is primarily for some Object Type or is primarily for some Fact Type.\nName is a value type.\nTable has Name.\n  Each Table has at most one Name.\n"), A("dj/dj.md"))))))))),
DEF("test:dj_lead",
    S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("DJ:e:TableIsPrimarilyForObjectType#1+TableIsPrimarilyForFactType#1")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("reflect:con_raw"), A("test:dj_lead_cells"))))),
DEF("test:value_ranges_x",
    S5(A("COMP"), A("read:x_full"), A("read:x_of"), A("compile:text_rows"), K(S2(A("ranges.md"), A("Height is a value type.\nThe possible values of Height are [20..270].\nTemperature is a value type.\nThe possible values of Temperature are at least -273.15 and below 0.\nScore is a value type.\nThe possible values of Score are (0..1).\n"))))),
DEF("test:value_ranges",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("read:refl_vr_has"), A("test:value_ranges_x")), K(S3(S2(A("Height"), A("VR:Height")), S2(A("Temperature"), A("VR:Temperature")), S2(A("Score"), A("VR:Score")))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("read:refl_vr_lex"), A("test:value_ranges_x")), K(S6(S2(A("VR:Height#lower"), A("20")), S2(A("VR:Height#upper"), A("270")), S2(A("VR:Temperature#lower"), A("-273.15")), S2(A("VR:Temperature#upper"), A("0")), S2(A("VR:Score#lower"), A("0")), S2(A("VR:Score#upper"), A("1")))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("read:refl_vr_clus"), A("test:value_ranges_x")), K(S6(S2(A("VR:Height#lower"), A("inclusive")), S2(A("VR:Height#upper"), A("inclusive")), S2(A("VR:Temperature#lower"), A("inclusive")), S2(A("VR:Temperature#upper"), A("exclusive")), S2(A("VR:Score#lower"), A("exclusive")), S2(A("VR:Score#upper"), A("exclusive")))))))))
)
