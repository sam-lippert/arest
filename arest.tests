       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), K(S2(S2(A("schema:Email:user"), A("UserHasEmail")), S2(A("schema:Polarity:polarity"), A("PolarityIsOppositeToPolarity")))), N(8)))),
