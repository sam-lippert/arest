        S3(A("CELL"), A("TransitionIsToStatus"), S2(S2(A("approve"), A("Sent")), S2(A("redraft"), A("Draft")))),
        S3(A("CELL"), A("TransitionIsTriggeredByEventType"), S2(S2(A("approve"), A("AdminApprovesSupportResponse")), S2(A("redraft"), A("AdminRedraftsSupportResponse")))),
        S3(A("CELL"), A("state:readings"), S1(S1(S3(A("AdminRedraftsSupportResponse"), S2(A("Admin"), A("Support Response")), S1(S3(A("{0}"), A("redrafts"), A("{1}"))))))),
