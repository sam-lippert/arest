                     S2(A("s5"), A("https://8.8.8.8/")),
                     S2(A("s6"), A("http://localhost:5173/")),
                     S2(A("s7"), A("https://172.32.0.1/")),
                     S2(A("s8"), A("https://user@172.31.255.255/")),
                     S2(A("s9"), A("http://[fd12:3456::1]/"))),
                  S8(A("127.0.0.0/8"), A("10.0.0.0/8"), A("169.254.0.0/16"), A("192.168.0.0/16"), A("172.16.0.0/12"), A("::1/128"), A("fe80::/10"), A("fc00::/7"))))),
          K(S6(A("s1"), A("s3"), A("s4"), A("s6"), A("s8"), A("s9")))))),
"test:decided_role_typing holds decide:rt_rows to literal rows: f1 fills R.1 with o1, a Person (and so a Function), and R.2 with o2, a Country, which Person and Country play; f2 fills R.1 with o3, a Country, where only Person plays R.1, so f2.R.1 answers and nothing else does.",
