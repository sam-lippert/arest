    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("ev.md"), A("Widget(.Widget Id) is an entity type.\nWidget Id is a value type.\nSource(.Source Name) is an entity type.\nSource Name is a value type.\nGadget(.Gadget Id) is an entity type.\nGadget Id is a value type.\nWidget is read from Source. **\n  For each Widget and Source, that Widget is read from that Source at most once.\nWidget has Gadget.\nWidget is linked to Gadget. *\n* Widget is linked to Gadget iff that Widget has that Gadget and that Widget is read from some Source.\nWidget 'w1' has Gadget 'g1'.\n"), A("fx/ev.md")))))),
"<store, database, counts> to <the script creates a view of the rule-less fact type, its rows in the database, the rows of the view over it, the database cleared>; a view the database does not hold reads #.",
