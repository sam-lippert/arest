    K(S5(A("subset"), A("alethic"),
       S2(S2(A("EventIsInvolvedInEventCausedTransitionInStateMachine"), N(1)), S2(A("TransitionIsInvolvedInEventCausedTransitionInStateMachine"), N(1))),
       S2(S2(A("EventIsOfEventType"), N(1)), S2(A("TransitionIsTriggeredByEventType"), N(1))),
       S2(S3(A("proj"), A("EventCausedTransitionInStateMachine"), S2(N(1), N(2))), S5(A("joinon"), A("EventIsOfEventType"), A("TransitionIsTriggeredByEventType"), S1(S2(N(2), N(2))), S2(N(1), N(3))))))),
"<store>: the gauge fixture with the catch-up rows put, law-gauge still at 0 and its machine at law-drifting; the subset of test:cu_ss put in state:setcmp before the composed store`s own copy of it, so the fixture holds the constraint whatever the carriers hold; and state:alethic_clean T, as a committed store carries it, so a gated write over it checks what it touched.",
DEF("test:cu_fx",
    S3(A("COMP"), A("main:w2_flag"), S3(A("CONS"),
