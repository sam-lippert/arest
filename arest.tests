    S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), A("test:qs_cn1")), S3(A("COMP"), A("distr"), S3(A("CONS"), S3(A("COMP"), A("store:places"), N(2)), A("id"))))),
DEF("test:qs_cn1",
    S3(A("COMP"), A("test:qs_cn2"), S4(A("CONS"), A("id"),
       S3(A("COMP"), A("theta:find_desc"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), S4(A("COMP"), A("store:fts"), N(2), N(2)))),
       S3(A("COMP"), A("ui:obj_types"), S3(A("CONS"), S3(A("COMP"), N(2), N(2)), S3(A("COMP"), N(2), N(2))))))),
