       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:um_cell"), S3(A("CONS"), K(A("state:fts")), A("id"))), K(S1(S5(A("EmployeeEarnsSalaryInYear"), S3(A("Employee"), A("Salary"), A("Year")), S1(S3(N(1), N(2), N(3))), PHI(), S1(PHI())))))),
