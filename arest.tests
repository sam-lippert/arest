    S3(A("COMP"), A("fp:and_all"), S5(A("CONS"),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), A("test:cv_fx"), K(S2(A("LawCvAnimal"), S3(A("law-cv-a1"), A("law-cv-d1"), A("law-cv-d2")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), A("test:cv_fx"), K(S2(A("LawCvDog"), S2(A("law-cv-d1"), A("law-cv-d2")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), A("test:cv_fx"), K(S2(A("LawCvCat"), S1(A("law-cv-c1")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), A("test:cv_fx"), K(S2(A("LawCvBird"), PHI()))))))),
"AND A RETRACTED OR REPLACED CLASSIFICATION MOVES THE LIST WITH NO SECOND WRITE. The population of the classification written once and nothing else: without law-cv-d1 as a LawCvDog, ui:ids answers LawCvDog as law-cv-d2 alone and LawCvAnimal as law-cv-a1 and law-cv-d2; with law-cv-d1 a LawCvCat instead, LawCvCat as law-cv-d1 and law-cv-c1 and LawCvDog as law-cv-d2. And through the verbs over test:otv_fx: a fact PUT (main:replace) of law-otv-1 as a LawOtvLone lists it there, and the single-fact retract of law-otv-1 as a LawOtvSub (main:retract_put, the write alone, with nothing dropped from a second home) lists it there no more. At HEAD the first four answered nothing, the PUT left LawOtvLone without it and the retract left it listed under LawOtvSub.",
DEF("test:cls_moves",
    S3(A("COMP"), A("fp:and_all"), S7(A("CONS"),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), S3(A("COMP"), A("test:cv_put"), K(S3(S2(A("law-cv-a1"), A("LawCvAnimal")), S2(A("law-cv-d2"), A("LawCvDog")), S2(A("law-cv-c1"), A("LawCvCat"))))), K(S2(A("LawCvDog"), S1(A("law-cv-d2")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), S3(A("COMP"), A("test:cv_put"), K(S3(S2(A("law-cv-a1"), A("LawCvAnimal")), S2(A("law-cv-d2"), A("LawCvDog")), S2(A("law-cv-c1"), A("LawCvCat"))))), K(S2(A("LawCvAnimal"), S2(A("law-cv-a1"), A("law-cv-d2")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), S3(A("COMP"), A("test:cv_put"), K(S4(S2(A("law-cv-a1"), A("LawCvAnimal")), S2(A("law-cv-d1"), A("LawCvCat")), S2(A("law-cv-d2"), A("LawCvDog")), S2(A("law-cv-c1"), A("LawCvCat"))))), K(S2(A("LawCvCat"), S2(A("law-cv-d1"), A("law-cv-c1")))))),
       S3(A("COMP"), A("test:cv_ids"), S3(A("CONS"), S3(A("COMP"), A("test:cv_put"), K(S4(S2(A("law-cv-a1"), A("LawCvAnimal")), S2(A("law-cv-d1"), A("LawCvCat")), S2(A("law-cv-d2"), A("LawCvDog")), S2(A("law-cv-c1"), A("LawCvCat"))))), K(S2(A("LawCvDog"), S1(A("law-cv-d2")))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("law-otv-1")), S3(A("COMP"), A("ui:ids"), S3(A("CONS"), S3(A("COMP"), A("main:replace"), S4(A("CONS"), A("test:otv_fx"), K(A("ObjectTypeInstanceIsInstanceOfObjectType")), K(S2(A("law-otv-1"), A("LawOtvLone"))))), K(A("LawOtvLone")))))),
       S4(A("COMP"), A("not"), A("theta:member"), S3(A("CONS"), K(A("law-otv-1")), S3(A("COMP"), A("ui:ids"), S3(A("CONS"), S3(A("COMP"), A("main:retract_put"), S4(A("CONS"), A("test:otv_fx"), K(A("ObjectTypeInstanceIsInstanceOfObjectType")), K(S2(A("law-otv-1"), A("LawOtvSub"))))), K(A("LawOtvSub"))))))))),

"A VALUE BELONGS TO NO DOMAIN. An entity is of the Domain of its most specific type, and a value has no Domain. test:value_no_domain derives Object Type Instance belongs to Domain over the composed store and holds when the store has instances whose most specific type is a value type, the head derives some rows, and none of those rows is a value's.",
DEF("test:vd_rows",
    S3(A("COMP"), A("derive:on_read"), S3(A("CONS"), K(A("ObjectTypeInstanceBelongsToDomain")), A("id")))),
"<store> to the instances whose most specific type is a value type.",
DEF("test:vd_values",
    S4(A("COMP"), A("theta:flatten"),
       S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), N(2))), S2(A("CONS"), S3(A("COMP"), N(1), N(1))), K(PHI()))),
       S3(A("COMP"), A("distr"), S3(A("CONS"), S3(A("COMP"), A("derive:on_read"), S3(A("CONS"), K(A("ObjectTypeInstanceIsMostSpecificallyOfObjectType")), A("id"))), A("reflect:val_types"))))),
"<store> to the instances whose most specific type is an entity type. One lexical id can name an entity and a value at once ('integer' is a Conceptual Data Type and a JSON Type), and the Domain such an id has is the entity's.",
DEF("test:vd_entities",
    S4(A("COMP"), A("theta:flatten"),
       S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), S3(A("COMP"), N(2), N(1)), N(2))), S2(A("CONS"), S3(A("COMP"), N(1), N(1))), K(PHI()))),
       S3(A("COMP"), A("distr"), S3(A("CONS"), S3(A("COMP"), A("derive:on_read"), S3(A("CONS"), K(A("ObjectTypeInstanceIsMostSpecificallyOfObjectType")), A("id"))), S3(A("COMP"), A("reflect:ot_kind"), S3(A("CONS"), K(A("entity")), A("id"))))))),
"<store> to the derived rows whose instance is a value and no entity.",
DEF("test:vd_valued",
    S4(A("COMP"), A("theta:flatten"),
       S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), N(2))), S2(A("CONS"), N(1)), K(PHI()))),
       S3(A("COMP"), A("distr"), S3(A("CONS"), A("test:vd_rows"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), A("test:vd_values"), A("test:vd_entities"))))))),
DEF("test:value_no_domain",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"),
       S4(A("COMP"), A("not"), A("null"), A("test:vd_values")),
       S4(A("COMP"), A("not"), A("null"), A("test:vd_rows")),
       S3(A("COMP"), A("null"), A("test:vd_valued"))))),
"test:eng_forms holds that the engine takes a stored head whose rules count or compare, since sqlite:recipe_sql says both (test:recipe_sql_forms): compile:eng_cand1 keeps a head whose rule is a count, and one whose rule projects a cmp over a minus, as FactTypeHasArity and LayerHasArousalCoord are derived, and still refuses a form sqlite:recipe_sql does not say (calc).",
DEF("test:eng_forms",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("compile:eng_cand1"), K(S2(A("H1"), S1(S3(A("count"), A("FactTypeHasRole"), N(1)))))), K(S1(A("H1"))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("compile:eng_cand1"), K(S2(A("H2"), S1(S3(A("proj"), S4(A("cmp"), S3(A("minus"), A("Lx"), A("Ly")), N(2), N(4)), S2(N(1), N(3))))))), K(S1(A("H2"))))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("compile:eng_cand1"), K(S2(A("H3"), S1(S5(A("calc"), A("Lx"), A("+"), N(1), N(2)))))))))),
"test:eng_judged holds that the store an in-place check judges holds the rows of the heads the engine wrote. The closure leaves a planned head`s rules out (derive:closure_rules), so the closed store holds none of its rows, and a constraint the SQL checks do not cover is judged in memory over that store: MEASURED on a copy of claude`s store once test:eng_forms let the engine count Fact Type has Arity, every Fact Type broke Each Fact Type has exactly one Arity in memory while the database held all 968 of its rows, and alethic_clean was F. Over test:dv_store laid out in law-eng-facts.db, with a compile:engine_plan cell naming Club holds Venue at its place, compile:ip_eng_facts answers the four rows the database holds of it, Club chess holds Venue york among them; the database is cleared after. Run first with compile:ip_eng_facts answering none, it failed.",
DEF("test:ej_cell",
    S4(A("CONS"), K(A("CELL")), K(A("compile:engine_plan")), S3(A("CONS"), S2(A("CONS"), S4(A("CONS"), K(A("ClubHoldsVenue")), K(PHI()), S3(A("COMP"), A("schema:src"), S3(A("CONS"), K(A("ClubHoldsVenue")), S3(A("COMP"), A("schema:env"), A("id")))))), K(PHI())))),
DEF("test:ej_facts",
    S3(A("COMP"), A("compile:ip_eng_facts"), S3(A("CONS"), N(2), S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), S2(A("CONS"), A("test:ej_cell")), N(1)), N(1)))))),
DEF("test:ej_verdict",
    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), A("test:ej_facts")), K(N(4)))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("ClubHoldsVenue"), S2(A("chess"), A("york")))), A("test:ej_facts")))))),
DEF("test:eng_judged",
    S3(A("COMP"), N(1), S3(A("COMP"), S3(A("CONS"), A("test:ej_verdict"), S3(A("COMP"), A("storage:fresh"), N(2))),
       S3(A("COMP"), A("test:dv_s3"), S3(A("COMP"), A("test:dv_s2"), S3(A("COMP"), S3(A("CONS"), A("id"), S3(A("COMP"), A("storage:fresh"), K(A("law-eng-facts.db")))), A("test:dv_store"))))))),
"test:eng_recursive holds that the engine computes a stored head whose rule reads the head itself, to the least fixpoint, in SQL. One literal readings file: Node links to Node is asserted (a to b, b to c, c to d, x to y), and Node reaches Node is marked ** and derived by two rules, the links themselves and Node1 reaches Node3 iff Node1 reaches Node2 and Node2 reaches Node3, the non-linear form core.md gives Domain reaches Domain. The store compile:check makes is laid out in law-eng-recursive.db and filled as a compile fills it (test:dv_s2, test:dv_s3); compile:eng_plan must plan Node reaches Node, and storage:derive_head of its entry must leave in its table the seven rows of the closure: a reaches b, c and d, b reaches c and d, c reaches d, and x reaches y. The database is cleared after. Run first, the plan left the head to the closure, since a head that reads itself was no candidate, and it failed.",
DEF("test:er_files",
    K(S1(S3(A("rec.md"), A("Node(.id) is an entity type.\nNode links to Node.\n  Each Node, Node combination occurs at most once in the population of Node links to Node.\nNode reaches Node. **\n  Each Node, Node combination occurs at most once in the population of Node reaches Node.\n** Node1 reaches Node2 iff Node1 links to Node2.\n** Node1 reaches Node3 iff Node1 reaches Node2 and Node2 reaches Node3.\nNode 'a' links to Node 'b'.\nNode 'b' links to Node 'c'.\nNode 'c' links to Node 'd'.\nNode 'x' links to Node 'y'.\n"), A("fx/rec.md"))))),
DEF("test:er_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:er_files"))),
"<store, database, counts> to <store, database, the plan`s entries for Node reaches Node>.",
DEF("test:er_s4",
    S4(A("CONS"), N(1), N(2), S5(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(A("NodeReachesNode")))), S2(A("CONS"), A("id")), K(PHI()))), N(1), S3(A("COMP"), A("compile:eng_plan"), N(1))))),
"<store, database, entries> to <entries, the head`s rows in the database once the engine computed it, the database cleared>.",
DEF("test:er_s5",
    S4(A("CONS"), N(3),
       S4(A("COND"), S3(A("COMP"), A("null"), N(3)), K(PHI()), S3(A("COMP"), A("storage:rows"), S3(A("COMP"), S4(A("CONS"), N(2), K(A("NodeReachesNode")), S3(A("COMP"), A("storage:columns"), S3(A("CONS"), N(2), K(A("NodeReachesNode"))))),
          S3(A("COMP"), N(3), S4(A("CONS"), S3(A("COMP"), A("sqlite:stage_facts"), N(2)), S3(A("COMP"), A("storage:derive_head"), S3(A("CONS"), S3(A("COMP"), N(1), N(3)), S4(A("CONS"), N(2), S4(A("COMP"), N(2), A("compile:eng_plan"), N(1)), K(PHI())))), A("id")))))),
       S3(A("COMP"), A("storage:fresh"), N(2)))),
"test:recursive_view holds that a head computed on read whose rules read it is a view, its rows the least fixpoint, by SQLite`s WITH RECURSIVE. The readings of test:er_files with Node reaches Node marked * instead of **: the relational map lays out no table for the head, the script creates a view of it, and the view answers the seven rows of the closure. SQLite takes the recursive table once in a select and never inside a subquery, so the rule Node1 reaches Node3 iff Node1 reaches Node2 and Node2 reaches Node3, which reads the head twice, is said once for each rule that reads it not at all, the head joined to that rule`s select, the same least fixpoint (a transitive closure is the closure of its base). The database is law-recursive-view.db, made fresh before and cleared after. Run first, the head was no view, since a view was no head that reads itself, and it failed.",
DEF("test:rv_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), K(S1(S3(A("rec.md"), A("Node(.id) is an entity type.\nNode links to Node.\n  Each Node, Node combination occurs at most once in the population of Node links to Node.\nNode reaches Node. *\n  Each Node, Node combination occurs at most once in the population of Node reaches Node.\n* Node1 reaches Node2 iff Node1 links to Node2.\n* Node1 reaches Node3 iff Node1 reaches Node2 and Node2 reaches Node3.\nNode 'a' links to Node 'b'.\nNode 'b' links to Node 'c'.\nNode 'c' links to Node 'd'.\nNode 'x' links to Node 'y'.\n"), A("fx/rec.md")))))),
"<store, database, counts> to <the script creates a view of the head, the head`s rows in the database, the database cleared>.",
DEF("test:rv_s4",
    S4(A("CONS"), S3(A("COMP"), A("cn:contains"), S3(A("CONS"), S3(A("COMP"), A("schema:ddl"), N(1)), K(A("CREATE VIEW \"NodeReachesNode\"")))),
       S4(A("COND"), S4(A("COMP"), A("null"), A("storage:columns"), S3(A("CONS"), N(2), K(A("NodeReachesNode")))), K(PHI()), S3(A("COMP"), A("storage:rows"), S4(A("CONS"), N(2), K(A("NodeReachesNode")), S3(A("COMP"), A("storage:columns"), S3(A("CONS"), N(2), K(A("NodeReachesNode"))))))),
       S3(A("COMP"), A("storage:fresh"), N(2)))),
DEF("test:recursive_view",
    S5(A("COMP"), A("fp:and_all"), S3(A("CONS"), N(1), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), N(2), K(S7(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")), S2(A("a"), A("c")), S2(A("b"), A("d")), S2(A("a"), A("d")), S2(A("x"), A("y"))))))),
       A("test:rv_s4"), S3(A("COMP"), A("test:dv_s3"), S3(A("COMP"), A("test:dv_s2"), S3(A("COMP"), S3(A("CONS"), A("id"), S3(A("COMP"), A("storage:fresh"), K(A("law-recursive-view.db")))), A("test:rv_store")))))),
DEF("test:eng_recursive",
    S5(A("COMP"), A("fp:and_all"), S3(A("CONS"), S4(A("COMP"), A("not"), A("null"), N(1)), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), N(2), K(S7(S2(A("a"), A("b")), S2(A("b"), A("c")), S2(A("c"), A("d")), S2(A("a"), A("c")), S2(A("b"), A("d")), S2(A("a"), A("d")), S2(A("x"), A("y"))))))),
       A("test:er_s5"), S3(A("COMP"), A("test:er_s4"), S3(A("COMP"), A("test:dv_s3"), S3(A("COMP"), A("test:dv_s2"), S3(A("COMP"), S3(A("CONS"), A("id"), S3(A("COMP"), A("storage:fresh"), K(A("law-eng-recursive.db")))), A("test:er_store")))))))
)
