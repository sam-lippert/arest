       S3(A("COMP"), A("eq"), S3(A("CONS"), A("id"), K(S2(S3(A("A"), S1(A("z1")), S1(A("y1"))), S3(A("D"), S1(A("d3")), S1(A("d2"))))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("compile:ip_facts_moved_of"), S3(A("CONS"), A("test:fm_op"), K(A("D")))), K(S2(S1(A("d3")), S1(A("d2")))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("compile:ip_facts_moved_of"), S3(A("CONS"), A("test:fm_op"), K(A("B")))), K(S2(PHI(), PHI()))))))),
