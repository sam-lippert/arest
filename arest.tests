    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("schema:place"), S3(A("CONS"), S3(A("COMP"), N(1), N(1)), N(2))), S3(A("COMP"), N(2), N(1))))),
       S3(A("COMP"), A("distr"), S3(A("CONS"),
          K(S3(S2(A("ServiceHasGitHubRepository"), S4(A("Service"), S2(A("serviceName"), A("gitHubRepository")), A("#"), N(1))),
               S2(A("InvoiceHasCostCenter"), S4(A("Invoice"), S2(A("invoice"), A("costCenter")), A("#"), N(1))),
               S2(A("InvoiceHasBillingPeriod"), S4(A("Invoice"), S2(A("invoice"), A("billingPeriod")), A("#"), N(1))))),
          S3(A("COMP"), A("schema:env"), A("test:csj_store"))))))),
