    K(S(
       S4(A("Crate"), A("1"), A("shelf"), A("CrateBelongsToShelf")), S4(A("Crate"), A("2"), A("slot"), A("CrateHasSlot")), S4(A("Crate"), A("3"), A("crate"), A("#")), S4(A("Crate"), A("4"), A("weight"), A("CrateHasWeight")),
