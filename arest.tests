          S4(A("COMP"), A("test:ss_entered"), A("system:pop_rows"), S3(A("CONS"), K(A("MemberHasGrade")), N(1))),
          S4(A("COMP"), A("test:ss_entered"), A("test:ss_desc"), N(2)),
          S3(A("COMP"), A("theta:subset"), S3(A("CONS"), A("test:ss_semi"), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("retract:places"), S3(A("CONS"), N(1), S3(A("COMP"), A("schema:env"), N(1))))))),
       S3(A("CONS"), N(1), S3(A("COMP"), A("store:for_read"), A("test:ss_served"))))),
