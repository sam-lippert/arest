    S3(A("COMP"), S3(A("COMP"), A("fp:and_all"), S3(A("CONS"), N(1), S3(A("COMP"), A("eq"), S3(A("CONS"), N(2), K(S4(S3(A("A"), A("z1"), A("added")), S3(A("A"), A("y1"), A("removed")), S3(A("D"), A("d3"), A("added")), S3(A("D"), A("d2"), A("removed")))))))),
       S4(A("CONS"), S3(A("COMP"), A("test:fm_check"), A("test:fm_got")), S3(A("COMP"), A("sqlite:query"), S4(A("CONS"), A("test:fm_db"), K(A("select \"ft\", \"row\", \"side\" from \"_moved\" order by \"ft\", \"side\", \"row\"")), K(PHI()))), S3(A("COMP"), A("storage:fresh"), A("test:fm_db"))))),
DEF("test:fm_db", K(A("law-facts-moved.db"))),
