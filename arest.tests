    K(S4(S3(A("CELL"), A("state:fts"), S1(S4(
            S5(A("PhHas"), S2(A("Thing"), A("Code")), S1(S1(N(1))), PHI(), S1(S2(A("t1"), A("keep")))),
            S5(A("PhSource"), S2(A("Thing"), A("Code")), PHI(), PHI(), S2(S2(A("t1"), A("drop")), S2(A("t2"), A("fresh")))),
            S5(A("PhDropped"), S1(A("Thing")), PHI(), PHI(), PHI()),
            S5(A("PhFresh"), S1(A("Thing")), PHI(), PHI(), PHI())))),
         S3(A("CELL"), A("state:declared"), S1(S4(S2(A("PhHas"), S2(A("Thing"), A("Code"))), S2(A("PhSource"), S2(A("Thing"), A("Code"))), S2(A("PhDropped"), S1(A("Thing"))), S2(A("PhFresh"), S1(A("Thing")))))),
         S3(A("CELL"), A("state:derived"), S1(S1(S2(A("PhHas"), A("semi"))))),
