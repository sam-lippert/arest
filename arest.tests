    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("null"), A("test:deo_unread")),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("test:deo_unread"), A("test:du_link")), K(S1(A("DEO:m:GadgetIsInvolvedInGadgetHasPart#1")))))))),
