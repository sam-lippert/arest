    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), A("main:post_answer")), S4(A("COMP"), A("test:w2b_owed"), S4(A("CONS"), N(1), S3(A("COMP"), N(1), N(2)), S3(A("COMP"), A("store:closed_from"), S3(A("CONS"), N(1), S3(A("COMP"), N(2), N(2))))), S3(A("CONS"), N(1), A("main:w2b_trial")))))),
"<store, fact type, fact> to T when main:replace_step answers, byte for byte, what the whole check of the store main:replace closes owes.",
DEF("test:w2b_put",
    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), N(1), A("main:replace_step")), S4(A("COMP"), A("test:w2b_owed"), S4(A("CONS"), N(1), S2(A("CONS"), S3(A("CONS"), N(2), N(4))), N(3)), S5(A("CONS"), N(1), N(2), A("main:replace"), N(3)))))),
"<store, fact type, fact> to T when main:retract_step answers, byte for byte, what the whole check of the store main:retract closes owes.",
