    S3(A("COMP"), A("store:src_all"), S3(A("CONS"), S3(A("COMP"), A("test:qs_groups"), S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), A("test:qs_tpairs")), S3(A("COMP"), A("distr"), S3(A("CONS"), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("rmap:coltabs"), N(1)), A("id"))))), N(1)))),
