       S3(A("COMP"), A("test:sp_put"), S4(A("CONS"),
          S3(A("COMP"), A("test:sp_put"), S4(A("CONS"), A("id"), K(A("FunctionHasQueryParameterWithParameterValue")), K(S3(A("law-fn"), A("depth"), A("0"))))),
          K(A("FunctionSendsRoleToQueryParameter")), K(S3(A("law-fn"), A("UserHasEmail.2"), A("where[email][equals]"))))),
       K(A("UserHasEmail")), K(S2(A("law-user"), A("law@example.com"))))), K(A("FactTypeHasRole")), K(S2(A("UserHasEmail"), A("UserHasEmail.2")))))),
