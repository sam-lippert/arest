    K(S3(A("minus"), S3(A("proj"), S4(A("sel"), A("ObjectTypeInstanceIsInstanceOfObjectType"), N(2), A("Observation")), S1(N(1))), S3(A("proj"), A("ObservationIsOfFact"), S1(N(1)))))),
