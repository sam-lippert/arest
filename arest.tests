       A("id"),
       S3(A("COMP"), A("test:cs_store"), S5(A("CONS"), A("test:cvd_text"), K(S3(S2(A("CrateIsFlagged"), S1(S1(A("c1")))), S2(A("CrateIsAllowed"), S1(S1(A("c1")))), S2(A("CrateIsShipped"), S1(S1(A("c2")))))), K(S2(S2(A("c1"), A("Crate")), S2(A("c2"), A("Crate")))), K(A("V")))))),
