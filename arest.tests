          S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("derive:pop"), S3(A("CONS"), K(A("PhHas")), A("id"))), K(S2(S2(A("t1"), A("keep")), S2(A("t2"), A("fresh"))))))),
       A("derive:closed"), A("test:ph_store"))),
