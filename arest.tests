DEF("test:rt_fxa", K(S4(S3(A("CELL"), A("FILE"), S4(S3(A("CELL"), A("ThingHasLabel"), S2(S3(A("CELL"), A("t1"), S1(A("alpha"))), S3(A("CELL"), A("t2"), S1(A("alpha"))))), S3(A("CELL"), A("ThingHasColor"), S3(S3(A("CELL"), A("t1"), S1(A("red"))), S3(A("CELL"), A("t2"), S1(A("red"))), S3(A("CELL"), A("t3"), S1(A("blue"))))), S3(A("CELL"), A("ConstraintTypeHasViolationTemplate"), S2(S3(A("CELL"), A("UC"), S1(A("Uniqueness violation: {object_type} {value} is not unique in {reading}"))), S3(A("CELL"), A("MC"), S1(A("Mandatory violation: {object_type} {value} does not participate in {reading}"))))), S3(A("CELL"), A("ConstraintTypeHasConstraintTypeFamily"), S4(S3(A("CELL"), A("IR"), S1(A("ring"))), S3(A("CELL"), A("AC"), S1(A("ring"))), S3(A("CELL"), A("UC"), S1(A("uniqueness"))), S3(A("CELL"), A("MC"), S1(A("mandatory"))))))), S3(A("CELL"), A("state:fts"), S1(S2(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(2))), PHI(), S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("alpha")))), S5(A("ThingHasColor"), S2(A("Thing"), A("Color")), S1(S1(N(2))), S1(N(1)), S3(S2(A("t1"), A("red")), S2(A("t2"), A("red")), S2(A("t3"), A("blue"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")), S2(A("t3"), A("Thing")))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label"))), S2(A("ThingHasColor"), S2(A("Thing"), A("Color"))))))))),
DEF("test:rt_fxb", K(S4(S3(A("CELL"), A("FILE"), S6(S3(A("CELL"), A("ThingHasLabel"), S2(S3(A("CELL"), A("t1"), S1(A("alpha"))), S3(A("CELL"), A("t2"), S1(A("alpha"))))), S3(A("CELL"), A("ThingHasColor"), S3(S3(A("CELL"), A("t1"), S1(A("red"))), S3(A("CELL"), A("t2"), S1(A("red"))), S3(A("CELL"), A("t3"), S1(A("blue"))))), S3(A("CELL"), A("ConstraintTypeHasViolationTemplate"), S2(S3(A("CELL"), A("UC"), S1(A("Uniqueness violation: {object_type} {value} is not unique in {reading}"))), S3(A("CELL"), A("MC"), S1(A("Mandatory violation: {object_type} {value} does not participate in {reading}"))))), S3(A("CELL"), A("ConstraintTypeHasConstraintTypeFamily"), S4(S3(A("CELL"), A("IR"), S1(A("ring"))), S3(A("CELL"), A("AC"), S1(A("ring"))), S3(A("CELL"), A("UC"), S1(A("uniqueness"))), S3(A("CELL"), A("MC"), S1(A("mandatory"))))), S3(A("CELL"), A("FactTypeHasReading"), S1(S3(A("CELL"), A("ThingHasColor"), S1(A("rThingHasColor"))))), S3(A("CELL"), A("ReadingHasText"), S1(S3(A("CELL"), A("rThingHasColor"), S1(A("{0} has {1}"))))))), S3(A("CELL"), A("state:fts"), S1(S2(S5(A("ThingHasLabel"), S2(A("Thing"), A("Label")), S1(S1(N(2))), PHI(), S2(S2(A("t1"), A("alpha")), S2(A("t2"), A("alpha")))), S5(A("ThingHasColor"), S2(A("Thing"), A("Color")), S1(S1(N(2))), S1(N(1)), S3(S2(A("t1"), A("red")), S2(A("t2"), A("red")), S2(A("t3"), A("blue"))))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("t1"), A("Thing")), S2(A("t2"), A("Thing")), S2(A("t3"), A("Thing")))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("ThingHasLabel"), S2(A("Thing"), A("Label"))), S2(A("ThingHasColor"), S2(A("Thing"), A("Color"))))))))),
