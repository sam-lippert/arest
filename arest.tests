    S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(A("CustomerAuthenticatesViaOAuthAccount")))), S2(A("CONS"), A("id")), K(PHI()))), A("cmd:mand_viols"))),
