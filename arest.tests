       A("test:ss_layout")))),
"test:map_subject holds storage:schema_map, the statement a store is read through, to the rule schema:carried gives: a column for Roles of more than one fact type carries the fact type its table`s subject plays in, not one of the reference of the value it holds. test:carried_subject holds that rule in lambda; this holds the statement to it. The rows are a served app`s, as its store holds them: Cost Center(.Cost Center Name); Invoice(.Cost Center, .Billing Period), whose costCenter is for InvoiceHasCostCenter.2 and CostCenterHasCostCenterName.2; Invoice Line Item(.Invoice, .Line Item Index), whose key unpacks Invoice, so its billingPeriod and costCenter are for InvoiceLineItemHasInvoice.2 as well; Service, whose gitHubRepository is for ServiceHasGitHubRepository.2 and for GitHub Repository`s reference, a type with no table; and Order with its subtype Rush Order absorbed, whose rushOrderCourierDepot is for Rush Order uses Courier, Courier belongs to Depot and Depot has Depot Code, where only Order`s subject closed under its subtypes (schema:subclose) is across from Rush Order uses Courier. Beside them, the Roles and Object Types the rule reads: each Role`s fact type and player (Function`s roleFactTypeId and roleObjectTypeId) and Object Type is of Object Kind (objectTypeObjectKind). Run first, the statement answered the least names: CostCenterHasCostCenterName for Invoice`s and Invoice Line Item`s costCenter, InvoiceHasBillingPeriod for Invoice Line Item`s billingPeriod, GitHubRepositoryHasFullName for gitHubRepository and CourierBelongsToDepot for rushOrderCourierDepot. So a store read on demand looked for InvoiceHasCostCenter in no table, and a module without carriers read none of its rows. This answered F.",
DEF("test:ms_script",
    K(A("create table \"Function\" (\"functionId\" text primary key, \"columnTableId\" text, \"columnName\" text, \"columnPosition\" text, \"tableName\" text, \"tableFactTypeId\" text, \"tableKeyTableId\" text, \"tableIsAView\" text, \"roleFactTypeId\" text, \"roleObjectTypeId\" text, \"objectTypeObjectKind\" text); create table \"ColumnIsForRole\" (\"columnId\" text, \"roleId\" text, primary key (\"columnId\", \"roleId\")); create table \"TableKeySpansColumn\" (\"tableKeyId\" text, \"columnId\" text, primary key (\"tableKeyId\", \"columnId\")); insert into \"Function\" (\"functionId\", \"tableName\") values ('schema:CostCenter', 'CostCenter'), ('schema:Invoice', 'Invoice'), ('schema:InvoiceLineItem', 'InvoiceLineItem'), ('schema:Order', 'Order'), ('schema:Service', 'Service'); insert into \"Function\" (\"functionId\", \"tableKeyTableId\") values ('schema:CostCenter:CostCenter_PK', 'schema:CostCenter'), ('schema:Invoice:Invoice_PK', 'schema:Invoice'), ('schema:InvoiceLineItem:InvoiceLineItem_PK', 'schema:InvoiceLineItem'), ('schema:Order:Order_PK', 'schema:Order'), ('schema:Service:Service_PK', 'schema:Service'); insert into \"Function\" (\"functionId\", \"columnTableId\", \"columnName\", \"columnPosition\") values ('schema:CostCenter:costCenterName', 'schema:CostCenter', 'costCenterName', '1'), ('schema:Invoice:billingPeriod', 'schema:Invoice', 'billingPeriod', '1'), ('schema:Invoice:costCenter', 'schema:Invoice', 'costCenter', '2'), ('schema:Invoice:invoice', 'schema:Invoice', 'invoice', '3'), ('schema:InvoiceLineItem:billingPeriod', 'schema:InvoiceLineItem', 'billingPeriod', '1'), ('schema:InvoiceLineItem:costCenter', 'schema:InvoiceLineItem', 'costCenter', '2'), ('schema:InvoiceLineItem:lineItemIndex', 'schema:InvoiceLineItem', 'lineItemIndex', '3'), ('schema:InvoiceLineItem:invoiceLineItem', 'schema:InvoiceLineItem', 'invoiceLineItem', '4'), ('schema:Order:orderId', 'schema:Order', 'orderId', '1'), ('schema:Order:rushOrderCourierDepot', 'schema:Order', 'rushOrderCourierDepot', '2'), ('schema:Service:serviceName', 'schema:Service', 'serviceName', '1'), ('schema:Service:gitHubRepository', 'schema:Service', 'gitHubRepository', '2'); insert into \"Function\" (\"functionId\", \"roleFactTypeId\", \"roleObjectTypeId\") values ('CostCenterHasCostCenterName.1', 'CostCenterHasCostCenterName', 'Cost Center'), ('CostCenterHasCostCenterName.2', 'CostCenterHasCostCenterName', 'Cost Center Name'), ('InvoiceHasCostCenter.1', 'InvoiceHasCostCenter', 'Invoice'), ('InvoiceHasCostCenter.2', 'InvoiceHasCostCenter', 'Cost Center'), ('InvoiceHasBillingPeriod.1', 'InvoiceHasBillingPeriod', 'Invoice'), ('InvoiceHasBillingPeriod.2', 'InvoiceHasBillingPeriod', 'Billing Period'), ('InvoiceLineItemHasInvoice.1', 'InvoiceLineItemHasInvoice', 'Invoice Line Item'), ('InvoiceLineItemHasInvoice.2', 'InvoiceLineItemHasInvoice', 'Invoice'), ('InvoiceLineItemHasLineItemIndex.1', 'InvoiceLineItemHasLineItemIndex', 'Invoice Line Item'), ('InvoiceLineItemHasLineItemIndex.2', 'InvoiceLineItemHasLineItemIndex', 'Line Item Index'), ('OrderHasOrderId.1', 'OrderHasOrderId', 'Order'), ('OrderHasOrderId.2', 'OrderHasOrderId', 'Order Id'), ('RushOrderIsASubtypeOfOrder.1', 'RushOrderIsASubtypeOfOrder', 'Rush Order'), ('RushOrderIsASubtypeOfOrder.2', 'RushOrderIsASubtypeOfOrder', 'Order'), ('RushOrderUsesCourier.1', 'RushOrderUsesCourier', 'Rush Order'), ('RushOrderUsesCourier.2', 'RushOrderUsesCourier', 'Courier'), ('CourierBelongsToDepot.1', 'CourierBelongsToDepot', 'Courier'), ('CourierBelongsToDepot.2', 'CourierBelongsToDepot', 'Depot'), ('DepotHasDepotCode.1', 'DepotHasDepotCode', 'Depot'), ('DepotHasDepotCode.2', 'DepotHasDepotCode', 'Depot Code'), ('ServiceHasServiceName.1', 'ServiceHasServiceName', 'Service'), ('ServiceHasServiceName.2', 'ServiceHasServiceName', 'Service Name'), ('ServiceHasGitHubRepository.1', 'ServiceHasGitHubRepository', 'Service'), ('ServiceHasGitHubRepository.2', 'ServiceHasGitHubRepository', 'GitHub Repository'), ('GitHubRepositoryHasFullName.1', 'GitHubRepositoryHasFullName', 'GitHub Repository'), ('GitHubRepositoryHasFullName.2', 'GitHubRepositoryHasFullName', 'Full Name'); insert into \"Function\" (\"functionId\", \"objectTypeObjectKind\") values ('Cost Center', 'entity'), ('Cost Center Name', 'value'), ('Invoice', 'entity'), ('Billing Period', 'value'), ('Invoice Line Item', 'entity'), ('Line Item Index', 'value'), ('Order', 'entity'), ('Order Id', 'value'), ('Rush Order', 'entity'), ('Courier', 'entity'), ('Depot', 'entity'), ('Depot Code', 'value'), ('Service', 'entity'), ('Service Name', 'value'), ('GitHub Repository', 'entity'), ('Full Name', 'value'); insert into \"ColumnIsForRole\" values ('schema:CostCenter:costCenterName', 'CostCenterHasCostCenterName.2'), ('schema:Invoice:billingPeriod', 'InvoiceHasBillingPeriod.2'), ('schema:Invoice:costCenter', 'CostCenterHasCostCenterName.2'), ('schema:Invoice:costCenter', 'InvoiceHasCostCenter.2'), ('schema:Invoice:invoice', 'CostCenterHasCostCenterName.1'), ('schema:Invoice:invoice', 'InvoiceHasBillingPeriod.1'), ('schema:Invoice:invoice', 'InvoiceHasCostCenter.1'), ('schema:InvoiceLineItem:billingPeriod', 'InvoiceHasBillingPeriod.2'), ('schema:InvoiceLineItem:billingPeriod', 'InvoiceLineItemHasInvoice.2'), ('schema:InvoiceLineItem:costCenter', 'CostCenterHasCostCenterName.2'), ('schema:InvoiceLineItem:costCenter', 'InvoiceHasCostCenter.2'), ('schema:InvoiceLineItem:costCenter', 'InvoiceLineItemHasInvoice.2'), ('schema:InvoiceLineItem:lineItemIndex', 'InvoiceLineItemHasLineItemIndex.2'), ('schema:InvoiceLineItem:invoiceLineItem', 'CostCenterHasCostCenterName.1'), ('schema:InvoiceLineItem:invoiceLineItem', 'InvoiceHasBillingPeriod.1'), ('schema:InvoiceLineItem:invoiceLineItem', 'InvoiceHasCostCenter.1'), ('schema:InvoiceLineItem:invoiceLineItem', 'InvoiceLineItemHasInvoice.1'), ('schema:InvoiceLineItem:invoiceLineItem', 'InvoiceLineItemHasLineItemIndex.1'), ('schema:Order:orderId', 'OrderHasOrderId.2'), ('schema:Order:rushOrderCourierDepot', 'RushOrderUsesCourier.2'), ('schema:Order:rushOrderCourierDepot', 'CourierBelongsToDepot.2'), ('schema:Order:rushOrderCourierDepot', 'DepotHasDepotCode.2'), ('schema:Service:serviceName', 'ServiceHasServiceName.2'), ('schema:Service:gitHubRepository', 'GitHubRepositoryHasFullName.1'), ('schema:Service:gitHubRepository', 'ServiceHasGitHubRepository.2'); insert into \"TableKeySpansColumn\" values ('schema:CostCenter:CostCenter_PK', 'schema:CostCenter:costCenterName'), ('schema:Invoice:Invoice_PK', 'schema:Invoice:billingPeriod'), ('schema:Invoice:Invoice_PK', 'schema:Invoice:costCenter'), ('schema:InvoiceLineItem:InvoiceLineItem_PK', 'schema:InvoiceLineItem:billingPeriod'), ('schema:InvoiceLineItem:InvoiceLineItem_PK', 'schema:InvoiceLineItem:costCenter'), ('schema:InvoiceLineItem:InvoiceLineItem_PK', 'schema:InvoiceLineItem:lineItemIndex'), ('schema:Order:Order_PK', 'schema:Order:orderId'), ('schema:Service:Service_PK', 'schema:Service:serviceName');"))),
DEF("test:ms_want",
    K(S(
       S4(A("CostCenter"), A("1"), A("costCenterName"), A("CostCenterHasCostCenterName")),
       S4(A("Invoice"), A("1"), A("billingPeriod"), A("InvoiceHasBillingPeriod")), S4(A("Invoice"), A("2"), A("costCenter"), A("InvoiceHasCostCenter")), S4(A("Invoice"), A("3"), A("invoice"), A("#")),
       S4(A("InvoiceLineItem"), A("1"), A("billingPeriod"), A("InvoiceLineItemHasInvoice")), S4(A("InvoiceLineItem"), A("2"), A("costCenter"), A("InvoiceLineItemHasInvoice")), S4(A("InvoiceLineItem"), A("3"), A("lineItemIndex"), A("InvoiceLineItemHasLineItemIndex")), S4(A("InvoiceLineItem"), A("4"), A("invoiceLineItem"), A("#")),
       S4(A("Order"), A("1"), A("orderId"), A("OrderHasOrderId")), S4(A("Order"), A("2"), A("rushOrderCourierDepot"), A("RushOrderUsesCourier")),
       S4(A("Service"), A("1"), A("serviceName"), A("ServiceHasServiceName")), S4(A("Service"), A("2"), A("gitHubRepository"), A("ServiceHasGitHubRepository"))))),
DEF("test:map_subject",
    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("sqlite:scratch"), S4(A("CONS"), A("test:ms_script"), A("storage:schema_map"), K(PHI()))), A("test:ms_want")))),
"test:value_key_role holds the key column of a value type`s own table to the role the value type plays in the fact types that table carries (csdp.md: each Column is for some Role). A value type is a concept type, and gets a table, only where it plays a role no entity`s table absorbs (rmap:vtcts), and that table is keyed by the one identifier step rmap:b3pidchains gives it, an info step through no fact type, so the column it lays out holds the value itself and rmap:schema_cells left it for no Role -- measured on a large app`s store, its Email and Polarity value columns were the only Columns of it for none. The fixture is that shape twice: Email, which exactly one User has, so UserHasEmail is grouped on Email`s side and Email`s table carries it, and Polarity, opposite to at most one Polarity, a ring Polarity`s table carries. Over the schema rows of the store compile:check makes of it, Email`s value column is for UserHasEmail.2, Polarity`s for PolarityIsOppositeToPolarity.1, the role beside the ring`s column, which is for its second; every Column is for some Role; and the fact type each column carries, as storage:schema_map reads the map back, is as before those rows were written: the user column carries UserHasEmail, the polarity column the ring, and neither value column carries anything, since a value column holds the subject of its table, which is read back as the row and not as a fact. Run first with the fix absent, the value columns were for no Role and this answered F.",
DEF("test:vk_files",
    K(S1(S3(A("vk.md"), A("Name is a value type.\nEmail is a value type.\nPolarity is a value type.\nUser(.Name) is an entity type.\nUser has Email.\n  Each User has at most one Email.\n  For each Email, exactly one User has that Email.\nPolarity is opposite to Polarity.\n  Each Polarity is opposite to at most one Polarity.\n"), A("vk/vk.md"))))),
DEF("test:vk_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:vk_files"))),
DEF("test:value_key_role",
    S4(A("COMP"), A("fp:and_all"), S4(A("CONS"),
       S3(A("COMP"), A("theta:subset"), S3(A("CONS"), K(S2(S2(A("schema:Email:value"), A("UserHasEmail.2")), S2(A("schema:Polarity:value"), A("PolarityIsOppositeToPolarity.1")))), S3(A("COMP"), A("schema:r"), S3(A("CONS"), K(A("ColumnIsForRole")), A("id"))))),
       S4(A("COMP"), A("null"), A("theta:setminus"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("schema:r"), S3(A("CONS"), K(A("ColumnBelongsToTable")), A("id")))), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("schema:r"), S3(A("CONS"), K(A("ColumnIsForRole")), A("id")))))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), K(S2(S2(A("schema:Email:user"), A("UserHasEmail")), S2(A("schema:Polarity:polarity"), A("PolarityIsOppositeToPolarity")))), N(8)))),
       S3(A("COMP"), A("schema:env"), A("test:vk_store")))),
DEF("test:compound_roundtrip",
    S4(A("COMP"), A("test:cr_verdict"), S6(A("COMP"), A("test:cr_s5"), A("test:cr_s4"), A("test:cr_s3"), A("test:cr_s2"), A("test:cr_s1")), A("test:cr_store"))),
"A FACT TYPE IN ANOTHER TABLE WHERE A COMPOUND-KEYED ENTITY PLAYS A ROLE ROUND-TRIPS AS ITS REFERENCE. Halpin ch. 10 maps a role played by an entity with a compound reference scheme to one foreign key column per component, and the inverse read each of those columns as a fact of the fact type it enters through, so on support a fact like Invoice Line Item belongs to Provider Resource would read back as two facts, one per component, and a relation over the entity as its first component alone. test:crr_files is test:cr_files`s Crate beside Item, identified by its Code, where each Item is packed in at most one Crate, and Crate is inspected on Date, many to many: written through the storage interface, read back as a boot reads it and the database cleared, as test:compound_roundtrip does, every fact type`s population reads back equal to what was written and the adopted store holds no alethic violation. Before the referencing columns read back as the reference, ItemIsPackedInCrate read back as i1, S1 and i1, A, CrateIsInspectedOnDate as S1, d1 twice and S1, d2, and this answered F.",
DEF("test:compound_reference",
    S4(A("COMP"), A("test:cr_verdict"), S6(A("COMP"), A("test:cr_s5"), A("test:cr_s4"), A("test:cr_s3"), A("test:cr_s2"), A("test:cr_s1")), A("test:crr_store"))),
"THE BARE FIXTURE: Crate identified by its Shelf and Slot and nothing else, no fact of its own beyond its components and no role in any other fact type, with three Crates, and beside it Item identified by its Code with at most one Color, unrelated to Crate, so that the database has a table to make. test:crn_store is the store compile:check makes of it.",
DEF("test:crn_files",
    K(S1(S3(A("crates.md"), A("Shelf is a value type.\nSlot is a value type.\nCode is a value type.\nColor is a value type.\nCrate(.Shelf, .Slot) is an entity type.\nItem(.Code) is an entity type.\nCrate belongs to Shelf.\nCrate has Slot.\nItem has Color.\n  Each Item has at most one Color.\nItem 'i1' has Color 'red'.\nCrate 'S1/A' belongs to Shelf 'S1'.\nCrate 'S1/A' has Slot 'A'.\nCrate 'S1/B' belongs to Shelf 'S1'.\nCrate 'S1/B' has Slot 'B'.\nCrate 'S2/A' belongs to Shelf 'S2'.\nCrate 'S2/A' has Slot 'A'.\n"), A("cr/crates.md"))))),
DEF("test:crn_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:crn_files"))),
"A COMPOUND-IDENTIFIED ENTITY WITH NO FACT BEYOND ITS COMPONENTS IS STORED. The map gave an entity a table only when it had a fact to hold beyond its identification, so Crate identified by its Shelf and Slot and nothing else had no table, and its component facts, Crate belongs to Shelf and Crate has Slot, were written nowhere: a store read back from its tables lost every Crate. test:crn_files written through the storage interface, read back as a boot reads it and the database cleared, as test:compound_roundtrip does: every fact type`s population reads back equal to what was written, and the adopted store holds no alethic violation. Before such an entity had a table, CrateBelongsToShelf and CrateHasSlot read back nothing, and this answered F.",
DEF("test:compound_tableless",
    S4(A("COMP"), A("test:cr_verdict"), S6(A("COMP"), A("test:cr_s5"), A("test:cr_s4"), A("test:cr_s3"), A("test:cr_s2"), A("test:cr_s1")), A("test:crn_store"))),
"THE MIGRATION FIXTURE: Cost Tier identified by its Cost Source and Tier Name, two words each, with at most one Rate, and Line Item identified by its Code, billing at most one Cost Tier; the readings state three Cost Tiers, A/x, A/y and B/x, with their components, A/x a Rate, and Line Item l1 billing A/x. test:cm_new is the store compile:check makes of it, laid out by the map as it is now; test:cm_old is a store laid out by the map as it was before a compound-keyed table kept its reference, its stored rmap:ctab cell rmap:ctab:base.",
DEF("test:cm_files",
    K(S1(S3(A("tiers.md"), A("Cost Source is a value type.\nTier Name is a value type.\nRate is a value type.\nCode is a value type.\nCost Tier(.Cost Source, .Tier Name) is an entity type.\nLine Item(.Code) is an entity type.\nCost Tier draws on Cost Source.\nCost Tier has Tier Name.\nCost Tier has Rate.\n  Each Cost Tier has at most one Rate.\nLine Item bills Cost Tier.\n  Each Line Item bills at most one Cost Tier.\nCost Tier 'A/x' draws on Cost Source 'A'.\nCost Tier 'A/x' has Tier Name 'x'.\nCost Tier 'A/x' has Rate 'r1'.\nCost Tier 'A/y' draws on Cost Source 'A'.\nCost Tier 'A/y' has Tier Name 'y'.\nCost Tier 'B/x' draws on Cost Source 'B'.\nCost Tier 'B/x' has Tier Name 'x'.\nLine Item 'l1' bills Cost Tier 'A/x'.\n"), A("cm/tiers.md"))))),
DEF("test:cm_new",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:cm_files"))),
DEF("test:cm_old",
    S3(A("COMP"), A("apndl"), S3(A("CONS"), S4(A("CONS"), K(A("CELL")), K(A("stored:rmap:ctab")), A("rmap:ctab:base")), A("id")))),
"What the runtime wrote beside the readings, as <fact type, row>: test:cm_ok gives B/x a Rate and has Line Item l2 bill A/y, both of Cost Tiers the readings identify; test:cm_bad adds a Cost Tier C/z the runtime made, its components and Rate, which no reading names.",
DEF("test:cm_ok",
    K(S2(S2(A("CostTierHasRate"), S2(A("B/x"), A("r9"))), S2(A("LineItemBillsCostTier"), S2(A("l2"), A("A/y")))))),
DEF("test:cm_bad",
    S3(A("COMP"), A("cat"), S3(A("CONS"), A("test:cm_ok"), K(S3(S2(A("CostTierDrawsOnCostSource"), S2(A("C/z"), A("C"))), S2(A("CostTierHasTierName"), S2(A("C/z"), A("z"))), S2(A("CostTierHasRate"), S2(A("C/z"), A("r5")))))))),
"<store, facts> to the store with each fact added to its fact type`s population.",
DEF("test:cm_with",
    S3(A("COMP"), A("store:src_all"), S3(A("CONS"), S4(A("COMP"), S2(A("ALPHA"), A("test:cm_with1")), A("distl"), S3(A("CONS"), A("id"), S4(A("COMP"), A("theta:dedup"), S2(A("ALPHA"), N(1)), N(2)))), N(1)))),
DEF("test:cm_with1",
    S3(A("CONS"), N(2), S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), A("rmap:proj_pop"), S3(A("CONS"), N(2), S3(A("COMP"), N(1), N(1)))), S3(A("COMP"), A("test:cr_rows"), S3(A("CONS"), N(2), S3(A("COMP"), N(2), N(1)))))))),
DEF("test:cm_db",
    K(A("law-compound-migrate.db"))),
"<store, runtime facts> to <store, the runtime`s store laid out the old way, the readings` store laid out the old way, database>, the database made fresh; then the old map laid out in it, its ledgers opened, every table filled with the runtime`s store`s rows, and _readings filled with the facts the readings` store holds, as the last compile wrote them.",
DEF("test:cm_o1",
    S5(A("CONS"), N(1), S3(A("COMP"), A("test:cm_old"), A("test:cm_with")), S3(A("COMP"), A("test:cm_old"), N(1)), S3(A("COMP"), A("storage:fresh"), A("test:cm_db")))),
DEF("test:cm_o2",
    S6(A("CONS"), N(1), N(2), N(3), N(4), S3(A("COMP"), A("storage:schema"), S3(A("CONS"), N(4), N(2))))),
DEF("test:cm_o3",
    S6(A("CONS"), N(1), N(2), N(3), N(4), S3(A("COMP"), A("storage:meta"), N(4)))),
DEF("test:cm_o4",
    S6(A("CONS"), N(1), N(2), N(3), N(4), S3(A("COMP"), S2(A("ALPHA"), A("compile:sb_put_one")), S3(A("COMP"), A("distr"), S3(A("CONS"), S3(A("COMP"), A("compile:tables"), N(2)), N(4)))))),
DEF("test:cm_o5",
    S6(A("CONS"), N(1), N(2), N(3), N(4), S3(A("COMP"), A("storage:put"), S5(A("CONS"), N(4), K(A("_readings")), K(S2(A("ft"), A("row"))), S3(A("COMP"), A("compile:facts_of"), S3(A("CONS"), S3(A("COMP"), A("compile:tables"), N(3)), N(3))))))),
DEF("test:cm_run",
    S6(A("COMP"), A("test:cm_o5"), A("test:cm_o4"), A("test:cm_o3"), A("test:cm_o2"), A("test:cm_o1"))),
"<store, old store, ...> to what the in-place compile reads the old store through: <database, the old map`s store, the new store, no table left unread>.",
DEF("test:cm_x",
    S5(A("CONS"), N(4), N(3), N(1), K(PHI()))),
"<staged tuple> to the facts the in-place compile reads out of every table of the old map, one table at a time by compile:ip_old_table, and then the database cleared.",
DEF("test:cm_read",
    S3(A("COMP"), N(1), S3(A("CONS"), S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), A("compile:ip_old_table")), S3(A("COMP"), A("distr"), S3(A("CONS"), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("rmap:coltabs"), N(3)), A("test:cm_x")))), S3(A("COMP"), A("storage:fresh"), N(4))))),
"<staged tuple> to the rows of the old store compile:ip_unref names as having no reference to be read by, and then the database cleared.",
DEF("test:cm_unref",
    S3(A("COMP"), N(1), S3(A("CONS"), S3(A("COMP"), A("compile:ip_unref"), A("test:cm_x")), S3(A("COMP"), A("storage:fresh"), N(4))))),
"<new store> to T when the old store with test:cm_ok reads back as the new store with those facts, every population equal.",
DEF("test:cm_a",
    S3(A("COMP"), A("test:cr_same"), S3(A("CONS"), S3(A("COMP"), A("test:cm_with"), S3(A("CONS"), A("id"), A("test:cm_ok"))), S4(A("COMP"), A("test:cm_read"), A("test:cm_run"), S3(A("CONS"), A("id"), A("test:cm_ok")))))),
"<new store> to T when the new store with test:cm_ok, written through the storage interface in the new layout and read back as a boot reads it, holds every population and no alethic violation.",
DEF("test:cm_w",
    S4(A("COMP"), A("test:cr_verdict"), S6(A("COMP"), A("test:cr_s5"), A("test:cr_s4"), A("test:cr_s3"), A("test:cr_s2"), A("test:cr_s1")), S3(A("COMP"), A("test:cm_with"), S3(A("CONS"), A("id"), A("test:cm_ok"))))),
"<new store> to T when the old store with test:cm_bad names exactly one row with no reference to be read by, the row of C/z.",
DEF("test:cm_b",
    S4(A("COMP"), S3(A("COMP"), A("and"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), K(N(1)))), S3(A("COMP"), A("cn:contains"), S3(A("CONS"), N(1), K(A("C, z")))))), A("test:cm_unref"), S3(A("COMP"), A("test:cm_run"), S3(A("CONS"), A("id"), A("test:cm_bad"))))),
"A STORE THE OLD LAYOUT WROTE MIGRATES UNDER THE NEW ONE. Measured on a copy of an app`s store: its check failed in the in-place compile with SQLite query expected 5 values, received 6, row 1 of 7 beginning BrightData, us_datacenters_static_ip. The store`s Cost Tier table was written by the map before a compound-keyed table kept its reference, so it has no reference column, and the compile reads such a table through the old map, where the key is the components. test:cm_files is written to test:cm_db by the old map, the runtime`s facts beside the readings` and _readings holding the readings`, as the last compile wrote it. Read back by compile:ip_old_table, the in-place compile`s read of an old table, every population must equal the new store`s with the runtime`s facts, the reference of each Cost Tier the readings identify taken from the readings; written by the new map and read back, the same store must hold every population and no alethic violation; and where the runtime made a Cost Tier no reading names, compile:ip_unref must name that row, as the check reports it, rather than invent a reference or drop it. Before the old table was read into the new layout, the first answered F, and this answered F.",
DEF("test:compound_migrate",
    S3(A("COMP"), S4(A("COND"), A("test:cm_a"), S4(A("COND"), A("test:cm_w"), A("test:cm_b"), K(A("F"))), K(A("F"))), A("test:cm_new"))),
"THE NESTED FIXTURE, as an app may declare Provider Resource: Provider Resource identified by its Cost Center and its Resource Name, Cost Center an entity identified by its Center Name, so one component reaches its value through two steps; Service identified by its Service Name; Provider Resource supports Service, many to many; and Provider Resource is unmapped. test:cn_store is the store compile:check makes of it.",
DEF("test:cn_files",
    K(S1(S3(A("res.md"), A("Center Name is a value type.\nResource Name is a value type.\nService Name is a value type.\nCost Center(.Center Name) is an entity type.\nService(.Service Name) is an entity type.\nProvider Resource(.Cost Center, .Resource Name) is an entity type.\nProvider Resource has Cost Center.\nProvider Resource has Resource Name.\nProvider Resource supports Service.\n  Each Provider Resource, Service combination occurs at most once in the population of Provider Resource supports Service.\nProvider Resource is unmapped.\nProvider Resource 'F/a' has Cost Center 'F'.\nProvider Resource 'F/a' has Resource Name 'a'.\nProvider Resource 'F/b' has Cost Center 'F'.\nProvider Resource 'F/b' has Resource Name 'b'.\nProvider Resource 'C/a' has Cost Center 'C'.\nProvider Resource 'C/a' has Resource Name 'a'.\nProvider Resource 'F/a' supports Service 's1'.\nProvider Resource 'F/b' supports Service 's1'.\nProvider Resource 'C/a' is unmapped.\n"), A("cn/res.md"))))),
DEF("test:cn_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:cn_files"))),
"A ROLE OF AN ENTITY WHOSE COMPONENT IS ITSELF AN ENTITY ROUND-TRIPS AS ITS REFERENCE. Measured on a copy of a served app`s store after the in-place compile: ProviderResourceSupportsService read back as the first component of each Provider Resource, one of them twice, because Cost Center reaches its value through has Cost Center and then has Center Name, the role`s two component columns did not share the path less its last step, and no reference column stood beside them. test:cn_files written through the storage interface and read back as a boot reads it, as test:compound_roundtrip does: every population reads back equal to what was written and the adopted store holds no alethic violation. With the role`s columns grouped by the path less its last step, ProviderResourceSupportsService read back as F, s1 twice and this answered F, measured with rmap:compound_fts answering nothing.",
DEF("test:compound_nested",
    S4(A("COMP"), A("test:cr_verdict"), S6(A("COMP"), A("test:cr_s5"), A("test:cr_s4"), A("test:cr_s3"), A("test:cr_s2"), A("test:cr_s1")), A("test:cn_store"))),
"A FUNCTION A STORE HOLDS IS IN THAT STORE`S DOMAIN, AND THE OBLIGATION THAT IT BELONG TO SOME DOMAIN IS DECIDED BY THE STORE (a function`s domain is the database in which it is contained; core.md:788-806; Constraint 'function-in-some-domain', decided by decide:in_domain). test:decided_in_domain holds the decider`s rule, decide:id_rows, to literal rows <instance, type> of Object Type Instance is instance of Object Type: f1, f2 and f3 Functions, f2 an Object Type Instance as well, d1 a Domain; and f3 belonging to alpha by a row. Where the store declares no Domain it answers f1 alone: f2 is an Object Type Instance and f3 has its row. Where it declares alpha it answers nothing. The rule is asked only once decide:in_domain is in decide:deciders. Run first, before the decider existed, it answered F.",
DEF("test:decided_in_domain",
    S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("decide:in_domain")), A("decide:deciders"))),
       S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("apply"), S3(A("CONS"), K(A("decide:id_rows")), K(S3(PHI(), S5(S2(A("f1"), A("Function")), S2(A("f2"), A("Function")), S2(A("f2"), A("Object Type Instance")), S2(A("f3"), A("Function")), S2(A("d1"), A("Domain"))), S1(S2(A("f3"), A("alpha"))))))), K(S1(A("f1"))))),
          S3(A("COMP"), A("null"), S3(A("COMP"), A("apply"), S3(A("CONS"), K(A("decide:id_rows")), K(S3(S1(A("alpha")), S5(S2(A("f1"), A("Function")), S2(A("f2"), A("Function")), S2(A("f2"), A("Object Type Instance")), S2(A("f3"), A("Function")), S2(A("d1"), A("Domain"))), S1(S2(A("f3"), A("alpha")))))))))),
       K(A("F")))),
"A FUNCTION IS DECLARED IN ONE DOMAIN, AND A SECOND IS A DEONTIC VIOLATION THAT WARNS. Function belongs to Domain holds at most one Domain, so a second declaration had no row to be; Function is declared in Domain holds one row per Domain that declares the Function, and the obligation that each Function is declared in at most one Domain is decided by decide:declared_once, so a collision warns and commits and is never refused. test:decided_declared_once holds the decider`s rule, decide:dio_rows, to literal rows <Function, Domain>: f1 in alpha and beta, f2 in alpha twice, f3 in gamma, and it answers f1 alone. test:declared_in reads gx/c.md and then the two fx files of test:local_names, so fx is the level read last: with the path ids (compile:path_dups) the reflection of FunctionIsDeclaredInDomain holds alpha:Gizmo in alpha and beta:Gizmo in beta, two Functions each declared once, no row for the bare Gizmo and none in gamma, which the cascade overrode, and the decider`s rule answers nothing; before them it held Gizmo in alpha and in beta and the rule answered Gizmo. test:declared_once reads two files at one level that both declare Gizmo in alpha: the population holds Gizmo in alpha, and the rule answers nothing. The rule is asked only once decide:declared_once is in decide:deciders. Before the population and the decider exist, the three laws answer F.",
DEF("test:decided_declared_once",
    S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("decide:declared_once")), A("decide:deciders"))),
       S3(A("COMP"), A("eq"), S3(A("CONS"),
          S3(A("COMP"), A("apply"), S3(A("CONS"), K(A("decide:dio_rows")), K(S5(S2(A("f1"), A("alpha")), S2(A("f1"), A("beta")), S2(A("f2"), A("alpha")), S2(A("f2"), A("alpha")), S2(A("f3"), A("gamma")))))),
          K(S1(A("f1"))))),
       K(A("F")))),
DEF("test:di_two_files",
    K(S3(S3(A("c.md"), A("Gizmo(.id) is an entity type.\nDomain 'gamma' has Access 'public'.\n"), A("gx/c.md")),
         S3(A("a.md"), A("Gizmo(.id) is an entity type.\nWidget(.id) is an entity type.\nWidget is labeled.\nWidget 'w1' is labeled.\nDomain 'alpha' has Access 'public'.\n"), A("fx/a.md")),
         S3(A("b.md"), A("Gizmo(.id) is an entity type.\nWidget 'w1' is labeled.\nDomain 'beta' has Access 'public'.\n"), A("fx/b.md"))))),
DEF("test:di_one_files",
    K(S2(S3(A("a.md"), A("Gizmo(.id) is an entity type.\nDomain 'alpha' has Access 'public'.\n"), A("fx/a.md")),
         S3(A("b.md"), A("Gizmo(.id) is an entity type.\nWidget(.id) is an entity type.\nDomain 'alpha' has Description 'one domain'.\n"), A("fx/b.md"))))),
"<files>: the reflection of FunctionIsDeclaredInDomain over the cells compile:of_x answers for them, none while reflect:arms has no arm for it.",
DEF("test:di_arm",
    S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("FunctionIsDeclaredInDomain")), A("reflect:arms")))),
DEF("test:di_rows",
    S3(A("COMP"),
       S4(A("COND"), S3(A("COMP"), A("null"), A("test:di_arm")), K(PHI()),
          S3(A("COMP"), A("apply"), S3(A("CONS"), A("test:di_arm"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2)))))),
       S4(A("COMP"), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair"))))),
DEF("test:di_listed",
    S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("decide:declared_once")), A("decide:deciders")))),
"<rows>: what decide:dio_rows answers for them once the decider is listed, # before.",
DEF("test:di_decide",
    S4(A("COND"), A("test:di_listed"), S3(A("COMP"), A("apply"), S3(A("CONS"), K(A("decide:dio_rows")), A("id"))), K(A("#")))),
DEF("test:declared_in",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S6(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:Gizmo"), A("alpha"))), A("id"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("beta:Gizmo"), A("beta"))), A("id"))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("csdp:matches"), S3(A("CONS"), K(A("Gizmo")), A("id")))),
       A("test:di_listed"),
       S3(A("COMP"), A("null"), A("test:di_decide"))),
       S3(A("COMP"), A("test:di_rows"), A("test:di_two_files"))))),
DEF("test:declared_once",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S4(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Gizmo"), A("alpha"))), A("id"))),
       A("test:di_listed"),
       S3(A("COMP"), A("null"), A("test:di_decide"))),
       S3(A("COMP"), A("test:di_rows"), A("test:di_one_files"))))),

"A NAME RESOLVES IN ITS OWN DOMAIN FIRST, THEN IN THE DOMAINS IT REACHES, AND TWO OF THOSE ARE AMBIGUOUS. Namespacing is done by domain, not by hacking up the name, and a name from a library outside one`s control gets namespaced to disambiguate. core.md declares Domain reaches Domain, derived from Domain is contained in Domain and closed transitively, and that relation is the reach. A reading in a Domain that names a declared name resolves it to the declaration in that Domain; failing one, to the declaration in a Domain it reaches; and when two Domains it reaches declare the name and it does not, the reference is ambiguous, a finding of the check naming both Domains, and neither is picked. test:domain_resolve reads three files at one level: rx/a.md declares Gizmo, Widget and Sprocket under alpha; rx/b.md declares Sprocket under beta; rx/c.md declares Gizmo under gamma, speaks of Gizmo g1, Widget w1 and Sprocket s1, and says that gamma uses alpha and alpha uses beta, so gamma draws on alpha and beta (names travel by use, not by containment). Over what compile:check answers for them, state:resolutions holds <Gizmo, gamma, gamma> and not <Gizmo, gamma, alpha>, since gamma declares Gizmo itself; it holds <Widget, gamma, alpha>, since only alpha declares Widget; it holds no row for Sprocket; and the findings name exactly one ambiguous reference, Sprocket, with the Domains alpha and beta. Before the check resolves a name, the law answers F.",
DEF("test:dr_files",
    K(S3(S3(A("a.md"), A("Gizmo(.id) is an entity type.\nWidget(.id) is an entity type.\nSprocket(.id) is an entity type.\nDomain 'alpha' has Access 'public'.\n"), A("rx/a.md")),
         S3(A("b.md"), A("Sprocket(.id) is an entity type.\nDomain 'beta' has Access 'public'.\n"), A("rx/b.md")),
         S3(A("c.md"), A("Gizmo(.id) is an entity type.\nGizmo is labeled.\nWidget is labeled.\nSprocket is labeled.\nGizmo 'g1' is labeled.\nWidget 'w1' is labeled.\nSprocket 's1' is labeled.\nDomain 'gamma' has Access 'public'.\nDomain 'gamma' uses Domain 'alpha'.\nDomain 'alpha' uses Domain 'beta'.\n"), A("rx/c.md"))))),
"<cells, findings> of test:dr_files, as compile:check answers them for files it reads.",
DEF("test:dr_run",
    S4(A("COMP"), S3(A("CONS"), A("compile:of_x"), A("compile:findings_of_x")), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:dr_files")))),
DEF("test:dr_res",
    S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("state:resolutions")), N(1)))),
DEF("test:dr_amb",
    S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(1), K(A("ambiguous")))), S2(A("CONS"), A("id")), K(PHI()))), N(2))),
DEF("test:domain_resolve",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S8(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Gizmo"), A("gamma"), A("gamma"))), A("test:dr_res"))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Gizmo"), A("gamma"), A("alpha"))), A("test:dr_res")))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Widget"), A("gamma"), A("alpha"))), A("test:dr_res"))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("csdp:matches"), S3(A("CONS"), K(A("Sprocket")), A("test:dr_res")))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(2)), A("test:dr_amb")), K(S1(A("Sprocket"))))),
       S4(A("COND"), S3(A("COMP"), A("null"), A("test:dr_amb")), K(A("F")), S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S4(A("COMP"), N(4), N(1), A("test:dr_amb")), K(S2(A("alpha"), A("beta")))))),
       S4(A("COND"), S3(A("COMP"), A("null"), A("test:dr_amb")), K(A("F")), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(3), N(1), A("test:dr_amb")), K(A("reported")))))),
       A("test:dr_run")))),

"TWO FUNCTIONS WITH ONE NAME IN TWO DOMAINS ARE TWO THINGS, EACH IDENTIFIED BY ITS PATH. The Domain provides the namespace; the id is the computed path from Domain and Local Name, and namespacing is done by domain, not by hacking up the name. core.md: for each Domain and Local Name at most one Function belongs to that Domain and has that Local Name, and the colon notation denotes the path, the Domain then the cell in it. test:path_ids reads three files at one level: px/a.md declares Gizmo and Widget under alpha and says Gizmo g1 is shiny and Widget w1 is labeled; px/c.md declares Gizmo under gamma and says Gizmo g2 is labeled. No file is renamed and no name is prefixed in a reading. Over what compile:check answers for them: state:otmeta names alpha:Gizmo and gamma:Gizmo and not Gizmo, and still names Widget; the reflection of Function is declared in Domain holds alpha:Gizmo in alpha and gamma:Gizmo in gamma and no row for the bare Gizmo, and Widget in alpha; the reflection of Function has Local Name holds Gizmo as the Local Name of both path ids, and Widget as its own; and the classification (Object Type Instance is instance of Object Type, which px/m.md declares under meta so the reader reflects it; state:otpops is gone) files g1 under alpha:Gizmo alone, g2 under gamma:Gizmo alone, and nothing under the bare Gizmo. A name declared once keeps its id. Before a declaration has its path id, the law answers F.",
DEF("test:pi_files",
    K(S3(S3(A("a.md"), A("Gizmo(.id) is an entity type.\nWidget(.id) is an entity type.\nGizmo is shiny.\nGizmo 'g1' is shiny.\nWidget is labeled.\nWidget 'w1' is labeled.\nDomain 'alpha' has Access 'public'.\n"), A("px/a.md")),
         S3(A("c.md"), A("Gizmo(.id) is an entity type.\nGizmo is labeled.\nGizmo 'g2' is labeled.\nDomain 'gamma' has Access 'public'.\n"), A("px/c.md")),
         S3(A("m.md"), A("Object Type Instance(.id) is an entity type.\nObject Type(.id) is an entity type.\nObject Type Instance is instance of Object Type.\nDomain 'meta' has Access 'public'.\n"), A("px/m.md"))))),
"The cells compile:of_x answers for test:pi_files.",
DEF("test:pi_run",
    S4(A("COMP"), A("compile:of_x"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:pi_files")))),
"<cells> to the names state:otmeta declares.",
DEF("test:pi_ots",
    S4(A("COMP"), S2(A("ALPHA"), N(1)), A("solve:assoc"), S3(A("CONS"), K(A("state:otmeta")), A("id")))),
"<arm name, cells> to what that arm of reflect:arms answers over the cells as a store.",
DEF("test:pi_arm",
    S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), N(1), A("reflect:arms"))), S3(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))), N(2))))),
DEF("test:pi_di",
    S3(A("COMP"), A("test:pi_arm"), S3(A("CONS"), K(A("FunctionIsDeclaredInDomain")), A("id")))),
DEF("test:pi_ln",
    S3(A("COMP"), A("test:pi_arm"), S3(A("CONS"), K(A("FunctionHasLocalName")), A("id")))),
"<type, cells> to the instances the classification files under that type (ui:ids over the cells as a store: Object Type Instance is instance of Object Type, which px/m.md declares so the reader reflects it).",
DEF("test:pi_pop",
    S3(A("COMP"), A("ui:ids"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))), N(2)), N(1)))),
DEF("test:path_ids",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:Gizmo")), A("test:pi_ots"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:Gizmo")), A("test:pi_ots"))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("Gizmo")), A("test:pi_ots")))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("Widget")), A("test:pi_ots"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:Gizmo"), A("alpha"))), A("test:pi_di"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:Gizmo"), A("gamma"))), A("test:pi_di"))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("csdp:matches"), S3(A("CONS"), K(A("Gizmo")), A("test:pi_di")))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Widget"), A("alpha"))), A("test:pi_di"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:Gizmo"), A("Gizmo"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:Gizmo"), A("Gizmo"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Widget"), A("Widget"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("test:pi_pop"), S3(A("CONS"), K(A("alpha:Gizmo")), A("id"))), K(S1(A("g1"))))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("test:pi_pop"), S3(A("CONS"), K(A("gamma:Gizmo")), A("id"))), K(S1(A("g2"))))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("test:pi_pop"), S3(A("CONS"), K(A("Gizmo")), A("id"))))),
       A("test:pi_run")))),

"A FACT TYPE OVER A NAME DECLARED IN TWO DOMAINS IS READ OVER THE DECLARATION ITS DOMAIN RESOLVES TO, AND THE MAP KEEPS THE TWO APART. A player named in a reading resolves as an instance reference does: to the declaration in the Domain of its file, else to the one declaration in a Domain it reaches (core.md, Domain reaches Domain). test:path_fts reads three files at one level: qx/b.md declares the value type Color under base; qx/a.md declares Gizmo under alpha and reads Gizmo has Color, each Gizmo with at most one Color, and says alpha uses base; qx/c.md says the same under gamma. Over what compile:check answers for them: state:fts holds a fact type whose players are alpha:Gizmo and Color and one whose players are gamma:Gizmo and Color, and none over the bare Gizmo; and the map keys a table for alpha:Gizmo and one for gamma:Gizmo, and none for the bare Gizmo. The law names no fact type id, since how one is minted from a player that is a path is not yet the metamodel`s to say. Before a reading resolves its players, the law answers F.",
DEF("test:pf_files",
    K(S3(S3(A("b.md"), A("Color is a value type.\nDomain 'base' has Access 'public'.\n"), A("qx/b.md")),
         S3(A("a.md"), A("Gizmo(.id) is an entity type.\nGizmo has Color.\n  Each Gizmo has at most one Color.\nDomain 'alpha' has Access 'public'.\nDomain 'alpha' uses Domain 'base'.\n"), A("qx/a.md")),
         S3(A("c.md"), A("Gizmo(.id) is an entity type.\nGizmo has Color.\n  Each Gizmo has at most one Color.\nDomain 'gamma' has Access 'public'.\nDomain 'gamma' uses Domain 'base'.\n"), A("qx/c.md"))))),
"The cells compile:of_x answers for test:pf_files.",
DEF("test:pf_run",
    S4(A("COMP"), A("compile:of_x"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:pf_files")))),
"<cells> to the player lists of state:fts.",
DEF("test:pf_players",
    S4(A("COMP"), S2(A("ALPHA"), N(2)), A("solve:assoc"), S3(A("CONS"), K(A("state:fts")), A("id")))),
"<cells> to the tables the map keys over the cells as a store.",
DEF("test:pf_tables",
    S4(A("COMP"), S2(A("ALPHA"), N(2)), A("rmap:pkrows"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))))),
DEF("test:path_fts",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S7(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:Gizmo"), A("Color"))), A("test:pf_players"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:Gizmo"), A("Color"))), A("test:pf_players"))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Gizmo"), A("Color"))), A("test:pf_players")))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:Gizmo")), A("test:pf_tables"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:Gizmo")), A("test:pf_tables"))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("Gizmo")), A("test:pf_tables"))))),
       A("test:pf_run")))),

"A FACT TYPE HAS THE DOMAIN WHOSE FILE READS IT, AND ITS ID IS THE PATH WHEN ITS LOCAL NAME IS READ IN TWO DOMAINS. Fact types have domains: they map to tables and columns. A fact type is a Function: it belongs to the Domain whose file reads it, its Local Name is the cell name minted from its reading, and by core.md:781 its id is d:L exactly when L is read in more than one Domain at one level; a fact type read once keeps its bare id, and roles, reference modes and constraints follow from that id by the conventions they already have. test:path_ft_ids reads three files at one level: qy/b.md declares Color and Widget under base; qy/a.md declares Gizmo under alpha, reads Gizmo has Color, each Gizmo with at most one Color, and Widget is popular, and says alpha uses base; qy/c.md the same under gamma. Over what compile:check answers: state:fts names alpha:GizmoHasColor and gamma:GizmoHasColor and not GizmoHasColor; it names alpha:WidgetIsPopular and gamma:WidgetIsPopular and not WidgetIsPopular, a reading restated in a second Domain being a second fact type; state:schemereadings names the reference fact types alpha:GizmoHasGizmoId and gamma:GizmoHasGizmoId; and the map walks alpha:GizmoHasColor from the alpha:Gizmo table and gamma:GizmoHasColor from the gamma:Gizmo table. Before a fact type is minted by its Domain, the law answers F.",
DEF("test:pt_files",
    K(S3(S3(A("b.md"), A("Color is a value type.\nWidget(.id) is an entity type.\nDomain 'base' has Access 'public'.\n"), A("qy/b.md")),
         S3(A("a.md"), A("Gizmo(.id) is an entity type.\nGizmo has Color.\n  Each Gizmo has at most one Color.\nWidget is popular.\nDomain 'alpha' has Access 'public'.\nDomain 'alpha' uses Domain 'base'.\n"), A("qy/a.md")),
         S3(A("c.md"), A("Gizmo(.id) is an entity type.\nGizmo has Color.\n  Each Gizmo has at most one Color.\nWidget is popular.\nDomain 'gamma' has Access 'public'.\nDomain 'gamma' uses Domain 'base'.\n"), A("qy/c.md"))))),
"The cells compile:of_x answers for test:pt_files.",
DEF("test:pt_run",
    S4(A("COMP"), A("compile:of_x"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:pt_files")))),
"<cell name, cells> to the first element of each row of that cell.",
DEF("test:pt_ids",
    S3(A("COMP"), S2(A("ALPHA"), N(1)), A("solve:assoc"))),
"<table, cells> to the fact types the map walks from that table, over the cells as a store.",
DEF("test:pt_walk",
    S3(A("COMP"), A("test:tab_facts"), S3(A("CONS"), N(1), S4(A("COMP"), A("rmap:ctab"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))), N(2))))),
DEF("test:path_ft_ids",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:GizmoHasColor")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:GizmoHasColor")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id"))))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("GizmoHasColor")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id")))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:WidgetIsPopular")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:WidgetIsPopular")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id"))))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("WidgetIsPopular")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:fts")), A("id")))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:GizmoHasGizmoId")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:schemereadings")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:GizmoHasGizmoId")), S3(A("COMP"), A("test:pt_ids"), S3(A("CONS"), K(A("state:schemereadings")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("alpha:GizmoHasColor")), S3(A("COMP"), A("test:pt_walk"), S3(A("CONS"), K(A("alpha:Gizmo")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("gamma:GizmoHasColor")), S3(A("COMP"), A("test:pt_walk"), S3(A("CONS"), K(A("gamma:Gizmo")), A("id")))))),
       A("test:pt_run")))),

"A RING CONSTRAINT IS VERBALIZED AS HALPIN WRITES IT. A ring constraint must be verbalized properly. verbalization.md reads a ring in the fact type`s own words, `Domain uses Domain is acyclic.`, and FORML 2 says what it means: Halpin, Information Modeling and Relational Databases, and NORMA`s ring verbalizations, with subscripts telling the players apart. Over Domain uses Domain: irreflexive, No Domain uses itself; asymmetric, If Domain1 uses Domain2 then it is impossible that Domain2 uses Domain1; antisymmetric, If Domain1 uses Domain2 and Domain1 is not Domain2 then it is impossible that Domain2 uses Domain1; symmetric, If Domain1 uses Domain2 then Domain2 uses Domain1; intransitive, If Domain1 uses Domain2 and Domain2 uses Domain3 then it is impossible that Domain1 uses Domain3; transitive, If Domain1 uses Domain2 and Domain2 uses Domain3 then Domain1 uses Domain3; acyclic, No Domain may cycle back to itself via one or more traversals through Domain uses Domain. Each is the Text of the ring Constraint, written as every Text of the store is, with no final period. The seven kinds are the Constraint Types core.md names; Reflexive (RF) has no Name there, so no ring is read as it. test:ring_verbal reads rv/r.md, which declares Domain uses Domain with a ring of each kind and names the seven Constraint Types: over its cells as a store, the reflection of Constraint has Text answers exactly those seven sentences, each the Text of a Constraint the reflection of Constraint is of Constraint Type answers. Before the reflection gives a ring its Text, the law answers F.",
DEF("test:rv_files",
    K(S1(S3(A("r.md"), A("Function(.id) is an entity type.\nConstraint Type is a subtype of Function.\nName is a value type.\nFunction has Name.\n  Each Function has at most one Name.\nConstraint Type 'IR' has Name 'Irreflexive'.\nConstraint Type 'AS' has Name 'Asymmetric'.\nConstraint Type 'AT' has Name 'Antisymmetric'.\nConstraint Type 'SY' has Name 'Symmetric'.\nConstraint Type 'IT' has Name 'Intransitive'.\nConstraint Type 'TR' has Name 'Transitive'.\nConstraint Type 'AC' has Name 'Acyclic'.\nDomain(.Name) is an entity type.\nDomain uses Domain.\nDomain uses Domain is irreflexive.\nDomain uses Domain is asymmetric.\nDomain uses Domain is antisymmetric.\nDomain uses Domain is symmetric.\nDomain uses Domain is intransitive.\nDomain uses Domain is transitive.\nDomain uses Domain is acyclic.\nDomain 'rv' has Access 'public'.\n"), A("rv/r.md"))))),
DEF("test:rv_run",
    S4(A("COMP"), A("compile:of_x"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:rv_files")))),
"<arm name, cells> to what that arm of reflect:arms answers over the cells as a store with its FILE built (main:refile), as a store a start makes has one, none when there is no such arm.",
DEF("test:rv_arm",
    S4(A("COND"), S3(A("COMP"), A("null"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), N(1), A("reflect:arms")))), K(PHI()),
       S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), N(1), A("reflect:arms"))), S4(A("COMP"), A("main:refile"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))), N(2)))))),
DEF("test:ring_verbal",
    S5(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S4(A("COMP"), A("theta:seteq"), S3(A("CONS"), S2(A("ALPHA"), N(2)), K(S7(
          A("No Domain uses itself"),
          A("If Domain1 uses Domain2 then it is impossible that Domain2 uses Domain1"),
          A("If Domain1 uses Domain2 and Domain1 is not Domain2 then it is impossible that Domain2 uses Domain1"),
          A("If Domain1 uses Domain2 then Domain2 uses Domain1"),
          A("If Domain1 uses Domain2 and Domain2 uses Domain3 then it is impossible that Domain1 uses Domain3"),
          A("If Domain1 uses Domain2 and Domain2 uses Domain3 then Domain1 uses Domain3"),
          A("No Domain may cycle back to itself via one or more traversals through Domain uses Domain")))), N(1)),
       S4(A("COMP"), A("theta:subset"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(1)), N(1)), S3(A("COMP"), S2(A("ALPHA"), N(1)), N(2))), A("id"))),
       S3(A("CONS"), S3(A("COMP"), A("test:rv_arm"), S3(A("CONS"), K(A("ConstraintHasText")), A("id"))), S3(A("COMP"), A("test:rv_arm"), S3(A("CONS"), K(A("ConstraintIsOfConstraintType")), A("id")))),
       A("test:rv_run"))),

"A FACT STATED TWICE IS ONE FACT. Under ORM`s set semantics a population is a set: a sentence restated, in its own file or in a file of another Domain, adds no row, and identical rows can never violate a uniqueness constraint. test:dup_facts reads two files at two levels: dx/core/c.md declares under core the fact types Object Type has Conceptual Data Type, Object Type is of Object Kind and Object Type has Enum Values, each Object Type with at most one of each, the value type Title, whose data type is text, and the value type Coverage Region, whose possible values are 'US' and 'EU'; dx/app/s.md, under sherlock, declares Explanation(.Title) and restates that the data type of Title is text, restates Coverage Region and its possible values, and declares Authority(.citation) and Law(.citation), saying twice that the data type of citation is text. A served app`s store held each shape: one file restates core`s data types of Title and Description, another says six times that the data type of citation is text and restates a third file`s values of Coverage Region. Over the cells compile:check answers for them, as a store: the population of Object Type has Conceptual Data Type holds <Title, text> and <citation, text>, that of Object Type has Enum Values holds <Coverage Region, 'US', 'EU'>, and none of the three populations holds a row twice; and the check of the store (ui:violations) answers no uniqueness violation. Before a restated declaration is read as one fact, the law answers F.",
DEF("test:df_files",
    K(S2(S3(A("c.md"), A("Object Type(.id) is an entity type.\nConceptual Data Type(.id) is an entity type.\nObject Kind is a value type.\nObject Type has Conceptual Data Type.\n  Each Object Type has at most one Conceptual Data Type.\nObject Type is of Object Kind.\n  Each Object Type is of at most one Object Kind.\nEnum Values is a value type.\nObject Type has Enum Values.\n  Each Object Type has at most one Enum Values.\nTitle is a value type.\n  The data type of Title is text.\nCoverage Region is a value type.\n  The possible values of Coverage Region are 'US', 'EU'.\nDomain 'core' has Access 'public'.\n"), A("dx/core/c.md")),
         S3(A("s.md"), A("Explanation(.Title) is an entity type.\n  The data type of Title is text.\nCoverage Region is a value type.\n  The possible values of Coverage Region are 'US', 'EU'.\nAuthority(.citation) is an entity type.\n  The data type of citation is text.\nLaw(.citation) is an entity type.\n  The data type of citation is text.\nDomain 'sherlock' has Access 'public'.\n"), A("dx/app/s.md"))))),
"The cells compile:of_x answers for test:df_files, as a store with its FILE built (main:refile).",
DEF("test:df_run",
    S6(A("COMP"), A("main:refile"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(2))), A("compile:of_x"), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:df_files")))),
"<fact type, store> to its population.",
DEF("test:df_rows",
    A("system:pop_rows")),
"<rows> to whether no row is in them twice.",
DEF("test:df_set",
    S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), S3(A("COMP"), A("length"), A("theta:dedup"))))),
DEF("test:dup_facts",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S8(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Title"), A("text"))), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeHasConceptualDataType")), A("id"))))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("Coverage Region"), A("'US', 'EU'"))), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeHasEnumValues")), A("id"))))),
       S3(A("COMP"), A("test:df_set"), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeHasEnumValues")), A("id")))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("citation"), A("text"))), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeHasConceptualDataType")), A("id"))))),
       S3(A("COMP"), A("test:df_set"), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeHasConceptualDataType")), A("id")))),
       S3(A("COMP"), A("test:df_set"), S3(A("COMP"), A("test:df_rows"), S3(A("CONS"), K(A("ObjectTypeIsOfObjectKind")), A("id")))),
       S3(A("COMP"), A("null"), S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(2), K(A("uniqueness")))), S2(A("CONS"), A("id")), K(PHI()))), A("ui:violations")))),
       A("test:df_run")))),

"A NAME RESOLVES THROUGH THE DOMAINS ITS DOMAIN DRAWS ON, AND NEVER THROUGH CONTAINMENT. core.md: Domain uses Domain is a library import, for names only; Domain draws on Domain is its transitive closure; and Domain reaches Domain is data addressing, parent into child, which names do not travel by. A name resolves in its own Domain, then in the Domains it draws on, and two of those are ambiguous. test:domain_uses reads four files at one level: ux/a.md declares Gizmo, Widget and Sprocket under alpha, which uses beta; ux/b.md declares Sprocket under beta; ux/c.md declares Gizmo under gamma, which uses alpha, and speaks of Gizmo g1, Widget w1 and Sprocket s1; ux/d.md is delta, contained in alpha, and speaks of Widget w2. Over what compile:check answers: state:resolutions holds <Gizmo, gamma, gamma>, its own Domain first, and <Widget, gamma, alpha>, which gamma uses; it holds no row for Sprocket in gamma, which draws on alpha and, through it, beta, and the findings name that reference ambiguous with the Domains alpha and beta; and it holds no row <Widget, delta, alpha>, since delta is contained in alpha and uses nothing. Before the check reads uses, the law answers F.",
DEF("test:du_files",
    K(S4(S3(A("a.md"), A("Gizmo(.id) is an entity type.\nWidget(.id) is an entity type.\nSprocket(.id) is an entity type.\nDomain 'alpha' has Access 'public'.\nDomain 'alpha' uses Domain 'beta'.\n"), A("ux/a.md")),
         S3(A("b.md"), A("Sprocket(.id) is an entity type.\nDomain 'beta' has Access 'public'.\n"), A("ux/b.md")),
         S3(A("c.md"), A("Gizmo(.id) is an entity type.\nGizmo is labeled.\nWidget is labeled.\nSprocket is labeled.\nGizmo 'g1' is labeled.\nWidget 'w1' is labeled.\nSprocket 's1' is labeled.\nDomain 'gamma' has Access 'public'.\nDomain 'gamma' uses Domain 'alpha'.\n"), A("ux/c.md")),
         S3(A("d.md"), A("Widget 'w2' is labeled.\nDomain 'delta' has Access 'public'.\nDomain 'delta' is contained in Domain 'alpha'.\n"), A("ux/d.md"))))),
"<cells, findings> of test:du_files, as compile:check answers them for files it reads.",
DEF("test:du_run",
    S4(A("COMP"), S3(A("CONS"), A("compile:of_x"), A("compile:findings_of_x")), A("compile:x"), S3(A("COMP"), S2(A("ALPHA"), A("test:ln_pair")), A("test:du_files")))),
DEF("test:domain_uses",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S7(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Gizmo"), A("gamma"), A("gamma"))), A("test:dr_res"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Widget"), A("gamma"), A("alpha"))), A("test:dr_res"))),
       S3(A("COMP"), A("not"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S3(A("Widget"), A("delta"), A("alpha"))), A("test:dr_res")))),
       S3(A("COMP"), A("null"), S3(A("COMP"), A("csdp:matches"), S3(A("CONS"), K(A("Sprocket")), A("test:dr_res")))),
       S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(2)), A("test:dr_amb")), K(S1(A("Sprocket"))))),
       S4(A("COND"), S3(A("COMP"), A("null"), A("test:dr_amb")), K(A("F")), S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S4(A("COMP"), N(4), N(1), A("test:dr_amb")), K(S2(A("alpha"), A("beta"))))))),
       A("test:du_run")))),

"A FACT TYPE WHOSE ID IS A PATH HAS ITS LOCAL NAME AND ITS DOMAIN OF DECLARATION, AS AN OBJECT TYPE DOES. core.md: each Function has at most one Local Name, and Function is declared in Domain holds one row per Domain that declares it. A fact type read in two Domains is two Functions, d:L in each (test:path_ft_ids), and the reflection gave neither a Local Name nor a Domain of declaration, since state:localnames records object types and instances. test:ft_reflected reads test:pt_files: over the cells as a store, the reflection of Function has Local Name holds <alpha:GizmoHasColor, GizmoHasColor>, <gamma:GizmoHasColor, GizmoHasColor>, <alpha:WidgetIsPopular, WidgetIsPopular> and <gamma:WidgetIsPopular, WidgetIsPopular>, and the reflection of Function is declared in Domain holds each of the four in its own Domain. Before the reflection reads a fact type`s Domain, the law answers F.",
DEF("test:ft_reflected",
    S3(A("COMP"), A("fp:and_all"), S3(A("COMP"), S9(A("CONS"),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:GizmoHasColor"), A("GizmoHasColor"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:GizmoHasColor"), A("GizmoHasColor"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:WidgetIsPopular"), A("WidgetIsPopular"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:WidgetIsPopular"), A("WidgetIsPopular"))), A("test:pi_ln"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:GizmoHasColor"), A("alpha"))), A("test:pi_di"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:GizmoHasColor"), A("gamma"))), A("test:pi_di"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("alpha:WidgetIsPopular"), A("alpha"))), A("test:pi_di"))),
       S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(S2(A("gamma:WidgetIsPopular"), A("gamma"))), A("test:pi_di")))),
       A("test:pt_run")))),

"test:typed_cols holds sqlite:typed_cols to the base store`s own tables: Function`s key functionId and belongsToDomainId (Function belongs to Domain, an entity type) are columns an entity can stand in, its description and localName (value types) are not, and DomainReachesDomain, a relation over two Domains, keeps both its columns.",
DEF("test:typed_cols",
    S3(A("COMP"),
       S3(A("COMP"), A("fp:and_all"), S6(A("CONS"),
          S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("functionId")), N(1))),
          S3(A("COMP"), A("theta:member"), S3(A("CONS"), K(A("belongsToDomainId")), N(1))),
          S4(A("COMP"), A("not"), A("theta:member"), S3(A("CONS"), K(A("description")), N(1))),
          S4(A("COMP"), A("not"), A("theta:member"), S3(A("CONS"), K(A("localName")), N(1))),
          S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("length"), N(2)), K(N(2)))))),
       S3(A("CONS"),
          S3(A("COMP"), A("sqlite:typed_cols"), S3(A("CONS"), K(A("Function")), A("id"))),
          S3(A("COMP"), A("sqlite:typed_cols"), S3(A("CONS"), K(A("DomainReachesDomain")), A("id")))))),
"test:nest_place holds the in-place compile`s read of an attribute of an objectified fact type whose table is keyed by the objectification`s roles and holds no reference column: Plan Product, which objectifies `Plan includes Platform API`, keyed by plan and platformAPI, with its per-call Amount beside them (on a copy of a served app`s store, once the columns carried their own fact types, the in-place check still refused PlanProductHasPerCallAmount as reading back none of the facts the last readings asserted). schema:place gives such a fact type no place, as its key is two columns; the place compile:ip_place reads it by is the table, the key columns in the objectification`s role order as the one value the instance is named by -- rmap:proj_objkey`s, the components joined by a period -- and the column, and its SELECT (sqlite:pr_src) names the instance as SQLite joins the columns, every one of them filled. Run first with compile:ip_place as schema:place, it answered no place and this answered F.",
DEF("test:np_files",
    K(S1(S3(A("np.md"), A("Plan Name is a value type.\nSlug is a value type.\nAmount is a value type.\nPlan(.Plan Name) is an entity type.\nPlatform API(.Slug) is an entity type.\nPlan includes Platform API.\n  Each Plan, Platform API combination occurs at most once in the population of Plan includes Platform API.\nPlan Product(.id) is an entity type.\nPlan Product objectifies \"Plan includes Platform API\".\nPlan Product has per-call- Amount.\n  Each Plan Product has at most one per-call- Amount.\n"), A("np/np.md"))))),
DEF("test:np_store",
    S6(A("COMP"), S2(A("ALPHA"), A("compile:cellify")), A("compile:of_x"), A("compile:x"), S2(A("ALPHA"), A("test:ln_pair")), A("test:np_files"))),
DEF("test:nest_place",
    S3(A("COMP"), S4(A("COND"), S3(A("COMP"), A("atom"), A("id")), K(A("F")),
          S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
             S3(A("COMP"), A("eq"), S3(A("CONS"), A("id"), K(S4(A("PlanProduct"), S2(S2(A("plan"), A("platformAPI")), A("callAmount")), A("#"), N(1))))),
             S3(A("COMP"), A("eq"), S3(A("CONS"), A("sqlite:pr_src"), K(A("SELECT \"plan\" || '.' || \"platformAPI\" AS c1, \"callAmount\" AS c2 FROM \"PlanProduct\" WHERE \"plan\" IS NOT NULL AND \"platformAPI\" IS NOT NULL AND \"callAmount\" IS NOT NULL"))))))),
       S3(A("COMP"), A("compile:ip_place"), S3(A("CONS"), K(A("PlanProductHasPerCallAmount")), S3(A("COMP"), A("schema:env"), A("test:np_store")))))),
"test:migrate_apply holds compile:ip_migrate over the composed store: a runtime fact of ReadingCarriesText, which no reading declares, beside a Migration from it to ReadingHasText whose rule text is `Reading has Text iff that Reading carries Text.`, proposed by a Domain Change one User approves, is answered as the ReadingHasText fact and the ReadingCarriesText fact is gone. With no approval it is left as it was, and the refusal it meets after stands (the second conjunct). Run first with compile:ip_mig_one answering PHI, it failed (migrate-apply -> F).",
DEF("test:mig_fx",
    K(S6(S3(A("ReadingCarriesText"), S2(A("r-law"), A("law text")), A("x")), S3(A("MigrationHasFactTypeAsSource"), S2(A("m-law"), A("ReadingCarriesText")), A("x")), S3(A("MigrationProducesFactTypeAsTarget"), S2(A("m-law"), A("ReadingHasText")), A("x")), S3(A("MigrationHasMigrationRuleText"), S2(A("m-law"), A("Reading has Text iff that Reading carries Text.")), A("x")), S3(A("SchemaDesignProposesFunction"), S2(A("dc-law"), A("m-law")), A("x")), S3(A("UserApprovesSchemaDesign"), S2(A("u-law"), A("dc-law")), A("x"))))),
"<store>: a store whose schema declares ReadingHasText alone, its state:fts cell as a compiled store carries it, so compile:ip_fits finds ReadingHasText and not ReadingCarriesText.",
DEF("test:mig_store",
    K(S1(S3(A("CELL"), A("state:fts"), S1(S1(S5(A("ReadingHasText"), S2(A("Reading"), A("Text")), S1(S1(N(1))), PHI(), PHI()))))))),
"test:migrate_rename holds migrate:recipe to a player rename, word for word (External System is renamed Federation). Each rule text names the role under its new name in the derived fact type and its old one in the condition, and reads as the projection of the source`s roles in their order: a binary with the renamed player first, a ternary, a binary with it second, and an attribute of the objectification whose name carries the old name. Two renamed players are not read (the last conjunct). Run first with migrate:arm2 calling migrate:arm_lit, the first four answered PHI and this answered F. The strings keep the old name on purpose: they are what a Migration from the old fact types says.",
DEF("test:migrate_rename",
    S3(A("COMP"), A("fp:and_all"), S6(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("migrate:recipe"), K(S4(A("Federation has URL iff that External System has URL."), A("ExternalSystemHasURL"), A("FederationHasURL"), S2(A("Federation"), A("URL"))))), K(S3(A("proj"), A("ExternalSystemHasURL"), S2(N(1), N(2)))))),
