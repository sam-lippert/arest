       S3(A("COMP"), A("fed:sync_write"), S3(A("CONS"), A("test:ry_fx"), K(S2(S3(A("LawRyFed"), A("law-ry-k1"), A("law-ry-v1")), S3(A("LawRyOwn"), A("law-ry-k1"), A("law-ry-v1")))))))),
