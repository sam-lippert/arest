    S6(A("COMP"), A("theta:dedup"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), N(2), K(S3(A("SS"), A("XC"), A("EQ"))))), S2(A("CONS"), N(1)), K(PHI()))), A("system:pop_rows"), S3(A("CONS"), K(A("ConstraintIsOfConstraintType")), A("id")))),
DEF("test:dr_roles_free",
    S3(A("COMP"), A("test:no_mand"), S3(A("CONS"), K(A("DerivationRuleHasAntecedentClause")), A("id")))),
DEF("test:om_text",
    K(A("Customer(.Name) is an entity type.\nOAuth Account(.Name) is an entity type.\nObject Type(.Name) is an entity type.\nEmail is a value type.\nWorld Assumption is a value type.\nCustomer has Email.\n  Each Customer has at most one Email.\nCustomer authenticates via OAuth Account.\n  Each Customer, OAuth Account combination occurs at most once in the population of Customer authenticates via OAuth Account.\n  Each Customer authenticates via some OAuth Account.\nObject Type has World Assumption.\n  Each Object Type has at most one World Assumption.\nObject Type Instance(.Name) is an entity type.\nObject Type Instance is instance of Object Type.\n  Each Object Type Instance, Object Type combination occurs at most once in the population of Object Type Instance is instance of Object Type.\nCustomer 'c1' has Email 'c1@example.com'.\nObject Type Instance 'c1' is instance of Object Type 'Customer'.\nObject Type 'Customer' has World Assumption 'closed'.\n"))),
"<World Assumption of OAuth Account> to the readings files of the fixture.",
DEF("test:om_files",
    S2(A("CONS"), S4(A("CONS"), K(A("om.md")), S3(A("COMP"), A("implode"), S3(A("CONS"), K(A("")), S5(A("CONS"), A("test:om_text"), K(A("Object Type 'OAuth Account' has World Assumption '")), A("id"), K(A("'.\n"))))), K(A("fx/om.md"))))),
