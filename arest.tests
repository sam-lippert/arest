       S4(A("COMP"), A("not"), A("theta:member"), S3(A("CONS"), K(A("law-fbd-val")), S4(A("COMP"), S2(A("ALPHA"), N(1)), A("ast:fetch"), S3(A("CONS"), K(A("FunctionBelongsToDomain")), S3(A("COMP"), A("main:refresh_domain_of"), S4(A("CONS"), N(1), K(S2(A("Abstract SQL Type"), A("law-fbd-val"))), N(2)))))))),
