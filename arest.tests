       S3(A("COMP"), S2(A("CONS"), S3(A("CONS"), K(A("detail")), A("id"))),
          S3(A("COMP"), A("ui:arrange"), S3(A("CONS"), S3(A("COMP"), A("ui:entity_at"), S5(A("CONS"), A("test:artifact_status_store"), K(S2(A("Support Response"), A("r1"))), K(PHI()), K(A("Support Response")))), K(S2(N(300), PHI()))))),
       K(PHI()), K(PHI())))),
DEF("test:artifact_status",
    S4(A("COMP"), S3(A("COMP"), A("and"), S3(A("CONS"), S3(A("COMP"), A("read:memberw"), S3(A("CONS"), K(A("ObjectTypeInstanceIsCurrentlyInStatus")), A("id"))), S3(A("COMP"), A("read:memberw"), S3(A("CONS"), K(A("Draft")), A("id"))))),
       A("fed:split"), S3(A("CONS"), K(A("'")), A("test:artifact_status_page")))),
"test:recipe_sql_forms holds sqlite:recipe_sql to the served query verb on the count and cmp forms (every constraint is one SQL query). Over four literal populations -- R and S of three columns, G and K of two -- each recipe below is run twice: as the SQL sqlite:recipe_sql makes of it, in a database with no file (sqlite:scratch) holding those rows, and by query, which is derive:eval over the same rows; the two answers must be the same set of rows, each value as its text, since sqlite:scratch answers text. The recipes are count and cmp alone, nested under proj, minus and sel, over a join, and a count of a count. R holds integers, so cmp orders its columns as numbers, where 2 is less than 10 and 10 is not less than 9, as value:ge orders two integers; S holds text, ordered by its characters, where Zed is less than abc. A count is a number: sel on a count`s second column with the number 3 finds its row only if the count is one, and the column`s SQL type is integer. Run first with sqlite:recipe_sql having no arm for count or cmp, it answered F.",
"Four populations, as query reads them.",
DEF("test:rsf_pairs",
    K(S4(S2(A("R"), S5(S3(A("a"), N(1), N(5)), S3(A("b"), N(7), N(2)), S3(A("c"), N(3), N(3)), S3(A("d"), N(10), N(9)), S3(A("e"), N(2), N(10)))),
         S2(A("S"), S4(S3(A("x"), A("apple"), A("banana")), S3(A("y"), A("pear"), A("fig")), S3(A("z"), A("Zed"), A("abc")), S3(A("w"), A("fig"), A("fig")))),
         S2(A("G"), S5(S2(A("a"), A("red")), S2(A("b"), A("red")), S2(A("c"), A("blue")), S2(A("d"), A("red")), S2(A("e"), A("blue")))),
         S2(A("K"), S4(S2(A("k1"), A("a")), S2(A("k2"), A("b")), S2(A("k3"), A("c")), S2(A("k4"), A("a"))))))),
"The same populations as the script that stores them, integers as integers and text as text.",
DEF("test:rsf_script",
    K(A("create table R (c1, c2, c3); insert into R values ('a', 1, 5), ('b', 7, 2), ('c', 3, 3), ('d', 10, 9), ('e', 2, 10); create table S (c1, c2, c3); insert into S values ('x', 'apple', 'banana'), ('y', 'pear', 'fig'), ('z', 'Zed', 'abc'), ('w', 'fig', 'fig'); create table G (c1, c2); insert into G values ('a', 'red'), ('b', 'red'), ('c', 'blue'), ('d', 'red'), ('e', 'blue'); create table K (c1, c2); insert into K values ('k1', 'a'), ('k2', 'b'), ('k3', 'c'), ('k4', 'a');"))),
"Where each population is stored: its table, its columns in role order, and no flag column.",
DEF("test:rsf_places",
    K(S4(S2(A("R"), S3(A("R"), S3(A("c1"), A("c2"), A("c3")), A("#"))), S2(A("S"), S3(A("S"), S3(A("c1"), A("c2"), A("c3")), A("#"))), S2(A("G"), S3(A("G"), S2(A("c1"), A("c2")), A("#"))), S2(A("K"), S3(A("K"), S2(A("c1"), A("c2")), A("#")))))),
DEF("test:rsf_recipes",
    K(S(S3(A("count"), A("G"), N(2)),
        S4(A("cmp"), A("R"), N(2), N(3)),
        S4(A("cmp"), A("S"), N(2), N(3)),
        S3(A("proj"), S4(A("cmp"), A("R"), N(2), N(3)), S1(N(1))),
        S3(A("minus"), S3(A("proj"), A("R"), S1(N(1))), S3(A("proj"), S4(A("cmp"), A("R"), N(2), N(3)), S1(N(1)))),
        S4(A("sel"), S3(A("count"), A("G"), N(2)), N(2), N(3)),
        S3(A("count"), S4(A("join"), A("K"), A("G"), S3(N(1), N(2), N(3))), N(3)),
        S4(A("cmp"), S4(A("join"), A("K"), A("R"), S3(N(1), N(3), N(4))), N(2), N(3)),
        S3(A("count"), S3(A("count"), A("G"), N(2)), N(2)),
        S4(A("sel"), S4(A("cmp"), A("R"), N(2), N(3)), N(1), A("e"))))),
