          S3(A("COMP"), A("cat"),
             S3(A("CONS"),
                S4(A("COMP"), A("nav:peers"), A("main:nav_at"), A("test:thm2_addr")),
                S3(A("COMP"), A("cat"), S3(A("CONS"),
                   S3(A("COMP"), A("main:or_peers"), S3(A("CONS"), N(1), S3(A("COMP"), N(2), N(2)))),
                   S3(A("COMP"), A("main:trs_at"), A("test:thm2_addr"))))))))),
