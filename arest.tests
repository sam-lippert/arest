    S3(A("COMP"), A("fp:and_all"), S9(A("CONS"), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("constraints:scoped_exclusion_projected_many"), K(S1(S3(A("px"), S1(N(1)), S1(N(1)))))), K(S2(S2(S2(A("a"), A("1")), S2(A("b"), A("2"))), S1(S3(A("CELL"), A("px"), S1(S2(A("a"), A("9"))))))))), K(S1(S1(A("a")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("constraints:scoped_exclusion_projected_many"), K(S1(S3(A("px"), S1(N(1)), S1(N(1)))))), K(S2(S2(S2(A("a"), A("1")), S2(A("b"), A("2"))), S1(S3(A("CELL"), A("px"), S1(S2(A("z"), A("9"))))))))), K(PHI()))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("constraints:scoped_exclusion_projected_many"), K(S2(S3(A("p1"), S1(N(1)), S1(N(1))), S3(A("p2"), S1(N(1)), S1(N(2)))))), K(S2(S1(S1(A("b"))), S2(S3(A("CELL"), A("p1"), S1(S1(A("z")))), S3(A("CELL"), A("p2"), S1(S2(A("x"), A("b"))))))))), K(S1(S1(A("b")))))), S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"), S3(A("COMP"), A("cmd:excl_viols"), S3(A("CONS"), S3(A("COMP"), A("theta:flatten"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), K(A("state:exclusions")), A("id")))), S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), N(5))), A("store:fts")), S3(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), K(A("CELL")), N(1), S3(A("COMP"), S2(A("ALPHA"), S2(A("CONS"), A("id"))), N(2)))), A("ui:otpops")))))), K(PHI()))), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), A("cmd:create"), K(S2(S1(S2(A("F2"), S1(S2(A("a"), A("y"))))), S3(S2(S5(A("F2"), S2(A("Thing"), A("Widget")), S1(S1(N(1))), PHI(), S1(S2(A("b"), A("x")))), S5(A("G2"), S2(A("Thing"), A("Widget")), S1(S1(N(1))), PHI(), S1(S2(A("a"), A("z"))))), PHI(), S1(S2(S2(A("F2"), S1(N(1))), S2(A("G2"), S1(N(1))))))))), K(A("refused")))), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), A("cmd:create"), K(S2(S1(S2(A("F2"), S1(S2(A("c"), A("y"))))), S3(S2(S5(A("F2"), S2(A("Thing"), A("Widget")), S1(S1(N(1))), PHI(), S1(S2(A("b"), A("x")))), S5(A("G2"), S2(A("Thing"), A("Widget")), S1(S1(N(1))), PHI(), S1(S2(A("a"), A("z"))))), PHI(), S1(S2(S2(A("F2"), S1(N(1))), S2(A("G2"), S1(N(1))))))))), K(A("committed")))), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), A("cmd:create"), K(S2(S1(S2(A("OTKindOf"), S1(S2(A("o1"), A("value"))))), S3(S1(S5(A("OTKindOf"), S2(A("OT"), A("Kind")), S1(S2(N(1), N(2))), PHI(), S1(S2(A("o1"), A("entity"))))), S2(S2(A("EntityKind"), S3(A("proj"), S4(A("sel"), A("OTKindOf"), N(2), A("entity")), S1(N(1)))), S2(A("ValueKind"), S3(A("proj"), S4(A("sel"), A("OTKindOf"), N(2), A("value")), S1(N(1))))), S1(S2(S2(A("EntityKind"), S1(N(1))), S2(A("ValueKind"), S1(N(1))))))))), K(A("refused")))), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), N(1), A("cmd:create"), K(S2(S1(S2(A("OTKindOf"), S1(S2(A("o2"), A("value"))))), S3(S1(S5(A("OTKindOf"), S2(A("OT"), A("Kind")), S1(S2(N(1), N(2))), PHI(), S1(S2(A("o1"), A("entity"))))), S2(S2(A("EntityKind"), S3(A("proj"), S4(A("sel"), A("OTKindOf"), N(2), A("entity")), S1(N(1)))), S2(A("ValueKind"), S3(A("proj"), S4(A("sel"), A("OTKindOf"), N(2), A("value")), S1(N(1))))), S1(S2(S2(A("EntityKind"), S1(N(1))), S2(A("ValueKind"), S1(N(1))))))))), K(A("committed"))))))),

"EVERY MARKER IS A CLAIM THAT A RULE EXISTS, so this spans all four modes and not only the two that are obviously derived. Halpin: 'Derivation rules should normally be biconditionals (i.e., their main operator is iff). If their main operator is if, the fact type is only partly derived.' So `semi` (+) does not mean fewer rules, it means the rule's main operator is `if` -- and a semi head with no deliverer is a marking about an operator that is not there. It fails softly where `full` fails loudly: the asserted half populates, so the head looks alive while its derived half silently never arrives. `subtype` is the same claim in subtype form, since the marked reading IS the defining rule (* Each X is a Y that ...), so a derived subtype with no deliverer says a membership is computed and then computes nothing. Written as the first half of test:marker_known, which already counted every mode as a KNOWN name while only two were required to be a DELIVERED one.",
DEF("test:marker_marked",
    S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("theta:unfold_pairs"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), K(A("state:derived")), A("id")))))),
DEF("test:marker_heads",
    S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("theta:unfold_pairs"), A("rules:metamodel"))), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("theta:flatten"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), K(A("state:rules")), A("id")))))))),
DEF("test:marker_known",
    S3(A("COMP"), A("cat"), S3(A("CONS"), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("theta:unfold_pairs"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), K(A("state:derived")), A("id"))))), S3(A("COMP"), S2(A("ALPHA"), N(1)), S3(A("COMP"), A("theta:unfold_pairs"), S3(A("COMP"), A("ast:fetch"), S3(A("CONS"), K(A("state:declared")), A("id")))))))),
"AND A FUNCTION DELIVERS WHAT IT YIELDS (an externally federated fact is a derivation of some kind). A fact type a Source`s Function yields is derived by that Function, so a head marked for it is delivered though no rule sentence names it: test:marker_undelivered is the marked heads less those a rule delivers and those a Function yields (fed:yielded_fts). Operand: the store.",
DEF("test:marker_undelivered",
    S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), A("test:marker_marked"), S3(A("COMP"), A("cat"), S3(A("CONS"), A("test:marker_heads"), A("fed:yielded_fts")))))),
DEF("test:markers_witness",
    S3(A("CONS"), A("test:marker_undelivered"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), A("test:marker_heads"), A("test:marker_known"))))),
DEF("test:markers",
    S4(A("COMP"), A("fp:and_all"), S2(A("ALPHA"), A("null")), A("test:markers_witness"))),

DEF("test:rewrite_soundness",
    S4(A("COMP"), A("fp:and_all"), A("cat"), S3(A("CONS"), S3(A("COMP"), A("cat"), S3(A("CONS"), S4(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("rewrite:normalize"), N(1)), N(2)))), A("rewrite:witness_pins"), K(PHI())), S4(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("apply"), S3(A("COMP"), A("apply"), S3(A("CONS"), S3(A("COMP"), A("rewrite:normalize"), N(1)), N(2)))))), A("rewrite:witness_apply"), K(PHI())))), S4(A("COMP"), S2(A("ALPHA"), S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), A("rewrite:normalize"), A("rewrite:normalize"), N(1)), S3(A("COMP"), A("rewrite:normalize"), N(1))))), A("cat"), S3(A("CONS"), S3(A("COMP"), A("rewrite:witness_pins"), K(PHI())), S3(A("COMP"), A("rewrite:witness_apply"), K(PHI()))))))),

"test:reading_predicate holds the reader to literal state:readings rows <name, players, words>: CaseIsForSubscription with words is filed as Reading rCaseIsForSubscription used by Predicate pCaseIsForSubscription, a row with no words is filed with neither, and the readings filed a Predicate are exactly the readings filed a Text. Run first with read:refl_rd_pred_keep answering nothing, it failed (reading-predicate -> F).",
DEF("test:rp_rows",
    K(S2(S3(A("CaseIsForSubscription"), S2(A("Case"), A("Subscription")), S1(S1(A("{0} is for {1}")))), S3(A("NoWords"), S1(A("Thing")), PHI())))),
DEF("test:reading_predicate",
    S3(A("COMP"), A("fp:and_all"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), A("read:refl_rd_pred_keep")), A("test:rp_rows")), K(S1(S2(A("rCaseIsForSubscription"), A("pCaseIsForSubscription")))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"), S5(A("COMP"), S2(A("ALPHA"), N(1)), A("theta:flatten"), S2(A("ALPHA"), A("read:refl_rd_pred_keep")), A("test:rp_rows")), S5(A("COMP"), S2(A("ALPHA"), N(1)), A("theta:flatten"), S2(A("ALPHA"), A("read:refl_rd_keep")), A("test:rp_rows"))))))),
"test:text_rows holds the reflection to the sentences the schema is read from. Over a literal readings file with one derivation rule, one uniqueness sentence and one mandatory sentence, read:reflect answers ConstraintHasText for the uniqueness UC:in:WidgetHasOwner#1 and for the mandatory MC:e:WidgetHasOwner#1, each with its sentence as written, and DerivationRuleHasText and DerivationRuleProducesFactType for the rule DR:WidgetIsOwned:1, the first rule written for the head WidgetIsOwned. Before read:reflect answered these three populations the law answers F (text-rows -> F).",
DEF("test:tx_text",
    K(S2(A("tx.md"), A("Widget(.Widget Id) is an entity type.\nOwner(.Owner Id) is an entity type.\nWidget Id is a value type.\nOwner Id is a value type.\n\nWidget has Owner.\nEach Widget has at most one Owner.\nEach Widget has some Owner.\n\nWidget is owned. *\n\n* Widget is owned iff that Widget has some Owner.\n")))),
DEF("test:tx_reflected",
    S6(A("COMP"), A("read:reflect"), A("read:x_full"), A("read:x_of"), A("compile:text_rows"), A("test:tx_text"))),
DEF("test:text_rows",
    S4(A("COMP"), A("fp:and_all"),
       S4(A("CONS"),
          S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("ConstraintHasText")), A("id"))), K(S2(S2(A("UC:in:WidgetHasOwner#1"), A("Each Widget has at most one Owner")), S2(A("MC:e:WidgetHasOwner#1"), A("Each Widget has some Owner")))))),
          S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("DerivationRuleHasText")), A("id"))), K(S1(S2(A("DR:WidgetIsOwned:1"), A("Widget is owned iff that Widget has some Owner")))))),
          S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), K(A("DerivationRuleProducesFactType")), A("id"))), K(S1(S2(A("DR:WidgetIsOwned:1"), A("WidgetIsOwned"))))))),
       A("test:tx_reflected"))),
"test:mc_reflected holds the constraint reflection to a literal map input: WidgetHasOwner flags its first role explicit and its second none, WidgetIsOwned its one role implied, and reflect:con_raw answers one constraint, the alethic MC MC:e:WidgetHasOwner#1 spanning WidgetHasOwner position 1, and none for a role flagged otherwise. A simple mandatory had no Constraint, so before the reflection gave it one the law answers F (mc-reflected -> F).",
DEF("test:mc_store",
    K(S1(S3(A("CELL"), A("state:mapinputs"), S1(S2(
       S4(A("WidgetHasOwner"), S5(A("Widget"), A("entity"), A("T"), A("F"), A("explicit")), S5(A("Owner"), A("entity"), A("F"), A("F"), A("none")), S1(A("F"))),
       S4(A("WidgetIsOwned"), S5(A("Widget"), A("entity"), A("F"), A("F"), A("implied")), PHI(), S1(A("F"))))))))),
DEF("test:mc_reflected",
    S3(A("COMP"), A("theta:seteq"), S3(A("CONS"), S3(A("COMP"), A("reflect:con_raw"), A("test:mc_store")), K(S1(S5(A("MC:e:WidgetHasOwner#1"), A("MC"), A("Alethic"), S1(S2(A("WidgetHasOwner"), N(1))), PHI())))))),
"test:split_role_lead holds the cut to literal words: `L has v - C and v - C makes K` is two clauses, the second opening with the role name, and `X has t - and - f - A` is one, its `and` inside the hyphen run.",
DEF("test:split_role_lead",
    S3(A("COMP"), A("and"), S3(A("CONS"),
       S3(A("COMP"), A("eq"), S3(A("CONS"),
          S3(A("COMP"), A("read:rule_split_body"), S3(A("COMP"), A("cat"), K(S2(S6(A("L"), A("has"), A("v"), A("-"), A("C"), A("and")), S5(A("v"), A("-"), A("C"), A("makes"), A("K")))))),
          K(S2(S5(A("L"), A("has"), A("v"), A("-"), A("C")), S5(A("v"), A("-"), A("C"), A("makes"), A("K")))))),
       S3(A("COMP"), A("eq"), S3(A("CONS"),
          S3(A("COMP"), A("read:rule_split_body"), K(S9(A("X"), A("has"), A("t"), A("-"), A("and"), A("-"), A("f"), A("-"), A("A")))),
          K(S1(S9(A("X"), A("has"), A("t"), A("-"), A("and"), A("-"), A("f"), A("-"), A("A"))))))))),
"test:anti_linear holds the negated legs to the positive side: a positive side P less two legs A and B on the one shared column is minus(minus(P, joinon(P, A)), joinon(P, B)), each join over P, where the old fold put the first subtraction inside the second join.",
DEF("test:anti_linear",
    S3(A("COMP"), A("eq"), S3(A("CONS"),
       S3(A("COMP"), A("read:rule_gchain_antis"), K(S3(A("P"), S2(S2(A("A"), S1(A("x"))), S2(A("B"), S1(A("x")))), S1(A("x"))))),
       K(S3(A("minus"), S3(A("minus"), A("P"), S5(A("joinon"), A("P"), A("A"), S1(S2(N(1), N(1))), S1(N(1)))), S5(A("joinon"), A("P"), A("B"), S1(S2(N(1), N(1))), S1(N(1)))))))),
"test:count_chain holds read:rule_count_recipe to literal rows: over L = <c1,o1,x1>, <c1,o1,x2> twice, <c1,o2,x3> and <c2,o1,x4>, counting column 3 grouped by columns 1 and 2 answers <c1,o1,2>, <c1,o2,1> and <c2,o1,1> once flattened -- the repeated <c1,o1,x2> counted once, because the count is of distinct X. Run first with the source summed unprojected (pairwith over L itself), it failed: <c1,o1,3>.",
DEF("test:count_chain",
    S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"),
       S3(A("COMP"), A("derive:eval"), S3(A("CONS"), S3(A("COMP"), S3(A("CONS"), K(A("flat")), A("id")), S3(A("COMP"), A("read:rule_count_recipe"), K(S(PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), PHI(), A("L"), N(3), S2(N(1), N(2)))))), K(S1(S2(A("L"), S5(S3(A("c1"), A("o1"), A("x1")), S3(A("c1"), A("o1"), A("x2")), S3(A("c1"), A("o1"), A("x2")), S3(A("c1"), A("o2"), A("x3")), S3(A("c2"), A("o1"), A("x4")))))))),
       K(S3(S3(A("c1"), A("o1"), N(2)), S3(A("c1"), A("o2"), N(1)), S3(A("c2"), A("o1"), N(1))))))),
"test:oti_narrow holds read:rule_oti_pairs to literal rows. The readings declare `State Machine is for Object Type Instance` and an entity type Subscription that is no declared subtype of it, and the rule `Customer is currently subscribed if that Customer has some Subscription and some State Machine is for that Subscription and that State Machine is currently in Status `Active``. The rule row the reader builds is evaluated over literal populations: c1 has s1, whose machine is Active; c2 has s2, Trialing; c3 has s3, Active; and m4 is for u1, a User in Active, which no Customer has. The rule answers c1 and c3. Run first without the pairs, it failed: the reader built no row for the head, so the law answered F.",
DEF("test:oti_narrow",
    S3(A("COMP"),
       S4(A("COND"), A("null"), K(A("F")),
          S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"),
             S3(A("COMP"), A("derive:eval"), S3(A("CONS"), N(3), K(S4(
                S2(A("CustomerHasSubscription"), S3(S2(A("c1"), A("s1")), S2(A("c2"), A("s2")), S2(A("c3"), A("s3")))),
                S2(A("StateMachineIsForObjectTypeInstance"), S4(S2(A("m1"), A("s1")), S2(A("m2"), A("s2")), S2(A("m3"), A("s3")), S2(A("m4"), A("u1")))),
                S2(A("StateMachineIsCurrentlyInStatus"), S4(S2(A("m1"), A("Active")), S2(A("m2"), A("Trialing")), S2(A("m3"), A("Active")), S2(A("m4"), A("Active")))),
                S2(A("ObjectTypeInstanceIsInstanceOfObjectType"), S4(S2(A("s1"), A("Subscription")), S2(A("s2"), A("Subscription")), S2(A("s3"), A("Subscription")), S2(A("u1"), A("User")))))))),
             K(S2(S1(A("c1")), S1(A("c3"))))))),
       S3(A("COMP"), A("theta:find_desc"), S3(A("CONS"), K(A("CustomerIsCurrentlySubscribed")),
          S6(A("COMP"), A("read:state_rules"), A("read:x_full"), A("read:x_of"), A("compile:text_rows"), A("test:oti_text")))))),
DEF("test:oti_text",
    K(S2(A("subs.md"), A("Customer(.Customer Id) is an entity type.\nSubscription(.Subscription Id) is an entity type.\nObject Type(.Name) is an entity type.\nObject Type Instance(.Instance Id) is an entity type.\nState Machine is an entity type.\nState Machine is a subtype of Object Type Instance.\nStatus(.Name) is an entity type.\nCustomer Id is a value type.\nSubscription Id is a value type.\nName is a value type.\nInstance Id is a value type.\n\nCustomer has Subscription.\nState Machine is for Object Type Instance.\nState Machine is currently in Status.\nObject Type Instance is instance of Object Type.\nSubscription trial starts.\n\nCustomer is currently subscribed. +\n\n+ Customer is currently subscribed if that Customer has some Subscription and some State Machine is for that Subscription and that State Machine is currently in Status 'Active'.\n\nIt is obligatory that if some State Machine is for some Subscription and that State Machine is currently in Status 'Trialing' then that Subscription trial starts.\n")))),
"test:oti_setcmp holds the set comparison read:setcmp_res narrows to literal rows. test:oti_text`s obligation, `It is obligatory that if some State Machine is for some Subscription and that State Machine is currently in Status `Trialing` then that Subscription trial starts`, builds one subset row, and its antecedent is evaluated over literal populations: m1 is for s1 and Trialing, m2 is for s2 and Active, and m4 is for u1, a User, and Trialing. The antecedent answers s1 alone: s2 is not Trialing, and u1 is no Subscription, which the extent join excludes. Run first without the narrowing, it failed: the sentence built no row, so the law answered F.",
DEF("test:oti_setcmp",
    S3(A("COMP"),
       S4(A("COND"), A("null"), K(A("F")),
          S3(A("COMP"), A("test:rows_eq"), S3(A("CONS"),
             S3(A("COMP"), A("derive:eval"), S3(A("CONS"), S4(A("COMP"), N(1), N(5), N(1)), K(S3(
                S2(A("StateMachineIsForObjectTypeInstance"), S3(S2(A("m1"), A("s1")), S2(A("m2"), A("s2")), S2(A("m4"), A("u1")))),
                S2(A("StateMachineIsCurrentlyInStatus"), S3(S2(A("m1"), A("Trialing")), S2(A("m2"), A("Active")), S2(A("m4"), A("Trialing")))),
                S2(A("ObjectTypeInstanceIsInstanceOfObjectType"), S3(S2(A("s1"), A("Subscription")), S2(A("s2"), A("Subscription")), S2(A("u1"), A("User")))))))),
             K(S1(S1(A("s1"))))))),
       S6(A("COMP"), A("read:setcmp_state"), A("read:x_full"), A("read:x_of"), A("compile:text_rows"), A("test:oti_text")))),
"test:ring_kinds_read parses read:witness_ring, the reader's own ring corpus, which states its rings in the fact type's own words (`Port links to Port is irreflexive.`, `... is symmetric.`, `Domain reaches Domain is acyclic.`), and holds state:rings to exactly those three rows in any order. Nothing parsed that corpus before, which is how its three rings reached no schema unnoticed.",
DEF("test:ring_kinds_read",
    S3(A("COMP"),
       S3(A("COMP"), A("and"), S3(A("CONS"),
          S3(A("COMP"), A("eq"), S3(A("CONS"), A("length"), K(N(3)))),
          S5(A("COMP"), A("fp:and_all"), S2(A("ALPHA"), A("theta:member")), A("distr"),
             S3(A("CONS"), K(S3(S2(A("PortLinksToPort"), A("Irreflexive")), S2(A("PortLinksToPort"), A("Symmetric")), S2(A("DomainReachesDomain"), A("Acyclic")))), A("id"))))),
       S4(A("COMP"), A("read:ring_state"), A("read:x_of"),
          S3(A("COMP"), S2(A("ALPHA"), S3(A("CONS"), N(1), S3(A("COMP"), A("theta:flatten"), N(2)))), A("read:witness_ring"))))),
DEF("test:reader_match",
    S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), S4(A("CONS"), N(1), N(2), N(3)), S4(A("COMP"), A("read:parse"), S2(A("ALPHA"), S3(A("CONS"), N(1), S3(A("COMP"), A("theta:flatten"), N(2)))), A("read:witness_rows"))), A("read:witness_expected")))),

DEF("test:csdp_known",
    S3(A("COMP"), A("fp:and_all"), S4(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), S6(A("COMP"), A("csdp:s7"), A("csdp:s5"), A("csdp:s4"), A("csdp:s2"), K(S2(S4(S5(A("AcademicHasEmpName"), S2(A("Academic"), A("EmpName")), PHI(), PHI(), S4(S2(A("715"), A("Adams A")), S2(A("139"), A("Cantor G")), S2(A("651"), A("Jones E")), S2(A("770"), A("Jones E")))), S5(A("AcademicWorksForDept"), S2(A("Academic"), A("Dept")), PHI(), PHI(), S4(S2(A("715"), A("Computer Science")), S2(A("139"), A("Mathematics")), S2(A("651"), A("Computer Science")), S2(A("770"), A("Law")))), S5(A("AcademicUsesExtension"), S2(A("Academic"), A("Extension")), PHI(), PHI(), S4(S2(A("715"), A("2345")), S2(A("139"), A("2437")), S2(A("651"), A("2345")), S2(A("770"), A("2437")))), S5(A("AcademicIsTenured"), S1(A("Academic")), PHI(), PHI(), S1(S1(A("715"))))), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437"))))))), K(S2(S4(S5(A("AcademicHasEmpName"), S2(A("Academic"), A("EmpName")), S1(S1(N(1))), S2(N(1), N(2)), S4(S2(A("715"), A("Adams A")), S2(A("139"), A("Cantor G")), S2(A("651"), A("Jones E")), S2(A("770"), A("Jones E")))), S5(A("AcademicWorksForDept"), S2(A("Academic"), A("Dept")), S1(S1(N(1))), S2(N(1), N(2)), S4(S2(A("715"), A("Computer Science")), S2(A("139"), A("Mathematics")), S2(A("651"), A("Computer Science")), S2(A("770"), A("Law")))), S5(A("AcademicUsesExtension"), S2(A("Academic"), A("Extension")), S1(S1(N(1))), S2(N(1), N(2)), S4(S2(A("715"), A("2345")), S2(A("139"), A("2437")), S2(A("651"), A("2345")), S2(A("770"), A("2437")))), S5(A("AcademicIsTenured"), S1(A("Academic")), S1(S1(N(1))), PHI(), S1(S1(A("715"))))), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437")))))))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("csdp:s2"), K(S2(S1(S5(A("Empty"), S1(A("A")), PHI(), PHI(), PHI())), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437"))))))), K(PHI()))), S3(A("COMP"), A("eq"), S3(A("CONS"), S3(A("COMP"), A("csdp:s7"), K(S2(S1(S5(A("W"), S3(A("A"), A("B"), A("C")), S1(S1(N(1))), PHI(), S1(S3(A("x"), A("y"), A("z"))))), S4(S2(A("Academic"), S4(A("715"), A("139"), A("651"), A("770"))), S2(A("EmpName"), S3(A("Adams A"), A("Cantor G"), A("Jones E"))), S2(A("Dept"), S3(A("Computer Science"), A("Mathematics"), A("Law"))), S2(A("Extension"), S2(A("2345"), A("2437"))))))), K(PHI())))))),

