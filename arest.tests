    S4(A("COMP"), S2(A("ALPHA"), A("test:qs_g1")), A("distr"), S3(A("CONS"), S3(A("COMP"), A("system:keep_first"), S2(A("ALPHA"), N(1))), A("id")))),
DEF("test:qs_g1",
