       S3(A("COMP"), A("main:vz_tpl"), S3(A("CONS"), N(1), S3(A("COMP"), N(1), N(2)))),
       S3(A("COMP"), A("solve:assoc"), S3(A("CONS"), S3(A("COMP"), N(2), N(2)), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("ConstraintTypeHasViolationTemplate")), N(1)))))))),
