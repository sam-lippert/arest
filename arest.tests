    S4(A("COMP"), A("theta:flatten"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("theta:member"), S3(A("CONS"), N(1), K(S6(A("SS"), A("EQ"), A("XC"), A("MC"), A("OR"), A("XO"))))), S2(A("CONS"), A("id")), K(PHI()))), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("ConstraintTypeHasConstraintTypeFamily")), A("id"))))),
