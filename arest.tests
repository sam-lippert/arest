          S3(A("COMP"), S4(A("COND"), S3(A("COMP"), A("eq"), S3(A("CONS"), A("id"), K(A("#")))), K(PHI()), A("rmap:unfold4")), S3(A("COMP"), A("solve:cell"), S3(A("CONS"), K(A("state:eldomain")), A("id")))),
          S4(A("COMP"), S2(A("ALPHA"), N(1)), A("system:cellrows"), S3(A("CONS"), K(A("state:nestings")), A("id"))))))),

"test:fetch_walk: ast:fetch answers what the filter it replaced (test:fetch_ref) answers over a literal store holding a name twice (the first cell wins), a loose atom and a two-element tuple among its cells, and a cell last: for each name in it, a name not in it, the empty store, and the word CELL; a answers 1, b 2 and an absent name #.",
