DEF("ka:rp", S3(A("COMP"), A("k:flat"), S3(A("COMP"), S2(A("ALPHA"), S4(A("COND"), S3(A("COMP"), A("k:all"), S3(A("CONS"), S3(A("COMP"), A("eq"), S3(A("CONS"), N(2), K(N(0)))), S3(A("COMP"), A("eq"), S3(A("CONS"), N(3), K(N(0)))))), K(PHI()), S2(A("CONS"), A("id")))), S3(A("COMP"), S2(A("ALPHA"), S4(A("CONS"), N(1), S3(A("COMP"), A("length"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), S3(A("COMP"), A("k:pop"), S3(A("CONS"), N(1), S3(A("COMP"), N(1), N(2)))), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), N(1), S3(A("COMP"), N(2), N(2))))))), S3(A("COMP"), A("length"), S3(A("COMP"), A("theta:setminus"), S3(A("CONS"), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), N(1), S3(A("COMP"), N(2), N(2)))), S3(A("COMP"), A("k:pop"), S3(A("CONS"), N(1), S3(A("COMP"), N(1), N(2))))))))), S3(A("COMP"), A("distr"), S3(A("CONS"), A("ka:rp_heads"), S3(A("CONS"), A("k:boot"), A("id")))))))),
"The heads allowed to differ, each named: the three that read Object Type Instance is instance of Object Type, which the kernel reads as P holds it and today by its reflection, until the kernel reads it by its rule. ka:allowed_extra allows the 20 most-specifically rows that difference gives the kernel.",
DEF("ka:rp_allowed", K(S3(A("ObjectTypeInstanceIsProperlyOfObjectType"), A("ObjectTypeInstanceIsMostSpecificallyOfObjectType"), A("ObjectTypeHasWorldAssumption")))),
