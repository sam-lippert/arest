<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Arestlam</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- the WPF show renderer is its OWN project: without this exclusion
       the kernel's default glob compiles show/obj's GENERATED
       AssemblyInfo alongside its own (duplicate-attribute CS0579 —
       found 2026-07-09 when the parity test broke after show landed) -->
  <ItemGroup>
    <Compile Remove="show/**" />
    <EmbeddedResource Remove="show/**" />
    <None Remove="show/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <!-- Same-bytes native execution (task 14): RoslynLoader.cs compiles the
       raw shared/*.canon bytes in memory via Roslyn against Vocabulary.cs;
       no MSBuild WrapCanon byte-wrap, no generated Canon.g.cs, no JSON
       store. Performance stays via registered overrides, never a JSON
       intermediate. -->

</Project>
