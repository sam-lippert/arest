DEF("case:alethic-violation-refuses-the-write", S2(S3(A("COMP"), A("length"), S3(A("COMP"), A("system:pop_rows"), S3(A("CONS"), K(A("AgentHasPhone")), A("main:create_closed")))), S3(S5(S3(A("CELL"), A("state:fts"), S1(S1(S5(A("AgentHasPhone"), S2(A("Agent"), A("Phone")), S1(S1(N(1))), S1(N(1)), S1(PHI()))))), S3(A("CELL"), A("state:declared"), S1(S1(S2(A("AgentHasPhone"), S2(A("Agent"), A("Phone")))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), S2(S2(A("ann"), A("Agent")), S2(A("bob"), A("Agent")))), S3(A("CELL"), A("state:deontics"), S1(PHI())), S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("AgentHasPhone"), S1(S2(A("ann"), A("555-0100"))))))), A("AgentHasPhone"), S2(A("cal"), A("555-9999"))))),
"A PROHIBITED POPULATION IS CHECKED, AND EVERY ROW OF IT IS THE VERDICT (2026-09-09). Three shapes the oracle emits: the fact type itself (every message that uses a dash), a literal restricting the last role (only the separate greeting), and a unary qualifying the last player (only the internal API). An empty population is quiet.",
DEF("case:prohibited-rows-are-violations", S2(A("cmd:deo_viols"), S2(S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:p:MessageUsesDash#1"), A("prohibited"), S2(A("MessageUsesDash"), A("MessageUsesDash")))))), S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("MessageUsesDash"), S2(S1(A("m1")), S1(A("m2"))))))))),
DEF("case:prohibited-empty-population-is-quiet", S2(A("cmd:deo_viols"), S2(S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:p:MessageUsesDash#1"), A("prohibited"), S2(A("MessageUsesDash"), A("MessageUsesDash")))))), S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("MessageUsesDash"), PHI())))))),
