    S3(S2(A("instanceOf"), S1(S2(A("Person"), A("ObjectType")))),
       S2(A("role"), S1(S4(A("r1"), A("F1"), N(1), A("Person")))),
       S2(A("F1"), S2(S1(A("p1")), S1(A("p2"))))))),
