       S2(A("role"), S2(S4(A("r1"), A("F1"), N(1), A("Person")),
                        S4(A("r2"), A("F1"), N(2), A("Company")))),
       S2(A("F1"), S2(S2(A("p1"), A("c1")), S2(A("p2"), A("c2"))))))),
DEF("case:instance-mirror-no-nouns", S2(A("derive:instance_mirror"),
