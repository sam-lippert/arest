DEF("fixture:cone-obligation-unlinked",
    K(S7(S3(A("CELL"), A("state:fts"), S1(S2(S5(A("WidgetHasSerial"), S2(A("Widget"), A("Serial")), S1(S1(N(1))), PHI(), S1(PHI())), S5(A("ThingBelongsToDomain"), S2(A("Thing"), A("Domain")), S1(S1(N(1))), PHI(), S1(PHI()))))), S3(A("CELL"), A("state:declared"), S1(S2(S2(A("WidgetHasSerial"), S2(A("Widget"), A("Serial"))), S2(A("ThingBelongsToDomain"), S2(A("Thing"), A("Domain")))))), S3(A("CELL"), A("ObjectTypeInstanceIsInstanceOfObjectType"), PHI()), S3(A("CELL"), A("state:deontics"), S1(S1(S3(A("DEO:m:ThingBelongsToDomain#1"), A("mandatory"), S1(S2(A("ThingBelongsToDomain"), N(1))))))), S3(A("CELL"), A("ObjectTypeIsOfObjectKind"), S4(S2(A("Widget"), A("entity")), S2(A("Thing"), A("entity")), S2(A("Domain"), A("entity")), S2(A("Serial"), A("value")))), S3(A("CELL"), A("ObjectTypeIsSubtypeOfObjectType"), PHI()), S3(A("CELL"), A("FILE"), S2(S3(A("CELL"), A("WidgetHasSerial"), PHI()), S3(A("CELL"), A("ThingBelongsToDomain"), PHI())))))),
DEF("case:a-create-of-a-subtype-warns-under-its-supertypes-obligation",
    S2(S3(A("COMP"), A("main:post_body"), S3(A("CONS"), S3(A("COMP"), A("main:create"), S4(A("CONS"), A("fixture:cone-obligation"), K(A("WidgetHasSerial")), K(S2(A("w1"), A("s1"))))), A("fixture:cone-obligation"))), PHI())),
