DEF("case:verb-declared-to-take-arguments", S2(A("main:verb_shape"), S2(S1(S3(A("CELL"), A("FILE"), S1(S3(A("CELL"), A("FunctionAcceptsTypeExpression"), S3(S2(A("schema"), A("store")), S2(A("get"), A("name-and-store")), S2(A("query"), A("recipe-and-populations"))))))), S2(A("get"), A("X"))))),
