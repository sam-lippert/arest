(
"THE FORMS THE KERNEL BRINGS: CONS and CONST as today`s lambda defines them (arest), loaded only when the kernel runs alone; beside today`s lambda, its own two serve. All seven are to be brought as DEFs over the primitives.",
DEF("CONST",
    S3(A("COMP"), N(2), N(1))),
DEF("CONS",
    S4(A("COMP"), S2(A("ALPHA"), A("apply")), A("tl"), A("distr")))
)
